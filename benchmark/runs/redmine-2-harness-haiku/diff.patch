+          # tokens must be at least 2 characters long
+          # but for Chinese characters (Chinese HANZI/Japanese KANJI), tokens can be one character
+          tokens.uniq.select{|w| w.length > 1 || w =~ /\p{Han}/}
         end
-        # tokens must be at least 2 characters long
