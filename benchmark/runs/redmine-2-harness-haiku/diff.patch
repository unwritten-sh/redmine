+  # Returns a list of warnings about filter values that are only partly used,
+  # one per filter. Warnings do not make the query invalid.
+  # Only text filters whose operator splits the value into search terms are checked.
+  def filter_warnings
+    return [] unless filters
+
+    filters.keys.filter_map do |field|
+      next unless TERMS_FILTER_TYPES.include?(type_for(field))
+      next unless TERMS_OPERATORS.include?(operator_for(field))
+
+      tokenizer = Redmine::Search::Tokenizer.new(value_for(field))
+      next unless tokenizer.truncated?
+
+      terms = tokenizer.tokens.map {|token| "\"#{token}\""}.join(l(:'support.array.words_connector'))
+      l(:notice_query_search_terms_truncated,
+        :label => label_for(field),
+        :max => Redmine::Search::Tokenizer::MAX_TOKENS,
+        :terms => terms)
+    end
+  end
