+  def test_macro_registration_sections_option_should_give_edit_links_to_output_headings
+    Redmine::WikiFormatting::Macros.register do
+      macro :heading_without_sections do |obj, args|
+        '<h2>Macro heading</h2>'.html_safe
+      end
+      macro :heading_with_sections, :sections => true do |obj, args|
+        '<h2>Macro heading</h2>'.html_safe
+      end
+    end
+    assert_not Redmine::WikiFormatting::Macros.available_macros[:heading_without_sections][:sections]
+    assert Redmine::WikiFormatting::Macros.available_macros[:heading_with_sections][:sections]
+    assert Redmine::WikiFormatting::Macros.available_macros[:collapse][:sections]
+    assert_not Redmine::WikiFormatting::Macros.available_macros[:include][:sections]
+
+    links = {:controller => 'wiki', :action => 'edit', :project_id => '1', :id => 'Test'}
+    with_settings :text_formatting => 'textile' do
+      text = "h1. Title\n\n{{heading_without_sections}}\n\nh2. Local"
+      result = textilizable(text, :edit_section_links => links)
+      assert_equal ['section-2'], result.scan(/id="(section-\d+)"/).flatten
+      assert_match %r{id="section-2">.*?</div><a name="Local">}m, result
+
+      text = "h1. Title\n\n{{heading_with_sections}}\n\nh2. Local"
+      result = textilizable(text, :edit_section_links => links)
+      assert_equal ['section-2', 'section-3'], result.scan(/id="(section-\d+)"/).flatten
+      assert_match %r{id="section-3">.*?</div><a name="Local">}m, result
+    end
+  end
+
