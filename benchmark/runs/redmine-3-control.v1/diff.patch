+  def test_show_should_not_display_section_edit_links_for_included_headings
+    with_settings :text_formatting => 'textile' do
+      page = WikiPage.find(2) # Another_page
+      page.content.update_column(
+        :text,
+        "h1. Local 1\n\n{{include(Page_with_sections)}}\n\nh2. Local 2\n\nText 2\n\nh2. Local 3\n\nText 3"
+      )
+      @request.session[:user_id] = 2
+      get :show, :params => {:project_id => 1, :id => 'Another_page'}
+      assert_response :success
+
+      # Included headings are rendered without edit links
+      assert_select 'h1', :text => /Title/
+      assert_select 'a[href^=?]', '/projects/ecookbook/wiki/Another_page/edit?section=', 2
+      assert_select 'div#section-2 + a[name=Local-2]'
+      assert_select 'div#section-3 + a[name=Local-3]'
+      assert_select 'a[href^=?]', '/projects/ecookbook/wiki/Page_with_sections/edit', 0
+
+      # The section numbers are the ones used to edit the page
+      get :edit, :params => {:project_id => 1, :id => 'Another_page', :section => 2}
+      assert_response :success
+      assert_select 'textarea[name=?]', 'content[text]', :text => /\Ah2. Local 2\s+Text 2\s*\z/
+      get :edit, :params => {:project_id => 1, :id => 'Another_page', :section => 3}
+      assert_select 'textarea[name=?]', 'content[text]', :text => /\Ah2. Local 3\s+Text 3\s*\z/
+    end
+  end
