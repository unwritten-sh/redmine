+  def test_section_edit_links_should_ignore_headings_of_included_page
+    included = WikiPage.find(4) # Page with an inline image
+    included.content.update_column(:text, "h1. Included\n\nh2. Included A\n\nh2. Included B")
+    raw = <<~RAW
+      h1. Wiki
+
+      {{include(#{included.title})}}
+
+      h2. Section A
+
+      {{collapse
+      {{include(#{included.title})}}
+      }}
+
+      h2. Section B
+    RAW
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'textile' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+             :project_id => '1', :id => 'Test'}
+        )
+
+      assert_equal %w(section-2 section-3), result.scan(/id="(section-\d+)"/).flatten
+      assert_include 'href="/projects/1/wiki/Test/edit?section=2"', result
+      assert_include 'href="/projects/1/wiki/Test/edit?section=3"', result
+      assert_not_include 'section=4', result
+      # Section A is the second section, Section B the third one
+      assert_match %r{id="section-2">.*?</div>\s*<a name="Section-A">}m, result
+      assert_match %r{id="section-3">.*?</div>\s*<a name="Section-B">}m, result
+      # Included headings are still rendered
+      assert_equal 2, result.scan('<h2 >Included A<a ').size
+      assert_not_include 'redmine-macro-output', result
+    end
+  end
+
+  def test_textilizable_with_include_macro_should_not_leave_markers
+    with_settings :text_formatting => 'textile' do
+      result = textilizable("{{include(Page_with_an_inline_image)}}", :object => WikiPage.find(2).content)
+      assert_include 'Page with an inline image', result
+      assert_not_include 'redmine-macro-output', result
+    end
+  end
+
