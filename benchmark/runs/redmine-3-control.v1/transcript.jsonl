 = textilizable(\"{{include(Page_with_an_inline_image)}}\", :object => WikiPage.find(2).content)\n      assert_include 'Page with an inline image', result\n      assert_not_include 'redmine-macro-output', result\n    end\n  end\n\n'''\nassert anchor in s\ns=s.replace(anchor,new+anchor,1)\nopen(p,'w').write(s)\n\np='test/functional/wiki_controller_test.rb'\ns=open(p).read()\nanchor=\"  def test_show_current_version_should_display_section_edit_links\\n\"\nnew='''  def test_show_should_not_display_section_edit_links_for_included_headings\n    with_settings :text_formatting => 'textile' do\n      page = WikiPage.find(2) # Another_page\n      page.content.update_column(\n        :text,\n        \"h1. Local 1\\\\n\\\\n{{include(Page_with_sections)}}\\\\n\\\\nh2. Local 2\\\\n\\\\nText 2\\\\n\\\\nh2. Local 3\\\\n\\\\nText 3\"\n      )\n      @request.session[:user_id] = 2\n      get :show, :params => {:project_id => 1, :id => 'Another_page'}\n      assert_response :success\n\n      # Included headings are rendered without edit links\n      assert_select 'h1', :text => /Title/\n      assert_select 'a[href^=?]', '/projects/ecookbook/wiki/Another_page/edit?section=', 2\n      assert_select 'div#section-2 + a[name=Local-2]'\n      assert_select 'div#section-3 + a[name=Local-3]'\n      assert_select 'a[href^=?]', '/projects/ecookbook/wiki/Page_with_sections/edit', 0\n\n      # The section numbers are the ones used to edit the page\n      get :edit, :params => {:project_id => 1, :id => 'Another_page', :section => 2}\n      assert_response :success\n      assert_select 'textarea[name=?]', 'content[text]', :text => /\\\\Ah2. Local 2\\\\s+Text 2\\\\s*\\\\z/\n      get :edit, :params => {:project_id => 1, :id => 'Another_page', :section => 3}\n      assert_select 'textarea[name=?]', 'content[text]', :text => /\\\\Ah2. Local 3\\\\s+Text 3\\\\s*\\\\z/\n    end\n  end\n\n'''\ns=s.replace(anchor,new+anchor,1)\nopen(p,'w').write(s)\nEOF\ngrep -n -A10 \"wiki_contents_011\" test/fixtures/wi