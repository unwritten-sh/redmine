+  def test_insert_highlighted_code_using_textile
+    with_settings :text_formatting => 'textile' do
+      log_user('jsmith', 'jsmith')
+      visit '/projects/ecookbook/issues/new'
+
+      fill_in 'Description', :with => 'puts 1'
+      find('button.jstb_precode').click
+      within('ul.jstMenu') {click_button 'ruby'}
+      assert_no_selector 'ul.jstMenu'
+      assert_equal %(<pre><code class="ruby">\nputs 1\n</code></pre>\n), find('#issue_description').value
+    end
+  end
+
+  # Text inserted by each button when the whole text is selected
+  BUTTONS_OUTPUT = {
+    'common_mark' => {
+      'strong' => ['text', '**text**'], 'em' => ['text', '*text*'], 'ins' => ['text', '<u>text</u>'],
+      'del' => ['text', '~~text~~'], 'code' => ['text', '`text`'],
+      'h1' => ['### text', '# text'], 'h2' => ['text', '## text'], 'h3' => ['# text', '### text'],
+      'ul' => ['- text', '* text'], 'ol' => ['* text', '1. text'], 'tl' => ['- text', '* [ ] text'],
+      'bq' => ['text', '> text'], 'unbq' => ['> text', 'text'], 'pre' => ['text', "```\ntext\n```"],
+      'link' => ['text', '[[text]]'], 'img' => ['text', '![](text)']
+    },
+    'textile' => {
+      'strong' => ['text', '*text*'], 'em' => ['text', '_text_'], 'ins' => ['text', '+text+'],
+      'del' => ['text', '-text-'], 'code' => ['text', '@text@'],
+      'h1' => ['h3. text', 'h1. text'], 'h2' => ['text', 'h2. text'], 'h3' => ['h1. text', 'h3. text'],
+      'ul' => ['# text', '* text'], 'ol' => ['* text', '# text'],
+      'bq' => ['text', '> text'], 'unbq' => ['> text', 'text'], 'pre' => ['text', "<pre>\ntext\n</pre>"],
+      'link' => ['text', '[[text]]'], 'img' => ['text', '!text!']
+    }
+  }
+
+  BUTTONS_OUTPUT.each do |format, buttons|
+    define_method :"test_buttons_using_#{format}" do
+      with_settings :text_formatting => format do
+        log_user('jsmith', 'jsmith')
+        visit '/projects/ecookbook/issues/new'
+
+        assert_equal buttons.keys.sort,
+                     all('div.jstElements button[data-action="wiki-toolbar#apply"]').pluck('data-wiki-toolbar-button-param').sort
+        buttons.each do |button, (text, expected)|
+          fill_in 'Description', :with => text
+          select_text 'issue_description', 0, text.length
+          find("button.jstb_#{button}").click
+          assert_equal expected, find('#issue_description').value, "#{format} #{button}"
+        end
+      end
+    end
+  end
+
