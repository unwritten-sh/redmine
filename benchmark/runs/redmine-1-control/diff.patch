diff --git a/app/javascript/wiki_formatting/common_mark.js b/app/javascript/wiki_formatting/common_mark.js
new file mode 100644
index 000000000..3ac4e2bee
--- /dev/null
+++ b/app/javascript/wiki_formatting/common_mark.js
@@ -0,0 +1,33 @@
+/**
+ * Redmine - project management software
+ * Copyright (C) 2006-  Jean-Philippe Lang
+ * This code is released under the GNU General Public License.
+ */
+
+// Text inserted by the wiki toolbar buttons for the CommonMark formatter.
+// See wiki_formatting/textile.js for a description of the options.
+export default {
+  buttons: {
+    strong: { action: 'wrap', prefix: '**' },
+    em: { action: 'wrap', prefix: '*' },
+    ins: { action: 'wrap', prefix: '<u>', suffix: '</u>' },
+    del: { action: 'wrap', prefix: '~~' },
+    code: { action: 'wrap', prefix: '`' },
+    h1: { action: 'wrapLines', prefix: '# ', strip: /^#+\s+/ },
+    h2: { action: 'wrapLines', prefix: '## ', strip: /^#+\s+/ },
+    h3: { action: 'wrapLines', prefix: '### ', strip: /^#+\s+/ },
+    ul: { action: 'wrapLines', replace: [/(\n|^)[#-]?\s*/g, '$1* '] },
+    ol: { action: 'wrapLines', replace: [/(\n|^)[*-]?\s*/g, '$11. '] },
+    tl: { action: 'wrapLines', replace: [/(\n|^)[*-]?\s*/g, '$1* [ ] '] },
+    bq: { action: 'wrapLines', replace: [/(\n|^)( *)([^\n]*)/g, '$1> $2$3'] },
+    unbq: { action: 'wrapLines', replace: [/(\n|^) *(> ?)?( *)([^\n]*)/g, '$1$3$4'] },
+    pre: { action: 'wrapLines', prefix: '```\n', suffix: '\n```' },
+    link: { action: 'wrap', prefix: '[[', suffix: ']]' },
+    img: { action: 'wrap', prefix: '![](', suffix: ')' }
+  },
+  table: {
+    headerCell: (name) => `${name} `,
+    separatorCell: '--'
+  },
+  precode: (lang) => ({ prefix: `\`\`\` ${lang}\n`, suffix: '\n```\n' })
+}
diff --git a/app/javascript/wiki_formatting/textile.js b/app/javascript/wiki_formatting/textile.js
new file mode 100644
index 000000000..27ba6e4bf
--- /dev/null
+++ b/app/javascript/wiki_formatting/textile.js
@@ -0,0 +1,40 @@
+/**
+ * Redmine - project management software
+ * Copyright (C) 2006-  Jean-Philippe Lang
+ * This code is released under the GNU General Public License.
+ */
+
+// Text inserted by the wiki toolbar buttons for the Textile formatter.
+//
+// * buttons: the button names rendered by the server, with:
+//   * action: 'wrap' encloses the selection with prefix and suffix (suffix
+//     defaults to prefix), 'wrapLines' encloses the selected lines with
+//     prefix and suffix (both default to '')
+//   * strip: RegExp removed from the selected lines (wrapLines)
+//   * replace: [RegExp, replacement] applied to the selected lines (wrapLines)
+// * table: text of the table generator cells, headerCell is called with the
+//   column name (A, B, ...), separatorCell is the optional separator row cell
+// * precode: returns the prefix and suffix for the highlighted code language
+export default {
+  buttons: {
+    strong: { action: 'wrap', prefix: '*' },
+    em: { action: 'wrap', prefix: '_' },
+    ins: { action: 'wrap', prefix: '+' },
+    del: { action: 'wrap', prefix: '-' },
+    code: { action: 'wrap', prefix: '@' },
+    h1: { action: 'wrapLines', prefix: 'h1. ', strip: /^h\d+\.\s+/ },
+    h2: { action: 'wrapLines', prefix: 'h2. ', strip: /^h\d+\.\s+/ },
+    h3: { action: 'wrapLines', prefix: 'h3. ', strip: /^h\d+\.\s+/ },
+    ul: { action: 'wrapLines', replace: [/(\n|^)[#-]?\s*/g, '$1* '] },
+    ol: { action: 'wrapLines', replace: [/(\n|^)[*-]?\s*/g, '$1# '] },
+    bq: { action: 'wrapLines', replace: [/(\n|^)( *)([^\n]*)/g, '$1> $2$3'] },
+    unbq: { action: 'wrapLines', replace: [/(\n|^) *(> ?)?( *)([^\n]*)/g, '$1$3$4'] },
+    pre: { action: 'wrapLines', prefix: '<pre>\n', suffix: '\n</pre>' },
+    link: { action: 'wrap', prefix: '[[', suffix: ']]' },
+    img: { action: 'wrap', prefix: '!', suffix: '!' }
+  },
+  table: {
+    headerCell: (name) => `_.${name}`
+  },
+  precode: (lang) => ({ prefix: `<pre><code class="${lang}">\n`, suffix: '\n</code></pre>\n' })
+}
