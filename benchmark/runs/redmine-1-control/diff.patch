+
+  private
+
+  # Returns the button names of the toolbar, grouped by spacers
+  def button_groups(html)
+    elements = Nokogiri::HTML.fragment(html).at_css('div.jstElements').element_children
+    elements.chunk {|element| element.name == 'button' || :_separator}.map do |_, buttons|
+      buttons.map {|button| button['class'].delete_prefix('jstb_')}
+    end
+  end
+
+  def assert_buttons_without_syntax(html)
+    %w[prefix suffix strip pattern replacement header-cell separator-cell].each do |param|
+      assert_select_in html, "[data-wiki-toolbar-#{param}-param]", 0
+    end
+    assert_select_in html, 'button.jstb_table[data-action=?][data-wiki-toolbar-menu-param=table]:not([data-wiki-toolbar-button-param])',
+                     'wiki-toolbar#toggleMenu'
+    assert_select_in html, 'button.jstb_precode[data-action=?][data-wiki-toolbar-menu-param=precode]:not([data-wiki-toolbar-button-param])',
+                     'wiki-toolbar#toggleMenu'
+    assert_select_in html, 'button.jstb_help[data-action=?]:not([data-wiki-toolbar-button-param])', 'wiki-toolbar#help'
+  end
 end
