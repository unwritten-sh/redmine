{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0189u6jtXTcL45Y5sixUdt63","type":"tool_result","content":"# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n# This program is free software; you can redistribute it and/or\n# modify it under the terms of the GNU General Public License\n# as published by the Free Software Foundation; either version 2\n# of the License, or (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with this program; if not, write to the Free Software\n# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n\nrequire_relative '../../../test_helper'\n\nclass Redmine::WikiToolbarTest < Redmine::HelperTest\n  include ApplicationHelper\n\n  def test_wikitoolbar_for_should_render_toolbar_for_the_field\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description', '/issues/preview')\n\n      assert_select_in html, 'div.jstBlock[hidden][data-controller=?]', 'wiki-toolbar' do\n        assert_select '[data-wiki-toolbar-field-id-value=?]', 'issue_description'\n        assert_select '[data-wiki-toolbar-preview-url-value=?]', '/issues/preview'\n        assert_select '[data-wiki-toolbar-help-url-value=?]', '/help/wiki_syntax'\n        assert_select 'div.jstTabs ul[role=tablist]' do\n          assert_select 'a.tab-edit.selected[aria-selected=true]', :text => 'Edit'\n          assert_select 'a.tab-preview[aria-selected=false]', :text => 'Preview'\n          assert_select 'div.jstElements'\n        end\n        assert_select 'div.jstEditor div.wiki-preview.hidden#preview_issue_description'\n      end\n    end\n  end\n\n  def test_wikitoolbar_for_should_render_nothing_without_text_formatting\n    with_settings :text_formatting => '' do\n      assert_nil wikitoolbar_for('issue_description')\n    end\n  end\n\n  def test_common_mark_buttons\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'div.jstElements' do\n        assert_select 'button', 19\n        assert_select 'span.jstSpacer', 5\n        assert_select 'button.jstb_strong[title=?][data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-shortcut=b]',\n                      'Strong', 'wiki-toolbar#wrap', '**'\n        assert_select 'button.jstb_ins[data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-suffix-param=?]', '<u>', '</u>'\n        assert_select 'button.jstb_h1[data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-strip-param=?]',\n                      'wiki-toolbar#wrapLines', '# ', '^#+\\s+'\n        assert_select 'button.jstb_tl[data-wiki-toolbar-replacement-param=?]', '* [ ] '\n        assert_select 'button.jstb_table[data-action=?][data-wiki-toolbar-menu-param=table][data-wiki-toolbar-separator-cell-param=?]',\n                      'wiki-toolbar#toggleMenu', '--'\n        assert_select 'button.jstb_precode[data-wiki-toolbar-menu-param=precode]:not([data-wiki-toolbar-prefix-param])'\n        assert_select 'button.jstb_help[data-action=?]', 'wiki-toolbar#help'\n      end\n    end\n  end\n\n  def test_textile_buttons\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'div.jstElements' do\n        assert_select 'button', 18\n        assert_select 'button.jstb_tl', 0\n        assert_select 'button.jstb_strong[data-wiki-toolbar-prefix-param=?]', '*'\n        assert_select 'button.jstb_ol[data-wiki-toolbar-replacement-param=?]', '# '\n        assert_select 'button.jstb_table[data-wiki-toolbar-header-cell-param=?]:not([data-wiki-toolbar-separator-cell-param])', '_.%{name}'\n      end\n    end\n  end\n\n  def test_buttons_should_be_translated\n    with_settings :text_formatting => 'common_mark' do\n      set_language_if_valid 'fr'\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'a.tab-edit', :text => ::I18n.t(:button_edit, :locale => 'fr')\n      assert_select_in html, 'button.jstb_strong[title=?]', ::I18n.t(:label_wiki_toolbar_strong, :locale => 'fr')\n    end\n  end\n\n  def test_keyboard_shortcuts\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n      actions = Nokogiri::HTML.fragment(html).at_css('div.jstBlock')['data-action'].split\n\n      %w[b i u].each do |key|\n        assert_include \"keydown.ctrl+#{key}->wiki-toolbar#shortcut\", actions\n        assert_include \"keydown.meta+#{key}->wiki-toolbar#shortcut\", actions\n      end\n      assert_include 'keydown.ctrl+shift+p@window->wiki-toolbar#togglePreview', actions\n      assert_include 'keydown.meta+shift+p@window->wiki-toolbar#togglePreview', actions\n    end\n  end\n\n  def test_precode_menu_should_list_the_user_languages\n    User.current = User.find(2)\n    User.current.pref.update!(:toolbar_language_options => 'ruby,python')\n\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=precodeMenu] ul.jstMenu[role=menu]' do\n        assert_select 'button[role=menuitem][data-action=?]', 'wiki-toolbar#wrapLines', :count => 2\n      end\n      item = Nokogiri::HTML.fragment(html).at_css('ul.jstMenu button')\n      assert_equal 'ruby', item.text\n      assert_equal %(<pre><code class=\"ruby\">\\n), item['data-wiki-toolbar-prefix-param']\n      assert_equal \"\\n</code></pre>\\n\", item['data-wiki-toolbar-suffix-param']\n    end\n  end\n\n  def test_table_menu\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=tableMenu] table.table-generator' do\n        assert_select 'tr', 5\n        assert_select 'td button', 50\n        assert_select 'td button[title=?][data-action=?][data-wiki-toolbar-cols-param=\"3\"][data-wiki-toolbar-rows-param=\"2\"]',\n                      '3×2', 'wiki-toolbar#insertTable'\n      end\n    end\n  end\n\n  def test_heads_for_wiki_formatter_should_only_define_image_mime_types\n    with_settings :text_formatting => 'common_mark' do\n      heads_for_wiki_formatter\n      heads_for_wiki_formatter\n      header_tags = content_for(:header_tags)\n\n      assert_include 'var wikiImageMimeTypes = ', header_tags\n      assert_equal 1, header_tags.scan('wikiImageMimeTypes').size\n      assert_not_include 'jstoolbar', header_tags\n    end\n  end\nend\ntest/integration/layout_test.rb:60:    assert_select \"head script:match('src',?)\", %r{/assets/jstoolbar/}, 0\ntest/integration/layout_test.rb:61:    assert_select \"head link[rel=stylesheet]:match('href',?)\", %r{/assets/jstoolbar-\\w+.css}\ntest/integration/layout_test.rb:63:    assert_select 'div.jstBlock[data-wiki-toolbar-field-id-value=issue_description]' do\ntest/integration/layout_test.rb:64:      UserPreference::DEFAULT_TOOLBAR_LANGUAGE_OPTIONS.each do |lang|\ntest/integration/layout_test.rb:65:        assert_select 'template[data-wiki-toolbar-target=precodeMenu]', :html => /data-wiki-toolbar-prefix-param=\"``` #{lang}/\ntest/system/keyboard_shortcuts_test.rb:54:    page.find('#issue_description_and_toolbar').click_link('Preview')\ntest/system/keyboard_shortcuts_test.rb:66:  def test_keyboard_shortcuts_for_wiki_toolbar_buttons_using_textile\ntest/system/keyboard_shortcuts_test.rb:86:  def test_keyboard_shortcuts_for_wiki_toolbar_buttons_using_markdown\n# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n