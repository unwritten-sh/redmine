@@ -0,0 +1,27 @@
+/**
+ * Redmine - project management software
+ * Copyright (C) 2006-  Jean-Philippe Lang
+ * This code is released under the GNU General Public License.
+ */
+
+// Syntax inserted by the wiki toolbar buttons for the Textile formatter.
+// See wiki_formatting/index.js for the description of each kind of button.
+export default {
+  strong: { action: 'wrap', prefix: '*' },
+  em: { action: 'wrap', prefix: '_' },
+  ins: { action: 'wrap', prefix: '+' },
+  del: { action: 'wrap', prefix: '-' },
+  code: { action: 'wrap', prefix: '@' },
+  h1: { action: 'wrapLines', prefix: 'h1. ', strip: String.raw`^h\d+\.\s+` },
+  h2: { action: 'wrapLines', prefix: 'h2. ', strip: String.raw`^h\d+\.\s+` },
+  h3: { action: 'wrapLines', prefix: 'h3. ', strip: String.raw`^h\d+\.\s+` },
+  ul: { action: 'wrapLines', pattern: String.raw`[#-]?\s*`, replacement: '* ' },
+  ol: { action: 'wrapLines', pattern: String.raw`[*-]?\s*`, replacement: '# ' },
+  bq: { action: 'wrapLines', pattern: String.raw`( *)([^\n]*)`, replacement: '> $2$3' },
+  unbq: { action: 'wrapLines', pattern: String.raw` *(> ?)?( *)([^\n]*)`, replacement: '$3$4' },
+  pre: { action: 'wrapLines', prefix: '<pre>\n', suffix: '\n</pre>' },
+  link: { action: 'wrap', prefix: '[[', suffix: ']]' },
+  img: { action: 'wrap', prefix: '!', suffix: '!' },
+  table: { headerCell: (name) => `_.${name}` },
+  precode: { prefix: (lang) => `<pre><code class="${lang}">\n`, suffix: '\n</code></pre>\n' }
+}
