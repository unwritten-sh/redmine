+
+  private
+
+  # Button names of the toolbar, with "|" for the spacers
+  def toolbar_layout(html)
+    Nokogiri::HTML.fragment(html).css('div.jstElements > *').map do |node|
+      node.name == 'span' ? '|' : node['class'].delete_prefix('jstb_')
+    end
+  end
+
+  def assert_no_syntax_params(html)
+    %w[prefix suffix strip pattern replacement header-cell separator-cell].each do |param|
+      assert_not_include "data-wiki-toolbar-#{param}-param", html
+    end
+  end
 end
