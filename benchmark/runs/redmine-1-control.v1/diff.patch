@@ -0,0 +1,28 @@
+/**
+ * Redmine - project management software
+ * Copyright (C) 2006-  Jean-Philippe Lang
+ * This code is released under the GNU General Public License.
+ */
+
+// Syntax inserted by the wiki toolbar buttons for the CommonMark formatter.
+// See wiki_formatting/index.js for the description of each kind of button.
+export default {
+  strong: { action: 'wrap', prefix: '**' },
+  em: { action: 'wrap', prefix: '*' },
+  ins: { action: 'wrap', prefix: '<u>', suffix: '</u>' },
+  del: { action: 'wrap', prefix: '~~' },
+  code: { action: 'wrap', prefix: '`' },
+  h1: { action: 'wrapLines', prefix: '# ', strip: String.raw`^#+\s+` },
+  h2: { action: 'wrapLines', prefix: '## ', strip: String.raw`^#+\s+` },
+  h3: { action: 'wrapLines', prefix: '### ', strip: String.raw`^#+\s+` },
+  ul: { action: 'wrapLines', pattern: String.raw`[#-]?\s*`, replacement: '* ' },
+  ol: { action: 'wrapLines', pattern: String.raw`[*-]?\s*`, replacement: '1. ' },
+  tl: { action: 'wrapLines', pattern: String.raw`[*-]?\s*`, replacement: '* [ ] ' },
+  bq: { action: 'wrapLines', pattern: String.raw`( *)([^\n]*)`, replacement: '> $2$3' },
+  unbq: { action: 'wrapLines', pattern: String.raw` *(> ?)?( *)([^\n]*)`, replacement: '$3$4' },
+  pre: { action: 'wrapLines', prefix: '```\n', suffix: '\n```' },
+  link: { action: 'wrap', prefix: '[[', suffix: ']]' },
+  img: { action: 'wrap', prefix: '![](', suffix: ')' },
+  table: { headerCell: (name) => `${name} `, separatorCell: '--' },
+  precode: { prefix: (lang) => `\`\`\` ${lang}\n`, suffix: '\n```\n' }
+}
diff --git a/app/javascript/wiki_formatting/index.js b/app/javascript/wiki_formatting/index.js
new file mode 100644
index 000000000..f72a31c37
--- /dev/null
+++ b/app/javascript/wiki_formatting/index.js
@@ -0,0 +1,29 @@
+/**
+ * Redmine - project management software
+ * Copyright (C) 2006-  Jean-Philippe Lang
+ * This code is released under the GNU General Public License.
+ */
+import commonMark from 'wiki_formatting/common_mark'
+import textile from 'wiki_formatting/textile'
+
+// Syntax of the wiki toolbar buttons for each text formatter, keyed by the
+// format name given in data-wiki-toolbar-format-value.
+//
+// Each format maps a button name to:
+// * {action: 'wrap', prefix, suffix} - encloses the selection, suffix
+//   defaults to prefix
+// * {action: 'wrapLines', prefix, suffix, strip, pattern, replacement} -
+//   encloses the selected lines, after removing the strip regexp and
+//   replacing pattern at the start of each line by replacement
+// * table: {headerCell(name), separatorCell} - cells of the inserted table,
+//   the separator row is omitted without separatorCell
+// * precode: {prefix(lang), suffix} - encloses the selected lines in a code
+//   block for the given language
+//
+// Plugins that add a text formatter can register its syntax here.
+const formats = {
+  common_mark: commonMark,
+  textile: textile
+}
+
+export default formats
