eturn\n    const [modifier, other] = isMac ? [event.metaKey, event.ctrlKey] : [event.ctrlKey, event.metaKey]\n    if (!modifier || other || event.shiftKey || event.altKey) return\n\n    const button = this.toolbarTarget.querySelector(`[data-wiki-toolbar-shortcut=\"${CSS.escape(event.key.toLowerCase())}\"]`)\n    if (button) {\n      event.preventDefault()\n      button.click()\n    }\n  }\n\n  // Preview\n\"\"\")\n# remove old help/shortcut/Preview header that followed\nold_tail=\"\"\"\n  help() {\n    window.open(this.helpUrlValue, '', 'resizable=yes, location=no, width=300, height=640, menubar=no, status=no, scrollbars=yes')\n  }\n\n  shortcut(event) {\n    if (event.target !== this.field || !(isMac ? event.metaKey : event.ctrlKey)) return\n\n    const button = this.toolbarTarget.querySelector(`[data-wiki-toolbar-shortcut=\"${event.key.toLowerCase()}\"]`)\n    if (button) {\n      event.preventDefault()\n      button.click()\n    }\n  }\n\n  // Preview\n\"\"\"\nassert old_tail in s\ns=s.replace(old_tail,\"\")\ns=s.replace(\"\"\"    this.encloseLineSelection(String(prefix), String(suffix), (str) => {\"\"\",\"\"\"PLACEHOLDER\"\"\")\ns=s.replace(\"\"\"    this.menuParams = params\n\"\"\",\"\")\ns=s.replace(\"\"\"    const { headerCell, separatorCell } = this.menuParams\n\"\"\",\"\"\"    const { headerCell, separatorCell } = this.syntax.table\n\"\"\")\ns=s.replace(\"\"\"line(names.map((name) => String(headerCell).replace('%{name}', name)))\"\"\",\"\"\"line(names.map(headerCell))\"\"\")\ns=s.replace(\"\"\"  // Private\n\n  get previewing() {\"\"\",\"\"\"  // Private\n\n  get syntax() {\n    return formats[this.formatValue] || {}\n  }\n\n  wrap({ prefix, suffix = prefix }) {\n    this.encloseSelection(prefix, suffix)\n  }\n\n  wrapLines({ prefix = '', suffix = '', strip, pattern, replacement = '' }) {\n    this.encloseLineSelection(prefix, suffix, (str) => {\n      if (strip) {\n        str = str.replace(new RegExp(strip), '')\n      }\n      if (pattern) {\n        str