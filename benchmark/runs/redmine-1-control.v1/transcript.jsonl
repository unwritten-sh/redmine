{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012xxqbpEQG9rYieCwvGmMmB","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\t# Redmine - project management software\n4\t# Copyright (C) 2006-  Jean-Philippe Lang\n5\t#\n6\t# This program is free software; you can redistribute it and/or\n7\t# modify it under the terms of the GNU General Public License\n8\t# as published by the Free Software Foundation; either version 2\n9\t# of the License, or (at your option) any later version.\n10\t#\n11\t# This program is distributed in the hope that it will be useful,\n12\t# but WITHOUT ANY WARRANTY; without even the implied warranty of\n13\t# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n14\t# GNU General Public License for more details.\n15\t#\n16\t# You should have received a copy of the GNU General Public License\n17\t# along with this program; if not, write to the Free Software\n18\t# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n19\t\n20\tmodule Redmine\n21\t  # Renders the wiki toolbar handled by the wiki-toolbar Stimulus controller.\n22\t  #\n23\t  # Text formatters subclass it and describe their buttons in #buttons. Each\n24\t  # button is a Hash with:\n25\t  # * :name - the button name, used for the \"jstb_<name>\" CSS class\n26\t  # * :action - the controller action: wrap, wrapLines or help\n27\t  # * :menu - :precode or :table, opens a menu instead of running an action\n28\t  # * :shortcut - optional key used with Ctrl (Cmd on macOS)\n29\t  # * any other key is passed to the action as a Stimulus action parameter\n30\t  #\n31\t  # Use SPACER to separate groups of buttons.\n32\t  class WikiToolbar\n33\t    SPACER = :spacer\n34\t\n35\t    LABELS = {\n36\t      'strong' => :label_wiki_toolbar_strong,\n37\t      'em' => :label_wiki_toolbar_italic,\n38\t      'ins' => :label_wiki_toolbar_underline,\n39\t      'del' => :label_wiki_toolbar_deleted,\n40\t      'code' => :label_wiki_toolbar_code,\n41\t      'h1' => :label_wiki_toolbar_heading_1,\n42\t      'h2' => :label_wiki_toolbar_heading_2,\n43\t      'h3' => :label_wiki_toolbar_heading_3,\n44\t      'ul' => :label_wiki_toolbar_unordered_list,\n45\t      'ol' => :label_wiki_toolbar_ordered_list,\n46\t      'tl' => :label_wiki_toolbar_task_list,\n47\t      'bq' => :label_wiki_toolbar_quote,\n48\t      'unbq' => :label_wiki_toolbar_unquote,\n49\t      'table' => :label_wiki_toolbar_table,\n50\t      'pre' => :label_wiki_toolbar_preformatted_text,\n51\t      'precode' => :label_wiki_toolbar_preformatted_code,\n52\t      'link' => :label_wiki_toolbar_wiki_link,\n53\t      'img' => :label_wiki_toolbar_image,\n54\t      'help' => :label_wiki_toolbar_help\n55\t    }.freeze\n56\t\n57\t    BUTTON_KEYS = [:name, :action, :menu, :shortcut, :label].freeze\n58\t    # Button options used to render the menu instead of being action parameters\n59\t    MENU_KEYS = {precode: [:prefix, :suffix]}.freeze\n60\t    TABLE_MENU_ROWS = 5\n61\t    TABLE_MENU_COLS = 10\n62\t\n63\t    # Helper methods shared by the text formatters that use the toolbar\n64\t    module Helper\n65\t      def wikitoolbar_for(field_id, preview_url = preview_text_path)\n66\t        heads_for_wiki_formatter\n67\t        wiki_toolbar.render(field_id, preview_url)\n68\t      end\n69\t\n70\t      def heads_for_wiki_formatter\n71\t        return if @heads_for_wiki_formatter_included\n72\t\n73\t        content_for :header_tags do\n74\t          javascript_tag(\"var wikiImageMimeTypes = #{Redmine::MimeType.by_type('image').to_json};\")\n75\t        end\n76\t        @heads_for_wiki_formatter_included = true\n77\t      end\n78\t    end\n79\t\n80\t    def initialize(view)\n81\t      @view = view\n82\t    end\n83\t\n84\t    def buttons\n85\t      []\n86\t    end\n87\t\n88\t    def render(field_id, preview_url)\n89\t      tag.div(class: 'jstBlock', hidden: true,\n90\t              data: {\n91\t                controller: 'wiki-toolbar',\n92\t                action: keyboard_actions,\n93\t                wiki_toolbar_field_id_value: field_id,\n94\t                wiki_toolbar_preview_url_value: preview_url,\n95\t                wiki_toolbar_help_url_value: @view.help_wiki_syntax_path\n96\t              }) do\n97\t        tabs +\n98\t          tag.div(class: 'jstEditor', data: {wiki_toolbar_target: 'editor'}) do\n99\t            tag.div('', class: 'wiki wiki-preview hidden', id: \"preview_#{field_id}\",\n100\t                    data: {wiki_toolbar_target: 'preview'})\n101\t          end +\n102\t          menus\n103\t      end\n104\t    end\n105\t\n106\t    private\n107\t\n108\t    def tag\n109\t      @view.tag\n110\t    end\n111\t\n112\t    def l(...)\n113\t      @view.l(...)\n114\t    end\n115\t\n116\t    def tabs\n117\t      tag.div(class: 'jstTabs tabs') do\n118\t        tag.ul(role: 'tablist') do\n119\t          tag.li {tab(l(:button_edit), 'edit', true)} +\n120\t            tag.li {tab(l(:label_preview), 'preview', false)} +\n121\t            tag.li(class: 'tab-elements') do\n122\t              tag.div(rendered_buttons, class: 'jstElements', data: {wiki_toolbar_target: 'toolbar'})\n123\t            end\n124\t        end\n125\t      end\n126\t    end\n127\t\n128\t    def tab(text, name, selected)\n129\t      tag.a(text, href: '#', class: ['tab-' + name, {selected: selected}], role: 'tab',\n130\t            aria: {selected: selected},\n131\t            data: {wiki_toolbar_target: \"#{name}Tab\", action: \"wiki-toolbar##{name}:prevent\"})\n132\t    end\n133\t\n134\t    def rendered_buttons\n135\t      @rendered_buttons ||= @view.safe_join(buttons.map {|button| render_button(button)})\n136\t    end\n137\t\n138\t    def render_button(button)\n139\t      return tag.span(\" \", class: 'jstSpacer') if button == SPACER\n140\t\n141\t      name = button[:name]\n142\t      title = l(button[:label] || LABELS.fetch(name))\n143\t      data = button_params(button)\n144\t      if button[:menu]\n145\t        data[:action] = 'wiki-toolbar#toggleMenu'\n146\t        data[:wiki_toolbar_menu_param] = button[:menu]\n147\t      else\n148\t        data[:action] = \"wiki-toolbar##{button[:action]}\"\n149\t      end\n150\t      data[:wiki_toolbar_shortcut] = button[:shortcut] if button[:shortcut]\n151\t\n152\t      tag.button(tag.span(title), type: 'button', class: \"jstb_#{name}\", title: title, tabindex: 200, data: data)\n153\t    end\n154\t\n155\t    # Converts the button options to Stimulus action parameters\n156\t    def button_params(button)\n157\t      button.except(*BUTTON_KEYS, *MENU_KEYS[button[:menu]]).transform_keys {|key| :\"wiki_toolbar_#{key}_param\"}\n158\t    end\n159\t\n160\t    def menus\n161\t      @menus ||= begin\n162\t        templates = buttons.filter_map do |button|\n163\t          next unless button.is_a?(Hash) && button[:menu]\n164\t\n165\t          tag.template(data: {wiki_toolbar_target: \"#{button[:menu]}Menu\"}) do\n166\t            send(:\"#{button[:menu]}_menu\", button)\n167\t          end\n168\t        end\n169\t        @view.safe_join(templates)\n170\t      end\n171\t    end\n172\t\n173\t    # Lists the languages for code highlighting. Each item wraps the selected\n174\t    # lines using the :prefix and :suffix of the button, where %{lang} is\n175\t    # replaced by the language.\n176\t    def precode_menu(button)\n177\t      tag.ul(class: 'jstMenu', role: 'menu',\n178\t             data: {action: 'click->wiki-toolbar#closeMenu keydown.esc->wiki-toolbar#closeMenu'}) do\n179\t        @view.safe_join(\n180\t          code_languages.map do |lang|\n181\t            tag.li(role: 'none') do\n182\t              tag.button(lang, type: 'button', role: 'menuitem',\n183\t                         data: {\n184\t                           action: 'wiki-toolbar#wrapLines',\n185\t                           wiki_toolbar_prefix_param: format(button[:prefix], lang: lang),\n186\t                           wiki_toolbar_suffix_param: format(button[:suffix], lang: lang)\n187\t                         })\n188\t            end\n189\t          end\n190\t        )\n191\t      end\n192\t    end\n193\t\n194\t    def table_menu(_button)\n195\t      tag.table(class: 'table-generator', role: 'grid',\n196\t                data: {\n197\t                  action: 'click->wiki-toolbar#closeMenu keydown.esc->wiki-toolbar#closeMenu ' \\\n198\t                          'mouseover->wiki-toolbar#highlightTable focusin->wiki-toolbar#highlightTable'\n199\t                }) do\n200\t        @view.safe_join(\n201\t          (1..TABLE_MENU_ROWS).map do |row|\n202\t            tag.tr do\n203\t              @view.safe_join(\n204\t                (1..TABLE_MENU_COLS).map do |col|\n205\t                  tag.td do\n206\t                    tag.button(type: 'button', title: \"#{col}×#{row}\", aria: {label: \"#{col}×#{row}\"},\n207\t                               data: {\n208\t                                 action: 'wiki-toolbar#insertTable',\n209\t                                 wiki_toolbar_cols_param: col,\n210\t                                 wiki_toolbar_rows_param: row\n211\t                               })\n212\t                  end\n213\t                end\n214\t              )\n215\t            end\n216\t          end\n217\t        )\n218\t      end\n219\t    end\n220\t\n221\t    def code_languages\n222\t      User.current.pref.toolbar_language_options.to_s.split(',')\n223\t    end\n224\t\n225\t    def keyboard_actions\n226\t      @keyboard_actions ||= begin\n227\t        keys = buttons.filter_map {|button| button[:shortcut] if button.is_a?(Hash)}\n228\t        actions = keys.flat_map do |key|\n229\t          %w[ctrl meta].map {|modifier| \"keydown.#{modifier}+#{key}->wiki-toolbar#shortcut\"}\n230\t        end\n231\t        actions += %w[ctrl meta].map {|modifier| \"keydown.#{modifier}+shift+p@window->wiki-toolbar#togglePreview\"}\n232\t        actions.join(' ')\n233\t      end\n234\t    end\n235\t  end\n236\tend\n237\t"}]},"parent_tool_use_id":null,"session_id":"a7c435fe-4f4a-423f-99e0-d9041f4d15f8","uuid":"07a23ed7-f059-4765-8c69-01b452088c2f","timestamp":"2026-11-01T21:41:07.799Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/redmine/bench/trees/redmine-1-control/lib/redmine/wiki_toolbar.rb","content":"# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n# This program is free software; you can redistribute it and/or\n# modify it under the terms of the GNU General Public License\n# as published by the Free Software Foundation; either version 2\n# of the License, or (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with this program; if not, write to the Free Software\n# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n\nmodule Redmine\n  # Renders the wiki toolbar handled by the wiki-toolbar Stimulus controller.\n  #\n  # Text formatters subclass it and describe their buttons in #buttons. Each\n  # button is a Hash with:\n  # * :name - the button name, used for the \"jstb_<name>\" CSS class\n  # * :action - the controller action: wrap, wrapLines or help\n  # * :menu - :precode or :table, opens a menu instead of running an action\n  # * :shortcut - optional key used with Ctrl (Cmd on macOS)\n  # * any other key is passed to the action as a Stimulus action parameter\n  #\n  # Use SPACER to separate groups of buttons.\n  class WikiToolbar\n    SPACER = :spacer\n\n    LABELS = {\n      'strong' => :label_wiki_toolbar_strong,\n      'em' => :label_wiki_toolbar_italic,\n      'ins' => :label_wiki_toolbar_underline,\n      'del' => :label_wiki_toolbar_deleted,\n      'code' => :label_wiki_toolbar_code,\n      'h1' => :label_wiki_toolbar_heading_1,\n      'h2' => :label_wiki_toolbar_heading_2,\n      'h3' => :label_wiki_toolbar_heading_3,\n      'ul' => :label_wiki_toolbar_unordered_list,\n      'ol' => :label_wiki_toolbar_ordered_list,\n      'tl' => :label_wiki_toolbar_task_list,\n      'bq' => :label_wiki_toolbar_quote,\n      'unbq' => :label_wiki_toolbar_unquote,\n      'table' => :label_wiki_toolbar_table,\n      'pre' => :label_wiki_toolbar_preformatted_text,\n      'precode' => :label_wiki_toolbar_preformatted_code,\n      'link' => :label_wiki_toolbar_wiki_link,\n      'img' => :label_wiki_toolbar_image,\n      'help' => :label_wiki_toolbar_help\n    }.freeze\n\n    BUTTON_KEYS = [:name, :action, :menu, :shortcut, :label].freeze\n    # Button options used to render the menu instead of being action parameters\n    MENU_KEYS = {precode: [:prefix, :suffix]}.freeze\n    TABLE_MENU_ROWS = 5\n    TABLE_MENU_COLS = 10\n\n    # Helper methods shared by the text formatters that use the toolbar\n    module Helper\n      def wikitoolbar_for(field_id, preview_url = preview_text_path)\n        heads_for_wiki_formatter\n        wiki_toolbar.render(field_id, preview_url)\n      end\n\n      def heads_for_wiki_formatter\n        return if @heads_for_wiki_formatter_included\n\n        content_for :header_tags do\n          javascript_tag(\"var wikiImageMimeTypes = #{Redmine::MimeType.by_type('image').to_json};\")\n        end\n        @heads_for_wiki_formatter_included = true\n      end\n    end\n\n    def initialize(view)\n      @view = view\n    end\n\n    def buttons\n      []\n    end\n\n    def render(field_id, preview_url)\n      tag.div(class: 'jstBlock', hidden: true,\n              data: {\n                controller: 'wiki-toolbar',\n                action: keyboard_actions,\n                wiki_toolbar_field_id_value: field_id,\n                wiki_toolbar_preview_url_value: preview_url,\n                wiki_toolbar_help_url_value: @view.help_wiki_syntax_path\n              }) do\n        tabs +\n          tag.div(class: 'jstEditor', data: {wiki_toolbar_target: 'editor'}) do\n            tag.div('', class: 'wiki wiki-preview hidden', id: \"preview_#{field_id}\",\n                    data: {wiki_toolbar_target: 'preview'})\n          end +\n          menus\n      end\n    end\n\n    private\n\n    def tag\n      @view.tag\n    end\n\n    def l(...)\n      @view.l(...)\n    end\n\n    def tabs\n      tag.div(class: 'jstTabs tabs') do\n        tag.ul(role: 'tablist') do\n          tag.li {tab(l(:button_edit), 'edit', true)} +\n            tag.li {tab(l(:label_preview), 'preview', false)} +\n            tag.li(class: 'tab-elements') do\n              tag.div(rendered_buttons, class: 'jstElements', data: {wiki_toolbar_target: 'toolbar'})\n            end\n        end\n      end\n    end\n\n    def tab(text, name, selected)\n      tag.a(text, href: '#', class: ['tab-' + name, {selected: selected}], role: 'tab',\n            aria: {selected: selected},\n            data: {wiki_toolbar_target: \"#{name}Tab\", action: \"wiki-toolbar##{name}:prevent\"})\n    end\n\n    def rendered_buttons\n      @rendered_buttons ||= @view.safe_join(buttons.map {|button| render_button(button)})\n    end\n\n    def render_button(button)\n      return tag.span(\" \", class: 'jstSpacer') if button == SPACER\n\n      name = button[:name]\n      title = l(button[:label] || LABELS.fetch(name))\n      data = button_params(button)\n      if button[:menu]\n        data[:action] = 'wiki-toolbar#toggleMenu'\n        data[:wiki_toolbar_menu_param] = button[:menu]\n      else\n        data[:action] = \"wiki-toolbar##{button[:action]}\"\n      end\n      data[:wiki_toolbar_shortcut] = button[:shortcut] if button[:shortcut]\n\n      tag.button(tag.span(title), type: 'button', class: \"jstb_#{name}\", title: title, tabindex: 200, data: data)\n    end\n\n    # Converts the button options to Stimulus action parameters\n    def button_params(button)\n      button.except(*BUTTON_KEYS, *MENU_KEYS[button[:menu]]).transform_keys {|key| :\"wiki_toolbar_#{key}_param\"}\n    end\n\n    def menus\n      @menus ||= begin\n        templates = buttons.filter_map do |button|\n          next unless button.is_a?(Hash) && button[:menu]\n\n          tag.template(data: {wiki_toolbar_target: \"#{button[:menu]}Menu\"}) do\n            send(:\"#{button[:menu]}_menu\", button)\n          end\n        end\n        @view.safe_join(templates)\n      end\n    end\n\n    # Lists the languages for code highlighting. Each item wraps the selected\n    # lines using the :prefix and :suffix of the button, where %{lang} is\n    # replaced by the language.\n    def precode_menu(button)\n      tag.ul(class: 'jstMenu', role: 'menu',\n             data: {action: 'click->wiki-toolbar#closeMenu keydown.esc->wiki-toolbar#closeMenu'}) do\n        @view.safe_join(\n          code_languages.map do |lang|\n            tag.li(role: 'none') do\n              tag.button(lang, type: 'button', role: 'menuitem',\n                         data: {\n                           action: 'wiki-toolbar#wrapLines',\n                           wiki_toolbar_prefix_param: format(button[:prefix], lang: lang),\n                           wiki_toolbar_suffix_param: format(button[:suffix], lang: lang)\n                         })\n            end\n          end\n        )\n      end\n    end\n\n    def table_menu(_button)\n      tag.table(class: 'table-generator', role: 'grid',\n                data: {\n                  action: 'click->wiki-toolbar#closeMenu keydown.esc->wiki-toolbar#closeMenu ' \\\n                          'mouseover->wiki-toolbar#highlightTable focusin->wiki-toolbar#highlightTable'\n                }) do\n        @view.safe_join(\n          (1..TABLE_MENU_ROWS).map do |row|\n            tag.tr do\n              @view.safe_join(\n                (1..TABLE_MENU_COLS).map do |col|\n                  tag.td do\n                    tag.button(type: 'button', title: \"#{col}×#{row}\", aria: {label: \"#{col}×#{row}\"},\n                               data: {\n                                 action: 'wiki-toolbar#insertTable',\n                                 wiki_toolbar_cols_param: col,\n                                 wiki_toolbar_rows_param: row\n                               })\n                  end\n                end\n              )\n            end\n          end\n        )\n      end\n    end\n\n    def code_languages\n      User.current.pref.toolbar_language_options.to_s.split(',')\n    end\n\n    def keyboard_actions\n      @keyboard_actions ||= begin\n        keys = buttons.filter_map {|button| button[:shortcut] if button.is_a?(Hash)}\n        actions = keys.flat_map do |key|\n          %w[ctrl meta].map {|modifier| \"keydown.#{modifier}+#{key}->wiki-toolbar#shortcut\"}\n        end\n        actions += %w[ctrl meta].map {|modifier| \"keydown.#{modifier}+shift+p@window->wiki-toolbar#togglePreview\"}\n        actions.join(' ')\n      end\n    end\n  end\nend\n","numLines":237,"startLine":1,"totalLines":237}},"tool_result_meta":[{"id":"toolu_012xxqbpEQG9rYieCwvGmMmB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
