with => 'Some text'\n44\t      select_text 'issue_description', 0, 4\n45\t      find('button.jstb_link').click\n46\t      assert_equal '[[Some]] text', find('#issue_description').value\n47\t    end\n48\t  end\n49\t\n50\t  def test_wrap_lines_using_common_mark\n51\t    with_settings :text_formatting => 'common_mark' do\n52\t      log_user('jsmith', 'jsmith')\n53\t      visit '/projects/ecookbook/issues/new'\n54\t\n55\t      fill_in 'Description', :with => \"## Title\"\n56\t      find('button.jstb_h1').click\n57\t      assert_equal '# Title', find('#issue_description').value\n58\t\n59\t      fill_in 'Description', :with => \"first\\nsecond\"\n60\t      select_text 'issue_description', 0, 12\n61\t      find('button.jstb_ol').click\n62\t      assert_equal \"1. first\\n1. second\", find('#issue_description').value\n63\t\n64\t      select_text 'issue_description', 0, 18\n65\t      find('button.jstb_bq').click\n66\t      assert_equal \"> 1. first\\n> 1. second\", find('#issue_description').value\n67\t\n68\t      select_text 'issue_description', 0, 22\n69\t      find('button.jstb_unbq').click\n70\t      assert_equal \"1. first\\n1. second\", find('#issue_description').value\n71\t\n72\t      fill_in 'Description', :with => 'code'\n73\t      find('button.jstb_pre').click\n74\t      assert_equal \"```\\ncode\\n```\", find('#issue_description').value\n75\t    end\n76\t  end\n77\t\n78\t  def test_insert_table_using_common_mark\n79\t    with_settings :text_formatting => 'common_mark' do\n80\t      log_user('jsmith', 'jsmith')\n81\t      visit '/projects/ecookbook/issues/new'\n82\t\n83\t      find('button.jstb_table').click\n84\t      within 'div.jstBlock table.table-generator' do\n85\t        find('button[title=\"2×3\"]').hover\n86\t        assert_selector 'td.selected-cell', :count => 6\n87\t        find('button[title=\"2×3\"]').click\n88\t      end\n89\t      assert_no_selector 'table.table-generator'\n90\t      assert_equal \"|A |B |\\n|--|--|\\n|  |  |\\n|  |  |\\n|  |  |\\n\", find('#issue_description').value\n91\t    end\n92\t  end\n93\t\n94\t  def test_insert_table_using_textile\n95\t    with_settings :text_formatting => 'textile' do\n96\t      log_user('jsmith', 'jsmith')\n97\t      visit '/projects/ecookbook/issues/new'\n98\t\n99\t      find('button.jstb_table').click\n100\t      find('table.table-generator button[title=\"2×1\"]').click\n101\t      assert_equal \"|_.A|_.B|\\n|  |  |\\n\", find('#issue_description').value\n102\t    end\n103\t  end\n104\t\n105\t  def test_insert_highlighted_code\n106\t    with_settings :text_formatting => 'common_mark' do\n107\t      log_user('jsmith', 'jsmith')\n108\t      visit '/projects/ecookbook/issues/new'\n109\t\n110\t      fill_in 'Description', :with => 'puts 1'\n111\t      find('button.jstb_precode').click\n112\t      within('ul.jstMenu') {click_button 'ruby'}\n113\t      assert_no_selector 'ul.jstMenu'\n114\t      assert_equal \"``` ruby\\nputs 1\\n```\\n\", find('#issue_description').value\n115\t    end\n116\t  end\n117\t\n118\t  def test_menus_should_close_with_escape_outside_click_or_toggle\n119\t    log_user('jsmith', 'jsmith')\n120\t    visit '/projects/ecookbook/issues/new'\n121\t\n122\t    find('button.jstb_precode').click\n123\t    assert_selector 'ul.jstMenu button:focus'\n124\t    find('ul.jstMenu button', match: :first).send_keys(:escape)\n125\t    assert_no_selector 'ul.jstMenu'\n126\t\n127\t    find('button.jstb_table').click\n128\t    assert_selector 'table.table-generator'\n129\t    find('button.jstb_table').click\n130\t    assert_no_selector 'table.table-generator'\n131\t\n132\t    find('button.jstb_precode').click\n133\t    find('button.jstb_table').click\n134\t    assert_no_selector 'ul.jstMenu'\n135\t    assert_selector 'table.table-generator'\n136\t    find('#issue_subject').click\n137\t    assert_no_selector 'table.table-generator'\n138\t  end\n139\t\n140\t  def test_full_width_custom_field_should_have_toolbar\n141\t    field = IssueCustomField.create!(:name => 'Long text', :field_format => 'text', :full_width_layout => '1',\n142\t                                     :text_formatting => 'full', :is_for_all => true, :tracker_ids => [1])\n143\t    log_user('jsmith', 'jsmith')\n144\t    visit '/projects/ecookbook/issues/new'\n145\t\n146\t    assert_selector \"div.jstBlock div.jstEditor textarea#issue_custom_field_values_#{field.id}\"\n147\t    find(\"#issue_custom_field_values_#{field.id}\").click\n148\t    find(\"div.jstBlock:has(#issue_custom_field_values_#{field.id}) button.jstb_strong\").click\n149\t    assert_equal '****', find(\"#issue_custom_field_values_#{field.id}\").value\n150\t  end\n151\t\n152\t  def test_preview_should_send_attachments_and_toggle_toolbar\n153\t    log_user('jsmith', 'jsmith')\n154\t    visit '/projects/ecookbook/issues/new'\n155\t\n156\t    fill_in 'Description', :with => 'Preview *me*'\n157\t    click_link 'Preview'\n158\t    within 'div.jstBlock' do\n159\t      assert_selector 'div.wiki-preview', :visible => true, :text => 'Preview me'\n160\t      assert_selector 'div.jstElements', :visible => false\n161\t      assert_selector 'a.tab-preview.selected[aria-selected=true]'\n162\t    end\n163\t    click_link 'Edit'\n164\t    assert_selector 'div.jstElements', :visible => true\n165\t    assert_equal 'issue_description', page.evaluate_script('document.activeElement.id')\n166\t  end\n167\t\n168\t  private\n169\t\n170\t  def select_text(id, start, finish)\n171\t    page.execute_script(\"document.getElementById('#{id}').setSelectionRange(#{start}, #{finish})\")\n172\t  end\n173\tend\n174\t"}]},"parent_tool_use_id":null,"session_id":"a7c435fe-4f4a-423f-99e0-d9041f4d15f8","uuid":"a64791a3-974e-4e91-a801-cae290b07f89","timestamp":"2026-11-01T21:41:26.883Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/redmine/bench/trees/redmine-1-control/test/system/wiki_toolbar_test.rb","content":"# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n# This program is free software; you can redistribute it and/or\n# modify it under the terms of the GNU General Public License\n# as published by the Free Software Foundation; either version 2\n# of the License, or (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with this program; if not, write to the Free Software\n# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n\nrequire_relative '../application_system_test_case'\n\nclass WikiToolbarTest < ApplicationSystemTestCase\n  def test_toolbar_should_be_moved_before_the_textarea\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    within '#issue_description_and_toolbar' do\n      assert_selector 'div.jstBlock div.jstEditor textarea#issue_description'\n      assert_selector 'div.jstBlock div.jstTabs + div.jstEditor'\n    end\n  end\n\n  def test_wrap_selection_using_textile\n    with_settings :text_formatting => 'textile' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      fill_in 'Description', :with => 'Some text'\n      select_text 'issue_description', 5, 9\n      find('button.jstb_strong').click\n      assert_equal 'Some *text*', find('#issue_description').value\n\n      fill_in 'Description', :with => 'Some text'\n      select_text 'issue_description', 0, 4\n      find('button.jstb_link').click\n      assert_equal '[[Some]] text', find('#issue_description').value\n    end\n  end\n\n  def test_wrap_lines_using_common_mark\n    with_settings :text_formatting => 'common_mark' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      fill_in 'Description', :with => \"## Title\"\n      find('button.jstb_h1').click\n      assert_equal '# Title', find('#issue_description').value\n\n      fill_in 'Description', :with => \"first\\nsecond\"\n      select_text 'issue_description', 0, 12\n      find('button.jstb_ol').click\n      assert_equal \"1. first\\n1. second\", find('#issue_description').value\n\n      select_text 'issue_description', 0, 18\n      find('button.jstb_bq').click\n      assert_equal \"> 1. first\\n> 1. second\", find('#issue_description').value\n\n      select_text 'issue_description', 0, 22\n      find('button.jstb_unbq').click\n      assert_equal \"1. first\\n1. second\", find('#issue_description').value\n\n      fill_in 'Description', :with => 'code'\n      find('button.jstb_pre').click\n      assert_equal \"```\\ncode\\n```\", find('#issue_description').value\n    end\n  end\n\n  def test_insert_table_using_common_mark\n    with_settings :text_formatting => 'common_mark' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      find('button.jstb_table').click\n      within 'div.jstBlock table.table-generator' do\n        find('button[title=\"2×3\"]').hover\n        assert_selector 'td.selected-cell', :count => 6\n        find('button[title=\"2×3\"]').click\n      end\n      assert_no_selector 'table.table-generator'\n      assert_equal \"|A |B |\\n|--|--|\\n|  |  |\\n|  |  |\\n|  |  |\\n\", find('#issue_description').value\n    end\n  end\n\n  def test_insert_table_using_textile\n    with_settings :text_formatting => 'textile' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      find('button.jstb_table').click\n      find('table.table-generator button[title=\"2×1\"]').click\n      assert_equal \"|_.A|_.B|\\n|  |  |\\n\", find('#issue_description').value\n    end\n  end\n\n  def test_insert_highlighted_code\n    with_settings :text_formatting => 'common_mark' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      fill_in 'Description', :with => 'puts 1'\n      find('button.jstb_precode').click\n      within('ul.jstMenu') {click_button 'ruby'}\n      assert_no_selector 'ul.jstMenu'\n      assert_equal \"``` ruby\\nputs 1\\n```\\n\", find('#issue_description').value\n    end\n  end\n\n  def test_menus_should_close_with_escape_outside_click_or_toggle\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    find('button.jstb_precode').click\n    assert_selector 'ul.jstMenu button:focus'\n    find('ul.jstMenu button', match: :first).send_keys(:escape)\n    assert_no_selector 'ul.jstMenu'\n\n    find('button.jstb_table').click\n    assert_selector 'table.table-generator'\n    find('button.jstb_table').click\n    assert_no_selector 'table.table-generator'\n\n    find('button.jstb_precode').click\n    find('button.jstb_table').click\n    assert_no_selector 'ul.jstMenu'\n    assert_selector 'table.table-generator'\n    find('#issue_subject').click\n    assert_no_selector 'table.table-generator'\n  end\n\n  def test_full_width_custom_field_should_have_toolbar\n    field = IssueCustomField.create!(:name => 'Long text', :field_format => 'text', :full_width_layout => '1',\n                                     :text_formatting => 'full', :is_for_all => true, :tracker_ids => [1])\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    assert_selector \"div.jstBlock div.jstEditor textarea#issue_custom_field_values_#{field.id}\"\n    find(\"#issue_custom_field_values_#{field.id}\").click\n    find(\"div.jstBlock:has(#issue_custom_field_values_#{field.id}) button.jstb_strong\").click\n    assert_equal '****', find(\"#issue_custom_field_values_#{field.id}\").value\n  end\n\n  def test_preview_should_send_attachments_and_toggle_toolbar\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    fill_in 'Description', :with => 'Preview *me*'\n    click_link 'Preview'\n    within 'div.jstBlock' do\n      assert_selector 'div.wiki-preview', :visible => true, :text => 'Preview me'\n      assert_selector 'div.jstElements', :visible => false\n      assert_selector 'a.tab-preview.selected[aria-selected=true]'\n    end\n    click_link 'Edit'\n    assert_selector 'div.jstElements', :visible => true\n    assert_equal 'issue_description', page.evaluate_script('document.activeElement.id')\n  end\n\n  private\n\n  def select_text(id, start, finish)\n    page.execute_script(\"document.getElementById('#{id}').setSelectionRange(#{start}, #{finish})\")\n  end\nend\n","numLines":174,"startLine":1,"totalLines":174}},"tool_result_meta":[{"id":"toolu_01ARVqZABEU6MYjTyNHSgSA6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
