{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GZrDdDMwrs2YWbRrrWXvKg","type":"tool_result","content":"210\t  end\n211\t\n212\t  def test_macro_macro_list\n213\t    text = \"{{macro_list}}\"\n214\t    assert_match %r{<code>hello_world</code>}, textilizable(text)\n215\t  end\n216\t\n217\t  def test_macro_include\n218\t    @project = Project.find(1)\n219\t    # include a page of the current project wiki\n220\t    text = \"{{include(Another page)}}\"\n221\t    assert_include 'This is a link to a ticket', textilizable(text)\n222\t\n223\t    @project = nil\n224\t    # include a page of a specific project wiki\n225\t    text = \"{{include(ecookbook:Another page)}}\"\n226\t    assert_include 'This is a link to a ticket', textilizable(text)\n227\t\n228\t    text = \"{{include(ecookbook:)}}\"\n229\t    assert_include 'CookBook documentation', textilizable(text)\n230\t\n231\t    text = \"{{include(unknowidentifier:somepage)}}\"\n232\t    assert_include 'Page not found', textilizable(text)\n233\t  end\n234\t\n235\t  def test_include_macro_accepts_project_from_multiple_sources\n236\t    project = Project.find(1)\n237\t\n238\t    # Resolve using the @project\n239\t    @project = project\n240\t    assert_include 'This is a link to a ticket', textilizable('{{include(Another page)}}')\n241\t    @project = nil\n242\t\n243\t    # Resolve using object: project\n244\t    assert_include 'This is a link to a ticket', textilizable('{{include(Another page)}}', {object: project})\n245\t\n246\t    # Resolve using issue.project\n247\t    issue = Issue.first\n248\t    issue.update(description: '{{include(Another page)}}')\n249\t    assert_include 'This is a link to a ticket', textilizable(issue, :description)\n250\t  end\n251\t\n252\t  def test_macro_collapse\n253\t    text = \"{{collapse\\n*Collapsed* block of text\\n}}\"\n254\t    with_locale 'en' do\n255\t      with_settings :text_formatting => 'textile' do\n256\t        result = textilizable(text)\n257\t\n258\t        assert_select_in result, 'div.collapsed-text'\n259\t        assert_select_in result, 'strong', :text => 'Collapsed'\n260\t        assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Show'\n261\t        assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Hide'\n262\t      end\n263\t    end\n264\t  end\n265\t\n266\t  def test_macro_collapse_with_one_arg\n267\t    text = \"{{collapse(Example)\\n*Collapsed* block of text\\n}}\"\n268\t    with_settings :text_formatting => 'textile' do\n269\t      result = textilizable(text)\n270\t\n271\t      assert_select_in result, 'div.collapsed-text'\n272\t      assert_select_in result, 'strong', :text => 'Collapsed'\n273\t      assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Example'\n274\t      assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Example'\n275\t    end\n276\t  end\n277\t\n278\t  def test_macro_collapse_with_two_args\n279\t    text = \"{{collapse(Show example, Hide example)\\n*Collapsed* block of text\\n}}\"\n280\t    with_settings :text_formatting => 'textile' do\n281\t      result = textilizable(text)\n282\t\n283\t      assert_select_in result, 'div.collapsed-text'\n284\t      assert_select_in result, 'strong', :text => 'Collapsed'\n285\t      assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Show example'\n286\t      assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Hide example'\n287\t    end\n288\t  end\n289\t\n290\t  def test_macro_collapse_with_arg_contains_comma\n291\t    text = %|{{collapse(\"Click here, to see the example\", Hide example)\\n*Collapsed* block of text\\n}}|\n292\t    result = textilizable(text)\n293\t    assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Click here, to see the example'\n294\t    assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Hide example'\n295\t  end\n296\t\n297\t  def test_macro_collapse_should_not_break_toc\n298\t    set_language_if_valid 'en'\n299\t\n300\t    text = <<~RAW\n301\t      {{toc}}\n302\t\n303\t      h1. Title\n304\t\n305\t      {{collapse(Show example, Hide example)\n306\t      h2. Heading\n307\t      }}\"\n308\t    RAW\n309\t    expected_toc =\n310\t      '<ul class=\"toc\"><li><strong>Table of contents</strong></li>' \\\n311\t      '<li><a href=\"#Title\">Title</a><ul><li><a href=\"#Heading\">Heading</a></li></ul></li></ul>'\n312\t    with_settings :text_formatting => 'textile' do\n313\t      assert_include expected_toc, textilizable(text).gsub(/[\\r\\n]/, '')\n314\t    end\n315\t  end\n316\t\n317\t  def test_macro_child_pages\n318\t    expected =\n319\t      \"<p><ul class=\\\"pages-hierarchy\\\">\\n\" \\"}]},"parent_tool_use_id":null,"session_id":"42987106-6a82-40df-b16c-d561791e472c","uuid":"528886df-c86c-42fa-8dde-eb81a4696d82","timestamp":"2026-11-02T04:20:25.023Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/redmine/bench/trees/redmine-3-control/test/unit/lib/redmine/wiki_formatting/macros_test.rb","content":"  end\n\n  def test_macro_macro_list\n    text = \"{{macro_list}}\"\n    assert_match %r{<code>hello_world</code>}, textilizable(text)\n  end\n\n  def test_macro_include\n    @project = Project.find(1)\n    # include a page of the current project wiki\n    text = \"{{include(Another page)}}\"\n    assert_include 'This is a link to a ticket', textilizable(text)\n\n    @project = nil\n    # include a page of a specific project wiki\n    text = \"{{include(ecookbook:Another page)}}\"\n    assert_include 'This is a link to a ticket', textilizable(text)\n\n    text = \"{{include(ecookbook:)}}\"\n    assert_include 'CookBook documentation', textilizable(text)\n\n    text = \"{{include(unknowidentifier:somepage)}}\"\n    assert_include 'Page not found', textilizable(text)\n  end\n\n  def test_include_macro_accepts_project_from_multiple_sources\n    project = Project.find(1)\n\n    # Resolve using the @project\n    @project = project\n    assert_include 'This is a link to a ticket', textilizable('{{include(Another page)}}')\n    @project = nil\n\n    # Resolve using object: project\n    assert_include 'This is a link to a ticket', textilizable('{{include(Another page)}}', {object: project})\n\n    # Resolve using issue.project\n    issue = Issue.first\n    issue.update(description: '{{include(Another page)}}')\n    assert_include 'This is a link to a ticket', textilizable(issue, :description)\n  end\n\n  def test_macro_collapse\n    text = \"{{collapse\\n*Collapsed* block of text\\n}}\"\n    with_locale 'en' do\n      with_settings :text_formatting => 'textile' do\n        result = textilizable(text)\n\n        assert_select_in result, 'div.collapsed-text'\n        assert_select_in result, 'strong', :text => 'Collapsed'\n        assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Show'\n        assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Hide'\n      end\n    end\n  end\n\n  def test_macro_collapse_with_one_arg\n    text = \"{{collapse(Example)\\n*Collapsed* block of text\\n}}\"\n    with_settings :text_formatting => 'textile' do\n      result = textilizable(text)\n\n      assert_select_in result, 'div.collapsed-text'\n      assert_select_in result, 'strong', :text => 'Collapsed'\n      assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Example'\n      assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Example'\n    end\n  end\n\n  def test_macro_collapse_with_two_args\n    text = \"{{collapse(Show example, Hide example)\\n*Collapsed* block of text\\n}}\"\n    with_settings :text_formatting => 'textile' do\n      result = textilizable(text)\n\n      assert_select_in result, 'div.collapsed-text'\n      assert_select_in result, 'strong', :text => 'Collapsed'\n      assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Show example'\n      assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Hide example'\n    end\n  end\n\n  def test_macro_collapse_with_arg_contains_comma\n    text = %|{{collapse(\"Click here, to see the example\", Hide example)\\n*Collapsed* block of text\\n}}|\n    result = textilizable(text)\n    assert_select_in result, 'a.collapsible.icon-collapsed', :text => 'Click here, to see the example'\n    assert_select_in result, 'a.collapsible.icon-expanded', :text => 'Hide example'\n  end\n\n  def test_macro_collapse_should_not_break_toc\n    set_language_if_valid 'en'\n\n    text = <<~RAW\n      {{toc}}\n\n      h1. Title\n\n      {{collapse(Show example, Hide example)\n      h2. Heading\n      }}\"\n    RAW\n    expected_toc =\n      '<ul class=\"toc\"><li><strong>Table of contents</strong></li>' \\\n      '<li><a href=\"#Title\">Title</a><ul><li><a href=\"#Heading\">Heading</a></li></ul></li></ul>'\n    with_settings :text_formatting => 'textile' do\n      assert_include expected_toc, textilizable(text).gsub(/[\\r\\n]/, '')\n    end\n  end\n\n  def test_macro_child_pages\n    expected =\n      \"<p><ul class=\\\"pages-hierarchy\\\">\\n\" \\","numLines":110,"startLine":210,"totalLines":718}},"tool_result_meta":[{"id":"toolu_01GZrDdDMwrs2YWbRrrWXvKg","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
