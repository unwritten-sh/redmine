{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VpCXtNp5KDkgYz8AVKxVhG","type":"tool_result","content":"20\trequire_relative '../../../../test_helper'\n21\t\n22\tclass Redmine::WikiFormatting::MacrosTest < Redmine::HelperTest\n23\t  include ActionView::Helpers::TextHelper\n24\t  include ActionView::Helpers::SanitizeHelper\n25\t  include ERB::Util\n26\t  extend ActionView::Helpers::SanitizeHelper::ClassMethods\n27\t\n28\t  def setup\n29\t    super\n30\t    @project = nil\n31\t  end\n32\t\n33\t  def teardown\n34\t  end\n35\t\n36\t  def test_macro_registration\n37\t    Redmine::WikiFormatting::Macros.register do\n38\t      macro :foo do |obj, args|\n39\t        \"Foo: #{args.size} (#{args.join(',')}) (#{args.class.name})\"\n40\t      end\n41\t    end\n42\t\n43\t    with_settings :text_formatting => 'textile' do\n44\t      assert_equal '<p>Foo: 0 () (Array)</p>', textilizable('{{foo}}')\n45\t      assert_equal '<p>Foo: 0 () (Array)</p>', textilizable('{{foo()}}')\n46\t      assert_equal '<p>Foo: 1 (arg1) (Array)</p>', textilizable('{{foo(arg1)}}')\n47\t      assert_equal '<p>Foo: 2 (arg1,arg2) (Array)</p>', textilizable('{{foo(arg1, arg2)}}')\n48\t    end\n49\t  end\n50\t\n51\t  def test_macro_registration_parse_args_set_to_false_should_disable_arguments_parsing\n52\t    Redmine::WikiFormatting::Macros.register do\n53\t      macro :bar, :parse_args => false do |obj, args|\n54\t        \"Bar: (#{args}) (#{args.class.name})\"\n55\t      end\n56\t    end\n57\t\n58\t    with_settings :text_formatting => 'textile' do\n59\t      assert_equal '<p>Bar: (args, more args) (String)</p>', textilizable('{{bar(args, more args)}}')\n60\t      assert_equal '<p>Bar: () (String)</p>', textilizable('{{bar}}')\n61\t      assert_equal '<p>Bar: () (String)</p>', textilizable('{{bar()}}')\n62\t    end\n63\t  end\n64\t\n65\t  def test_macro_registration_with_3_args_should_receive_text_argument\n66\t    Redmine::WikiFormatting::Macros.register do\n67\t      macro :baz do |obj, args, text|\n68\t        \"Baz: (#{args.join(',')}) (#{text.class.name}) (#{text})\"\n69\t      end\n70\t    end\n71\t\n72\t    with_settings :text_formatting => 'textile' do\n73\t      assert_equal '<p>Baz: () (NilClass) ()</p>', textilizable('{{baz}}')\n74\t      assert_equal '<p>Baz: () (NilClass) ()</p>', textilizable('{{baz()}}')\n75\t      assert_equal \"<p>Baz: () (String) (line1\\nline2)</p>\", textilizable(\"{{baz()\\nline1\\nline2\\n}}\")\n76\t      assert_equal \"<p>Baz: (arg1,arg2) (String) (line1\\nline2)</p>\", textilizable(\"{{baz(arg1, arg2)\\nline1\\nline2\\n}}\")\n77\t    end\n78\t  end\n79\t\n80\t  def test_macro_name_with_upper_case\n81\t    with_settings :text_formatting => 'textile' do\n82\t      Redmine::WikiFormatting::Macros.macro(:UpperCase) {|obj, args| 'Upper'}\n83\t      assert_equal '<p>Upper</p>', textilizable('{{UpperCase}}')\n84\t    end\n85\t  end\n86\t\n87\t  def test_multiple_macros_on_the_same_line\n88\t    Redmine::WikiFormatting::Macros.macro :foo do |obj, args|\n89\t      args.any? ? \"args: #{args.join(',')}\" : \"no args\"\n90\t    end\n91\t\n92\t    with_settings :text_formatting => 'textile' do\n93\t      assert_equal '<p>no args no args</p>', textilizable('{{foo}} {{foo}}')\n94\t      assert_equal '<p>args: a,b no args</p>', textilizable('{{foo(a,b)}} {{foo}}')\n95\t      assert_equal '<p>args: a,b args: c,d</p>', textilizable('{{foo(a,b)}} {{foo(c,d)}}')\n96\t      assert_equal '<p>no args args: c,d</p>', textilizable('{{foo}} {{foo(c,d)}}')\n97\t    end\n98\t  end\n99\t\n100\t  def test_macro_should_receive_the_object_as_argument_when_with_object_and_attribute\n101\t    issue = Issue.find(1)\n102\t    issue.description = \"{{hello_world}}\"\n103\t    with_settings :text_formatting => 'textile' do\n104\t      assert_equal(\n105\t        '<p>Hello world! Object: Issue, Called with no argument and no block of text.</p>',\n106\t        textilizable(issue, :description)\n107\t      )\n108\t    end\n109\t  end\n110\t\n111\t  def test_macro_should_receive_the_object_as_argument_when_called_with_object_option\n112\t    with_settings :text_formatting => 'textile' do\n113\t      text = '{{hello_world}}'\n114\t      assert_equal(\n115\t        '<p>Hello world! Object: Issue, Called with no argument and no block of text.</p>',\n116\t        textilizable(text, :object => Issue.find(1))\n117\t      )\n118\t    end\n119\t  end\n120\t\n121\t  def test_extract_macro_options_should_with_args\n122\t    options = extract_macro_options([\"arg1\", \"arg2\"], :foo, :size)\n123\t    assert_equal([[\"arg1\", \"arg2\"], {}], options)\n124\t  end\n125\t\n126\t  def test_extract_macro_options_should_with_options\n127\t    options = extract_macro_options([\"foo=bar\", \"size=2\"], :foo, :size)\n128\t    assert_equal([[], {:foo => \"bar\", :size => \"2\"}], options)\n129\t  end"}]},"parent_tool_use_id":null,"session_id":"42987106-6a82-40df-b16c-d561791e472c","uuid":"23753909-b750-4701-973e-e94bfafa242e","timestamp":"2026-11-02T04:20:24.055Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/redmine/bench/trees/redmine-3-control/test/unit/lib/redmine/wiki_formatting/macros_test.rb","content":"require_relative '../../../../test_helper'\n\nclass Redmine::WikiFormatting::MacrosTest < Redmine::HelperTest\n  include ActionView::Helpers::TextHelper\n  include ActionView::Helpers::SanitizeHelper\n  include ERB::Util\n  extend ActionView::Helpers::SanitizeHelper::ClassMethods\n\n  def setup\n    super\n    @project = nil\n  end\n\n  def teardown\n  end\n\n  def test_macro_registration\n    Redmine::WikiFormatting::Macros.register do\n      macro :foo do |obj, args|\n        \"Foo: #{args.size} (#{args.join(',')}) (#{args.class.name})\"\n      end\n    end\n\n    with_settings :text_formatting => 'textile' do\n      assert_equal '<p>Foo: 0 () (Array)</p>', textilizable('{{foo}}')\n      assert_equal '<p>Foo: 0 () (Array)</p>', textilizable('{{foo()}}')\n      assert_equal '<p>Foo: 1 (arg1) (Array)</p>', textilizable('{{foo(arg1)}}')\n      assert_equal '<p>Foo: 2 (arg1,arg2) (Array)</p>', textilizable('{{foo(arg1, arg2)}}')\n    end\n  end\n\n  def test_macro_registration_parse_args_set_to_false_should_disable_arguments_parsing\n    Redmine::WikiFormatting::Macros.register do\n      macro :bar, :parse_args => false do |obj, args|\n        \"Bar: (#{args}) (#{args.class.name})\"\n      end\n    end\n\n    with_settings :text_formatting => 'textile' do\n      assert_equal '<p>Bar: (args, more args) (String)</p>', textilizable('{{bar(args, more args)}}')\n      assert_equal '<p>Bar: () (String)</p>', textilizable('{{bar}}')\n      assert_equal '<p>Bar: () (String)</p>', textilizable('{{bar()}}')\n    end\n  end\n\n  def test_macro_registration_with_3_args_should_receive_text_argument\n    Redmine::WikiFormatting::Macros.register do\n      macro :baz do |obj, args, text|\n        \"Baz: (#{args.join(',')}) (#{text.class.name}) (#{text})\"\n      end\n    end\n\n    with_settings :text_formatting => 'textile' do\n      assert_equal '<p>Baz: () (NilClass) ()</p>', textilizable('{{baz}}')\n      assert_equal '<p>Baz: () (NilClass) ()</p>', textilizable('{{baz()}}')\n      assert_equal \"<p>Baz: () (String) (line1\\nline2)</p>\", textilizable(\"{{baz()\\nline1\\nline2\\n}}\")\n      assert_equal \"<p>Baz: (arg1,arg2) (String) (line1\\nline2)</p>\", textilizable(\"{{baz(arg1, arg2)\\nline1\\nline2\\n}}\")\n    end\n  end\n\n  def test_macro_name_with_upper_case\n    with_settings :text_formatting => 'textile' do\n      Redmine::WikiFormatting::Macros.macro(:UpperCase) {|obj, args| 'Upper'}\n      assert_equal '<p>Upper</p>', textilizable('{{UpperCase}}')\n    end\n  end\n\n  def test_multiple_macros_on_the_same_line\n    Redmine::WikiFormatting::Macros.macro :foo do |obj, args|\n      args.any? ? \"args: #{args.join(',')}\" : \"no args\"\n    end\n\n    with_settings :text_formatting => 'textile' do\n      assert_equal '<p>no args no args</p>', textilizable('{{foo}} {{foo}}')\n      assert_equal '<p>args: a,b no args</p>', textilizable('{{foo(a,b)}} {{foo}}')\n      assert_equal '<p>args: a,b args: c,d</p>', textilizable('{{foo(a,b)}} {{foo(c,d)}}')\n      assert_equal '<p>no args args: c,d</p>', textilizable('{{foo}} {{foo(c,d)}}')\n    end\n  end\n\n  def test_macro_should_receive_the_object_as_argument_when_with_object_and_attribute\n    issue = Issue.find(1)\n    issue.description = \"{{hello_world}}\"\n    with_settings :text_formatting => 'textile' do\n      assert_equal(\n        '<p>Hello world! Object: Issue, Called with no argument and no block of text.</p>',\n        textilizable(issue, :description)\n      )\n    end\n  end\n\n  def test_macro_should_receive_the_object_as_argument_when_called_with_object_option\n    with_settings :text_formatting => 'textile' do\n      text = '{{hello_world}}'\n      assert_equal(\n        '<p>Hello world! Object: Issue, Called with no argument and no block of text.</p>',\n        textilizable(text, :object => Issue.find(1))\n      )\n    end\n  end\n\n  def test_extract_macro_options_should_with_args\n    options = extract_macro_options([\"arg1\", \"arg2\"], :foo, :size)\n    assert_equal([[\"arg1\", \"arg2\"], {}], options)\n  end\n\n  def test_extract_macro_options_should_with_options\n    options = extract_macro_options([\"foo=bar\", \"size=2\"], :foo, :size)\n    assert_equal([[], {:foo => \"bar\", :size => \"2\"}], options)\n  end","numLines":110,"startLine":20,"totalLines":718}},"tool_result_meta":[{"id":"toolu_01VpCXtNp5KDkgYz8AVKxVhG","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
