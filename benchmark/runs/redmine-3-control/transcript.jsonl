dup","numLines":22,"startLine":960,"totalLines":1999}},"tool_result_meta":[{"id":"toolu_016CJQsWg11gJEgiUuZ9i8B5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
