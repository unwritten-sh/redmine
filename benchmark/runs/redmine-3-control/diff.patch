+  def test_section_edit_links_with_include_macro
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'common_mark' do
+      included = WikiPage.new(:wiki => @project.wiki, :title => 'Included_with_headings')
+      included.content = WikiContent.new(:text => "## Included A\n\ntext\n\n## Included B\n", :author => User.find(1))
+      included.save!
+
+      raw = <<~RAW
+        # Wiki
+
+        ## Section A
+
+        {{include(Included_with_headings)}}
+
+        ## Section B
+      RAW
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      # Only the local headings get section edit links
+      assert_select_in result, 'div.contextual[id^=section-]', 2
+      assert_select_in result, 'div#section-2 + a[name=Section-A]'
+      assert_select_in result, 'div#section-2 a[href=?]', '/projects/1/wiki/Test/edit?section=2'
+      assert_select_in result, 'div#section-3 + a[name=Section-B]'
+      assert_select_in result, 'div#section-3 a[href=?]', '/projects/1/wiki/Test/edit?section=3'
+      # Included headings are still rendered with anchors
+      assert_include '<a name="Included-A"></a><h2 >', result
+      assert_include '<a name="Included-B"></a><h2 >', result
+      # Markers are removed from the output
+      assert_not_include 'redmine-macro-no-sections', result
+
+      # Section numbers match the numbers used when editing the page
+      formatter = Redmine::WikiFormatting.formatter.new(raw)
+      assert_match /\A## Section A/, formatter.get_section(2).first
+      assert_equal '## Section B', formatter.get_section(3).first
+    end
+  end
+
+  def test_section_edit_links_with_include_macro_inside_collapse_macro
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'common_mark' do
+      included = WikiPage.new(:wiki => @project.wiki, :title => 'Included_with_headings')
+      included.content = WikiContent.new(:text => "## Included A\n", :author => User.find(1))
+      included.save!
+
+      raw = <<~RAW
+        # Wiki
+
+        {{collapse
+        ## Section A
+
+        {{include(Included_with_headings)}}
+        }}
+
+        ## Section B
+      RAW
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      assert_select_in result, 'div.contextual[id^=section-]', 2
+      assert_select_in result, 'div#section-2 + a[name=Section-A]'
+      assert_select_in result, 'div#section-3 + a[name=Section-B]'
+      assert_include '<a name="Included-A"></a><h2 >', result
+      assert_not_include 'redmine-macro-no-sections', result
+    end
+  end
+
+  def test_section_edit_links_with_macro_declaring_sections
+    Redmine::WikiFormatting::Macros.register do
+      macro :heading_with_sections, :sections => true do |obj, args|
+        content_tag('h2', 'Macro heading')
+      end
+      macro :heading_without_sections do |obj, args|
+        content_tag('h2', 'Other heading')
+      end
+    end
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'common_mark' do
+      raw = "# Wiki\n\n{{heading_without_sections}}\n\n{{heading_with_sections}}\n\n## Section\n"
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      assert_select_in result, 'div.contextual[id^=section-]', 2
+      assert_select_in result, 'div#section-2 + a[name=Macro-heading]'
+      assert_select_in result, 'div#section-3 + a[name=Section]'
+      assert_include '<a name="Other-heading"></a><h2 >', result
+    end
+  ensure
+    Redmine::WikiFormatting::Macros.available_macros.delete(:heading_with_sections)
+    Redmine::WikiFormatting::Macros.available_macros.delete(:heading_without_sections)
+  end
+
