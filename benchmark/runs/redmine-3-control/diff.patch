+  def test_macro_registration_with_sections_option
+    Redmine::WikiFormatting::Macros.register do
+      macro :with_sections, :sections => true do |obj, args|
+        ''
+      end
+      macro :without_sections do |obj, args|
+        ''
+      end
+    end
+
+    assert macro_sections?('with_sections')
+    assert_not macro_sections?('without_sections')
+    assert macro_sections?('collapse')
+    assert_not macro_sections?('include')
+    assert_not macro_sections?('unknown_macro')
+  ensure
+    Redmine::WikiFormatting::Macros.available_macros.delete(:with_sections)
+    Redmine::WikiFormatting::Macros.available_macros.delete(:without_sections)
+  end
