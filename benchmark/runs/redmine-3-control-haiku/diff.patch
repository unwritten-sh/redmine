diff --git a/test/helpers/application_helper_test.rb b/test/helpers/application_helper_test.rb
index 446c5f39a..334626db5 100644
--- a/test/helpers/application_helper_test.rb
+++ b/test/helpers/application_helper_test.rb
@@ -1685,6 +1685,90 @@ class ApplicationHelperTest < Redmine::HelperTest
     end
   end
 
+  def test_section_edit_links_should_ignore_headings_of_included_page
+    raw = <<~RAW
+      h2. Local A
+
+      {{include(Child_1)}}
+
+      h2. Local B
+
+      h2. Local C
+    RAW
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'textile' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      # the included heading is rendered normally, without edit link
+      assert_include '<a name="Child-page-1"></a><h1 >Child page 1', result
+      assert_select_in result, 'div.contextual', 2
+      assert_select_in result, 'div#section-2 a[href="/projects/1/wiki/Test/edit?section=2"]'
+      assert_select_in result, 'div#section-3 a[href="/projects/1/wiki/Test/edit?section=3"]'
+    end
+  end
+
+  def test_section_edit_links_should_ignore_headings_of_included_page_inside_collapse_macro
+    raw = <<~RAW
+      h2. Section A
+
+      {{collapse(View details...)
+      h2. Section B
+
+      {{include(Child_1)}}
+      }}
+
+      h2. Section C
+    RAW
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'textile' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      assert_include '<a name="Child-page-1"></a><h1 >Child page 1', result
+      assert_select_in result, 'div.contextual', 2
+      assert_select_in result, 'div#section-2 a[href="/projects/1/wiki/Test/edit?section=2"]'
+      assert_select_in result, 'div#section-3 a[href="/projects/1/wiki/Test/edit?section=3"]'
+    end
+  end
+
+  def test_section_edit_links_with_macro_declaring_sections_option
+    Redmine::WikiFormatting::Macros.register do
+      macro :section_declaring_macro, :sections => true do |obj, args|
+        '<h2>Macro heading</h2>'.html_safe
+      end
+    end
+    Redmine::WikiFormatting::Macros.register do
+      macro :section_ignoring_macro do |obj, args|
+        '<h2>Macro heading</h2>'.html_safe
+      end
+    end
+    edit_options = {:edit_section_links => {:controller => 'wiki', :action => 'edit', :project_id => '1', :id => 'Test'}}
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'textile' do
+      result = textilizable("h2. Local A\n\n{{section_declaring_macro}}\n\nh2. Local B", edit_options).delete("\n")
+      assert_select_in result, 'div.contextual', 2
+      assert_select_in result, 'div#section-2 a[href="/projects/1/wiki/Test/edit?section=2"]'
+      assert_select_in result, 'div#section-3 a[href="/projects/1/wiki/Test/edit?section=3"]'
+
+      result = textilizable("h2. Local A\n\n{{section_ignoring_macro}}\n\nh2. Local B", edit_options).delete("\n")
+      assert_select_in result, 'div.contextual', 1
+      assert_select_in result, 'div#section-2 a[href="/projects/1/wiki/Test/edit?section=2"]'
+    end
+  end
+
