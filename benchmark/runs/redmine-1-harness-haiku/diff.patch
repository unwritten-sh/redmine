+  private
+
+  def assert_toolbar_without_syntax(format)
+    html = wikitoolbar_for('issue_description')
+
+    assert_select_in html, 'div.jstBlock[data-wiki-toolbar-format-value=?]', format
+    assert_select_in html, 'div.jstElements button[data-action]' do
+      # The syntax is defined by the controller, the markup only has the button names
+      assert_select '[data-wiki-toolbar-prefix-param], [data-wiki-toolbar-suffix-param]', 0
+      assert_select '[data-wiki-toolbar-strip-param], [data-wiki-toolbar-pattern-param], [data-wiki-toolbar-replacement-param]', 0
+      assert_select '[data-wiki-toolbar-header-cell-param], [data-wiki-toolbar-separator-cell-param]', 0
+    end
+  end
+
+  def assert_shortcut_attributes
+    html = wikitoolbar_for('issue_description')
+
+    assert_select_in html, 'div.jstElements' do
+      assert_select 'button[data-wiki-toolbar-shortcut]', 3
+      assert_select 'button.jstb_strong[data-wiki-toolbar-shortcut=b]'
+      assert_select 'button.jstb_em[data-wiki-toolbar-shortcut=i]'
+      assert_select 'button.jstb_ins[data-wiki-toolbar-shortcut=u]'
+    end
+  end
