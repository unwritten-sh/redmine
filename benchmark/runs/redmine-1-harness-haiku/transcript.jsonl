...transform }) => ({ type: 'lines', prefix, suffix, ...transform })\n\nconst FORMATS = {\n  common_mark: {\n    buttons: {\n      strong: wrap('**'),\n      em: wrap('*'),\n      ins: wrap('<u>', '</u>'),\n      del: wrap('~~'),\n      code: wrap('`'),\n      h1: lines({ prefix: '# ', strip: '^#+\\\\\\\\s+' }),\n      h2: lines({ prefix: '## ', strip: '^#+\\\\\\\\s+' }),\n      h3: lines({ prefix: '### ', strip: '^#+\\\\\\\\s+' }),\n      ul: lines({ pattern: '[#-]?\\\\\\\\s*', replacement: '* ' }),\n      ol: lines({ pattern: '[*-]?\\\\\\\\s*', replacement: '1. ' }),\n      tl: lines({ pattern: '[*-]?\\\\\\\\s*', replacement: '* [ ] ' }),\n      bq: lines({ pattern: '( *)([^\\\\\\\\n]*)', replacement: '> $2$3' }),\n      unbq: lines({ pattern: ' *(> ?)?( *)([^\\\\\\\\n]*)', replacement: '$3$4' }),\n      pre: lines({ prefix: '```\\\\n', suffix: '\\\\n```' }),\n      link: wrap('[[', ']]'),\n      img: wrap('![](', ')')\n    },\n    table: {\n      headerCell: (name) => `${name} `,\n      separatorCell: '--'\n    },\n    precode: {\n      prefix: (lang) => `\\\\`\\\\`\\\\` ${lang}\\\\n`,\n      suffix: '\\\\n```\\\\n'\n    }\n  },\n  textile: {\n    buttons: {\n      strong: wrap('*'),\n      em: wrap('_'),\n      ins: wrap('+'),\n      del: wrap('-'),\n      code: wrap('@'),\n      h1: lines({ prefix: 'h1. ', strip: '^h\\\\\\\\d+\\\\\\\\.\\\\\\\\s+' }),\n      h2: lines({ prefix: 'h2. ', strip: '^h\\\\\\\\d+\\\\\\\\.\\\\\\\\s+' }),\n      h3: lines({ prefix: 'h3. ', strip: '^h\\\\\\\\d+\\\\\\\\.\\\\\\\\s+' }),\n      ul: lines({ pattern: '[#-]?\\\\\\\\s*', replacement: '* ' }),\n      ol: lines({ pattern: '[*-]?\\\\\\\\s*', replacement: '# ' }),\n      bq: lines({ pattern: '( *)([^\\\\\\\\n]*)', replacement: '> $2$3' }),\n      unbq: lines({ pattern: ' *(> ?)?( *)([^\\\\\\\\n]*)', replacement: '$3$4' }),\n      pre: lines({ prefix: '<pre>\\\\n', suffix: '\\\\n</pre>' }),\n      link: wrap('[[', ']]'),\n      img: wrap('!')\n    },\n    table: {\n      headerCell: 