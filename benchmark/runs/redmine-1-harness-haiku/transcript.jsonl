o every keydown of the toolbar, so the modifiers must match exactly\n  shortcut(event) {\n    const modifier = isMac ? event.metaKey && !event.ctrlKey : event.ctrlKey && !event.metaKey\n    if (event.target !== this.field || !modifier || event.shiftKey || event.altKey) return\n\n    const key = event.key.toLowerCase()\n    const button = Array.from(this.toolbarTarget.querySelectorAll('[data-wiki-toolbar-shortcut]'))\n      .find((element) => element.dataset.wikiToolbarShortcut === key)\n    if (button) {\"\"\")\n\nrep(\"\"\"  toggleMenu({ currentTarget, params }) {\n    const opened = this.menu?.dataset.name === params.menu\n    this.closeMenu()\n    if (opened) return\n\n    const template = this[`${params.menu}MenuTarget`]\n    this.menu = template.content.firstElementChild.cloneNode(true)\n    this.menu.dataset.name = params.menu\n    this.menuParams = params\n    this.element.append(this.menu)\"\"\",\"\"\"  toggleMenu({ currentTarget, params }) {\n    const opened = this.menu?.dataset.name === params.menu\n    this.closeMenu()\n    if (opened) return\n\n    const template = this[`${params.menu}MenuTarget`]\n    this.menu = template.content.firstElementChild.cloneNode(true)\n    this.menu.dataset.name = params.menu\n    this.element.append(this.menu)\"\"\")\n\nrep(\"\"\"  insertTable({ params: { cols, rows } }) {\n    const { headerCell, separatorCell } = this.menuParams\n    const names = 'ABCDEFGHIJ'.slice(0, cols).split('')\n    const line = (cells) => `|${cells.join('|')}|\\\\n`\n\n    let table = line(names.map((name) => String(headerCell).replace('%{name}', name)))\"\"\",\"\"\"  insertTable({ params: { cols, rows } }) {\n    const { headerCell, separatorCell } = this.syntax.table\n    const names = 'ABCDEFGHIJ'.slice(0, cols).split('')\n    const line = (cells) => `|${cells.join('|')}|\\\\n`\n\n    let table = line(names.map((name) => headerCell(name)))\"\"\")\n\nopen(path,'w').write(src)\nPYEOF\necho done","description":"Rewrite Stimulus controller with pe