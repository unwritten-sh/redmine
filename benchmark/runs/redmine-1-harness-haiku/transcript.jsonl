r-button-param=strong]', 'wiki-toolbar#apply'\n        assert_select 'button.jstb_ol[data-wiki-toolbar-button-param=ol]'\n        assert_select 'button.jstb_table[data-wiki-toolbar-menu-param=table]'\n      end\n    end\n  end\n\n  def test_toolbar_should_only_give_the_format_and_the_buttons_names\n    %w[common_mark textile].each do |format|\n      with_settings :text_formatting => format do\n        html = wikitoolbar_for('issue_description')\n\n        assert_select_in html, 'div.jstBlock[data-wiki-toolbar-format-value=?]', format\n        assert_select_in html, 'div.jstElements button[data-action]' do\n          # No syntax in the markup, the controller defines what each button inserts\n          assert_select '[data-wiki-toolbar-prefix-param], [data-wiki-toolbar-suffix-param]', 0\n          assert_select '[data-wiki-toolbar-strip-param], [data-wiki-toolbar-pattern-param], [data-wiki-toolbar-replacement-param]', 0\n          assert_select '[data-wiki-toolbar-header-cell-param], [data-wiki-toolbar-separator-cell-param]', 0\n        end\n      end\n    end\n  end\n\n  def test_keyboard_shortcut_attributes_should_only_be_on_strong_em_and_ins\n    %w[common_mark textile].each do |format|\n      with_settings :text_formatting => format do\n        html = wikitoolbar_for('issue_description')\n\n        assert_select_in html, 'div.jstElements' do\n          assert_select 'button[data-wiki-toolbar-shortcut]', 3\n          assert_select 'button.jstb_strong[data-wiki-toolbar-shortcut=b]'\n          assert_select 'button.jstb_em[data-wiki-toolbar-shortcut=i]'\n          assert_select 'button.jstb_ins[data-wiki-toolbar-shortcut=u]'\n        end\n      end\n    end\n  end\n\n'''\nsrc=src[:start]+new_buttons+src[end:]\n\nstart=src.index('  def test_keyboard_shortcuts')\nend=src.index('  def test_table_menu')\nnew_kb='''  def test_keyboard_shortcuts\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n      actions = Nokogiri::HTML.fragment(html).at_css('div.jstBlock')['data-action'].split\n\n      assert_equal [\n        'keydown->wiki-toolbar#shortcut',\n        'keydown.ctrl+shift+p@window->wiki-toolbar#togglePreview',\n        'keydown.meta+shift+p@window->wiki-toolbar#togglePreview'\n      ], actions\n    end\n  end\n\n  def test_precode_menu_should_list_the_user_languages\n    User.current = User.find(2)\n    User.current.pref.update!(:toolbar_language_options => 'ruby,python')\n\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=precodeMenu] ul.jstMenu[role=menu]' do\n        assert_select 'button[role=menuitem][data-action=?][data-wiki-toolbar-lang-param]', 'wiki-toolbar#insertPrecode', :count => 2\n      end\n      item = Nokogiri::HTML.fragment(html).at_css('ul.jstMenu button')\n      assert_equal 'ruby', item.text\n      assert_equal 'ruby', item['data-wiki-toolbar-lang-param']\n      assert_nil item['data-wiki-toolbar-prefix-param']\n    end\n  end\n\n'''\nsrc=src[:start]+new_kb+src[end:]\nopen(path,'w').write(src)\n\n# layout test: precode languages now come as a lang param\nlp='test/integration/layout_test.rb'\ns=open(lp).read()\nold=\"assert_select 'template[data-wiki-toolbar-target=precodeMenu]', :html => /data-wiki-toolbar-prefix-param=\\\"``` #{lang}/\"\nassert s.count(old)==1\ns=s.replace(old,\"assert_select 'template[data-wiki-toolbar-target=precodeMenu]', :html => /data-wiki-toolbar-lang-param=\\\"#{lang}\\\"/\")\nopen(lp,'w').write(s)\nPYEOF\ngrep -n \"def test_\" test/unit/lib/redmine/wiki_toolbar_test.rb","description":"Update unit and integration tests to the new markup contract"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1648,"cache_read_input_tokens":95803,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input