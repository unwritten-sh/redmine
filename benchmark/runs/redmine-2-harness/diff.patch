--- a/app/models/query.rb
+++ b/app/models/query.rb
@@ -493,6 +493,28 @@ class Query < ApplicationRecord
     end
   end
 
+  # Operators that split the filter value into search terms
+  TOKENIZED_OPERATORS = %w(~ *~ !~ ^ $).freeze
+
+  # Returns a list of warning messages for the filters of the query.
+  # Warnings do not make the query invalid.
+  def filter_warnings
+    warnings = []
+    (filters || {}).each_key do |field|
+      next unless [:string, :text, :search].include?(type_for(field))
+      next unless TOKENIZED_OPERATORS.include?(operator_for(field))
+
+      tokenizer = Redmine::Search::Tokenizer.new(value_for(field))
+      next unless tokenizer.truncated?
+
+      terms = tokenizer.tokens.map {|t| "\"#{t}\""}.join(::I18n.t('support.array.words_connector'))
+      warnings << "#{label_for(field)}: " +
+        l(:warning_query_filter_max_search_terms,
+          :count => Redmine::Search::Tokenizer::MAX_TOKENS, :terms => terms)
+    end
+    warnings
+  end
+
   def validate_query_filters
