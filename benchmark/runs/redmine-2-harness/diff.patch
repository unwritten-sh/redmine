diff --git a/test/unit/lib/redmine/search_test.rb b/test/unit/lib/redmine/search_test.rb
index e2d77cca0..6c4e446c9 100644
--- a/test/unit/lib/redmine/search_test.rb
+++ b/test/unit/lib/redmine/search_test.rb
@@ -35,4 +35,23 @@ class Redmine::Search::Tokenize < ActiveSupport::TestCase
     value = '"phrase one" "phrase two"'
     assert_equal ["phrase one", "phrase two"], Redmine::Search::Tokenizer.new(value).tokens
   end
+
+  def test_tokenize_should_return_at_most_max_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five six seven')
+    assert_equal 5, Redmine::Search::Tokenizer::MAX_TOKENS
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert tokenizer.truncated?
+  end
+
+  def test_tokenize_should_not_be_truncated_with_max_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five')
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert_not tokenizer.truncated?
+  end
+
+  def test_tokenize_truncated_should_ignore_duplicate_and_short_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five one a b')
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert_not tokenizer.truncated?
+  end
 end
