+
+  def test_filter_warnings_should_warn_about_truncated_search_terms
+    User.current = User.find(1)
+    query = IssueQuery.new(
+      :name => '_',
+      :filters => {
+        'subject' => {:operator => '*~', :values => ['one two three four five six']}
+      }
+    )
+    assert query.valid?
+    assert_equal [
+      'Subject: A maximum of 5 search terms can be used. ' \
+        'Only the following terms were used: "one", "two", "three", "four", "five"'
+    ], query.filter_warnings
+    assert_nothing_raised { find_issues_with_query(query) }
+  end
+
+  def test_filter_warnings_for_tokenized_operators
+    User.current = User.find(1)
+    %w(~ *~ !~ ^ $).each do |operator|
+      query = IssueQuery.new(
+        :name => '_',
+        :filters => {'subject' => {:operator => operator, :values => ['a1 a2 a3 a4 a5 a6']}}
+      )
+      assert_equal 1, query.filter_warnings.size, "operator #{operator}"
+    end
+    %w(= !).each do |operator|
+      query = IssueQuery.new(
+        :name => '_',
+        :filters => {'subject' => {:operator => operator, :values => ['a1 a2 a3 a4 a5 a6']}}
+      )
+      assert_equal [], query.filter_warnings, "operator #{operator}"
+    end
+  end
+
+  def test_filter_warnings_for_search_filter
+    User.current = User.find(1)
+    query = IssueQuery.new(
+      :name => '_',
+      :filters => {'any_searchable' => {:operator => '~', :values => ['a1 a2 a3 a4 a5 a6']}}
+    )
+    assert_equal 1, query.filter_warnings.size
+  end
+
+  def test_filter_warnings_should_be_empty_without_truncation
+    User.current = User.find(1)
+    query = IssueQuery.new(
+      :name => '_',
+      :filters => {'subject' => {:operator => '~', :values => ['one two three four five']}}
+    )
+    assert_equal [], query.filter_warnings
+  end
