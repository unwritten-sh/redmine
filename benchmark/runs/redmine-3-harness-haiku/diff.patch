+  def test_section_edit_links_should_skip_headings_from_included_page
+    raw = <<~RAW
+      h1. Wiki
+
+      {{include(Child_1)}}
+
+      h2. Local section
+    RAW
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'textile' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      # the included heading is rendered normally
+      assert_include 'Child page 1', result
+      # only the local headings get edit links, the included heading does not
+      # the local heading after the include is section 2, not 3
+      assert_equal ['2'], result.scan(/edit\?section=(\d+)/).flatten
+      assert_equal ['2'], result.scan(/id="section-(\d+)"/).flatten
+      assert_match(
+        Regexp.new(
+          '<div class="contextual heading-2" title="Edit this section" id="section-2">' \
+          '<a class="icon-only icon-edit" href="/projects/1/wiki/Test/edit\?section=2">.*?</div>' \
+          '<a name="Local-section"></a>'
+        ),
+        result
+      )
+    end
+  end
+
+  def test_section_edit_links_should_skip_headings_from_include_nested_in_collapse
+    raw = <<~RAW
+      h1. Wiki
+
+      {{collapse(Details)
+      {{include(Child_1)}}
+      }}
+
+      h2. Section after collapse
+    RAW
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'textile' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      assert_include 'Child page 1', result
+      # the included heading inside collapse is not a section: the heading after collapse is section 2
+      assert_equal ['2'], result.scan(/edit\?section=(\d+)/).flatten
+      assert_equal ['2'], result.scan(/id="section-(\d+)"/).flatten
+    end
+  end
+
+  def test_section_edit_links_should_depend_on_sections_option_of_macro
+    Redmine::WikiFormatting::Macros.macro :test_plain_macro do |obj, args|
+      '<h2>Plain macro heading</h2>'.html_safe
+    end
+    Redmine::WikiFormatting::Macros.macro :test_sections_macro, :sections => true do |obj, args|
+      '<h2>Sections macro heading</h2>'.html_safe
+    end
+    raw = <<~RAW
+      # Wiki
+
+      {{test_plain_macro}}
+
+      {{test_sections_macro}}
+
+      ## Local section
+    RAW
+    @project = Project.find(1)
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'common_mark' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      # the macro without the option is not counted: the local heading is section 2
+      assert_include 'Plain macro heading', result
+      assert_include 'Sections macro heading', result
+      assert_equal ['2', '3'], result.scan(/edit\?section=(\d+)/).flatten
+      assert_match(/id="section-2">.*?Sections macro heading/m, result)
+      assert_match(/id="section-3">.*?Local section/m, result)
+    end
+  ensure
+    Redmine::WikiFormatting::Macros.available_macros.delete(:test_plain_macro)
+    Redmine::WikiFormatting::Macros.available_macros.delete(:test_sections_macro)
+  end
