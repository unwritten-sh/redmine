diff --git a/app/models/query.rb b/app/models/query.rb
index fc9b62b39..6f204fcd0 100644
--- a/app/models/query.rb
+++ b/app/models/query.rb
@@ -542,6 +542,30 @@ class Query < ApplicationRecord
     end if filters
   end
 
+  # Operators that split the filter value into search tokens
+  TOKENIZED_OPERATORS = %w(~ *~ !~ ^ $).freeze
+
+  # Returns an array of warning messages for filters whose value
+  # has more search terms than can be used
+  def filter_warnings
+    warnings = []
+    filters&.each_key do |field|
+      next unless [:string, :text, :search].include?(type_for(field))
+      next unless TOKENIZED_OPERATORS.include?(operator_for(field))
+
+      Array(values_for(field)).each do |value|
+        tokenizer = Redmine::Search::Tokenizer.new(value)
+        next unless tokenizer.truncated?
+
+        terms = tokenizer.tokens.map {|t| "\"#{t}\""}.join(l(:'support.array.words_connector'))
+        warnings << "#{label_for(field)}: " +
+          l(:warning_query_filter_max_tokens, :count => Redmine::Search::Tokenizer::MAX_TOKENS, :tokens => terms)
+        break
+      end
+    end
+    warnings
+  end
+
   def add_filter_error(field, message)
     m = label_for(field) + " " + l(message, :scope => 'activerecord.errors.messages')
     errors.add(:base, m)
