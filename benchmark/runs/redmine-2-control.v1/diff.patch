+  def test_tokenize_should_return_at_most_max_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five six seven')
+    assert_equal 5, Redmine::Search::Tokenizer::MAX_TOKENS
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert tokenizer.truncated?
+  end
+
+  def test_truncated_should_be_false_with_max_tokens_or_less
+    assert_not Redmine::Search::Tokenizer.new('one two three four five').truncated?
+    assert_not Redmine::Search::Tokenizer.new('one two').truncated?
+    assert_not Redmine::Search::Tokenizer.new('').truncated?
+  end
+
+  def test_truncated_should_ignore_duplicate_and_short_tokens
+    assert_not Redmine::Search::Tokenizer.new('one two three four five one a b').truncated?
+  end
 end
