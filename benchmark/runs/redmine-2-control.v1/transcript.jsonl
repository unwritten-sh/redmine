port.array.words_connector'))\n        warnings << \"#{label_for(field)}: \" +\n          l(:warning_query_filter_max_tokens, :count => Redmine::Search::Tokenizer::MAX_TOKENS, :tokens => terms)\n        break\n      end\n    end\n    warnings\n  end\n\n  def add_filter_error(field, message)\"\"\")\nopen(p,'w').write(s)\n\np='config/locales/en.yml'; s=open(p).read()\ns=s.replace(\"\"\"  warning_fields_cleared_on_bulk_edit:\"\"\",\"\"\"  warning_query_filter_max_tokens: \"A maximum of %{count} search terms can be used. Only the following terms were used: %{tokens}\"\n  warning_fields_cleared_on_bulk_edit:\"\"\")\nopen(p,'w').write(s)\n\np='app/helpers/queries_helper.rb'; s=open(p).read()\ns=s.replace(\"\"\"module QueriesHelper\n\"\"\",\"\"\"module QueriesHelper\n  # Renders the warnings of the query filters (eg. truncated search terms)\n  def query_filter_warnings(query)\n    return ''.html_safe unless query.respond_to?(:filter_warnings)\n\n    safe_join(query.filter_warnings.map {|warning| content_tag('p', warning, :class => 'warning')})\n  end\n\n\"\"\",1)\nopen(p,'w').write(s)\n\nfor p,old in [('app/views/queries/_query_form.html.erb',\"<%= error_messages_for @query %>\\n\"),\n              ('app/views/calendars/show.html.erb',\"<%= error_messages_for 'query' %>\\n\"),\n              ('app/views/gantts/show.html.erb',\"<%= error_messages_for 'query' %>\\n\")]:\n    s=open(p).read(); assert old in s\n    s=s.replace(old, old+\"<%= query_filter_warnings(@query) %>\\n\",1); open(p,'w').write(s)\nEOF\ngit diff --stat; sed -n 20,30p app/helpers/queries_helper.rb"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":523,"cache_read_input_tokens":30684,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":523},"output_tokens":28,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":nul