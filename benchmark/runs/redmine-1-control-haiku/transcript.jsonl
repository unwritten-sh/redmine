lacement: '> $2$3'}],\n    unbq: ['wrapLines', {pattern: ' *(> ?)?( *)([^\\\\n]*)', replacement: '$3$4'}],\n    pre: ['wrapLines', {prefix: '<pre>\\n', suffix: '\\n</pre>'}],\n    link: ['wrap', {prefix: '[[', suffix: ']]'}], img: ['wrap', {prefix: '!', suffix: '!'}],\n  }\n}\nconst MENU = {\n  common_mark: {table: {headerCell: '%{name} ', separatorCell: '--'}, precode: {prefix: '``` %{lang}\\n', suffix: '\\n```\\n'}},\n  textile: {table: {headerCell: '_.%{name}'}, precode: {prefix: '<pre><code class=\"%{lang}\">\\n', suffix: '\\n</code></pre>\\n'}},\n}\n\nfunction field(value, start, end) {\n  return {\n    value, selectionStart: start, selectionEnd: end, scrollTop: 0,\n    focus() {}, setRangeText(t, s, e) { this.value = this.value.slice(0, s) + t + this.value.slice(e) },\n    setSelectionRange(a, b) { this.selectionStart = a; this.selectionEnd = b }, dispatchEvent() {},\n  }\n}\nfunction run(Ctrl, fmt, fn, value, start, end) {\n  const c = Object.create(Ctrl.prototype)\n  c.field = field(value, start, end)\n  c.formatValue = fmt\n  c.menuParams = c.menuParams // old uses menuParams for table\n  fn(c)\n  return {value: c.field.value, s: c.field.selectionStart, e: c.field.selectionEnd}\n}\n\nconst texts = ['', 'Some text', 'first\\nsecond', '## Title', '> 1. first\\n> 1. second', '  - item\\n* x\\n# y\\n',\n  'code', 'a\\r\\nb\\r\\nc', 'trailing  \\nline ', '### deep\\n#  spaced', '1. one\\n2. two', '  > quoted\\n> x', '   ']\nconst failures = []\nlet checks = 0\nfor (const fmt of ['common_mark', 'textile']) {\n  for (const [button, [action, params]] of Object.entries(OLD[fmt])) {\n    for (const text of texts) {\n      const ranges = [[0, 0], [0, text.length], [0, Math.min(4, text.length)], [Math.min(2, text.length), text.length], [text.length, text.length]]\n      for (const [s, e] of ranges) {\n        const oldRes = run(Old, fmt, (c) => c[action]({params: {...params}}), text, s, e)\n        const newRes = run(New, fmt, (c) => c.apply({params: {button}}), text, 