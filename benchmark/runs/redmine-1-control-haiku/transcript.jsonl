   end\n\n      class WikiToolbar < Redmine::WikiToolbar\n        def buttons\n          [\n            {name: 'strong', action: 'wrap', prefix: '*', shortcut: 'b'},\n            {name: 'em', action: 'wrap', prefix: '_', shortcut: 'i'},\n            {name: 'ins', action: 'wrap', prefix: '+', shortcut: 'u'},\n            {name: 'del', action: 'wrap', prefix: '-'},\n            {name: 'code', action: 'wrap', prefix: '@'},\n            SPACER,\n            {name: 'h1', action: 'wrapLines', prefix: 'h1. ', strip: '^h\\d+\\.\\s+'},\n            {name: 'h2', action: 'wrapLines', prefix: 'h2. ', strip: '^h\\d+\\.\\s+'},\n            {name: 'h3', action: 'wrapLines', prefix: 'h3. ', strip: '^h\\d+\\.\\s+'},\n            SPACER,\n            {name: 'ul', action: 'wrapLines', pattern: '[#-]?\\s*', replacement: '* '},\n            {name: 'ol', action: 'wrapLines', pattern: '[*-]?\\s*', replacement: '# '},\n            SPACER,\n            {name: 'bq', action: 'wrapLines', pattern: '( *)([^\\n]*)', replacement: '> $2$3'},\n            {name: 'unbq', action: 'wrapLines', pattern: ' *(> ?)?( *)([^\\n]*)', replacement: '$3$4'},\n            {name: 'table', menu: :table, header_cell: '_.%{name}'},\n            {name: 'pre', action: 'wrapLines', prefix: \"<pre>\\n\", suffix: \"\\n</pre>\"},\n            {name: 'precode', menu: :precode, prefix: \"<pre><code class=\\\"%{lang}\\\">\\n\", suffix: \"\\n</code></pre>\\n\"},\n            SPACER,\n            {name: 'link', action: 'wrap', prefix: '[[', suffix: ']]'},\n            {name: 'img', action: 'wrap', prefix: '!', suffix: '!'},\n            SPACER,\n            {name: 'help', action: 'help'}\n          ]\n        end\n      end\n    end\n  end\nend\n# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n# This program is free software; you can redistribute it and/or\n# modify it under the terms of the GNU General Public License\n# as published by the Free Software Foundation; either version 2\n# of the License, or (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with this program; if not, write to the Free Software\n# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n\nrequire_relative '../../../test_helper'\n\nclass Redmine::WikiToolbarTest < Redmine::HelperTest\n  include ApplicationHelper\n\n  def test_wikitoolbar_for_should_render_toolbar_for_the_field\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description', '/issues/preview')\n\n      assert_select_in html, 'div.jstBlock[hidden][data-controller=?]', 'wiki-toolbar' do\n        assert_select '[data-wiki-toolbar-field-id-value=?]', 'issue_description'\n        assert_select '[data-wiki-toolbar-preview-url-value=?]', '/issues/preview'\n        assert_select '[data-wiki-toolbar-help-url-value=?]', '/help/wiki_syntax'\n        assert_select 'div.jstTabs ul[role=tablist]' do\n          assert_select 'a.tab-edit.selected[aria-selected=true]', :text => 'Edit'\n          assert_select 'a.tab-preview[aria-selected=false]', :text => 'Preview'\n          assert_select 'div.jstElements'\n        end\n        assert_select 'div.jstEditor div.wiki-preview.hidden#preview_issue_description'\n      end\n    end\n  end\n\n  def test_wikitoolbar_for_should_render_nothing_without_text_formatting\n    with_settings :text_formatting => '' do\n      assert_nil wikitoolbar_for('issue_description')\n    end\n  end\n\n  def test_common_mark_buttons\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'div.jstElements' do\n        assert_select 'button', 19\n        assert_select 'span.jstSpacer', 5\n        assert_select 'button.jstb_strong[title=?][data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-shortcut=b]',\n                      'Strong', 'wiki-toolbar#wrap', '**'\n        assert_select 'button.jstb_ins[data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-suffix-param=?]', '<u>', '</u>'\n        assert_select 'button.jstb_h1[data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-strip-param=?]',\n                      'wiki-toolbar#wrapLines', '# ', '^#+\\s+'\n        assert_select 'button.jstb_tl[data-wiki-toolbar-replacement-param=?]', '* [ ] '\n        assert_select 'button.jstb_table[data-action=?][data-wiki-toolbar-menu-param=table][data-wiki-toolbar-separator-cell-param=?]',\n                      'wiki-toolbar#toggleMenu', '--'\n        assert_select 'button.jstb_precode[data-wiki-toolbar-menu-param=precode]:not([data-wiki-toolbar-prefix-param])'\n        assert_select 'button.jstb_help[data-action=?]', 'wiki-toolbar#help'\n      end\n    end\n  end\n\n  def test_textile_buttons\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'div.jstElements' do\n        assert_select 'button', 18\n        assert_select 'button.jstb_tl', 0\n        assert_select 'button.jstb_strong[data-wiki-toolbar-prefix-param=?]', '*'\n        assert_select 'button.jstb_ol[data-wiki-toolbar-replacement-param=?]', '# '\n        assert_select 'button.jstb_table[data-wiki-toolbar-header-cell-param=?]:not([data-wiki-toolbar-separator-cell-param])', '_.%{name}'\n      end\n    end\n  end\n\n  def test_buttons_should_be_translated\n    with_settings :text_formatting => 'common_mark' do\n      set_language_if_valid 'fr'\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'a.tab-edit', :text => ::I18n.t(:button_edit, :locale => 'fr')\n      assert_select_in html, 'button.jstb_strong[title=?]', ::I18n.t(:label_wiki_toolbar_strong, :locale => 'fr')\n    end\n  end\n\n  def test_keyboard_shortcuts\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n      actions = Nokogiri::HTML.fragment(html).at_css('div.jstBlock')['data-action'].split\n\n      %w[b i u].each do |key|\n        assert_include \"keydown.ctrl+#{key}->wiki-toolbar#shortcut\", actions\n        assert_include \"keydown.meta+#{key}->wiki-toolbar#shortcut\", actions\n      end\n      assert_include 'keydown.ctrl+shift+p@window->wiki-toolbar#togglePreview', actions\n      assert_include 'keydown.meta+shift+p@window->wiki-toolbar#togglePreview', actions\n    end\n  end\n\n  def test_precode_menu_should_list_the_user_languages\n    User.current = User.find(2)\n    User.current.pref.update!(:toolbar_language_options => 'ruby,python')\n\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=precodeMenu] ul.jstMenu[role=menu]' do\n        assert_select 'button[role=menuitem][data-action=?]', 'wiki-toolbar#wrapLines', :count => 2\n      end\n      item = Nokogiri::HTML.fragment(html).at_css('ul.jstMenu button')\n      assert_equal 'ruby', item.text\n      assert_equal %(<pre><code class=\"ruby\">\\n), item['data-wiki-toolbar-prefix-param']\n      assert_equal \"\\n</code></pre>\\n\", item['data-wiki-toolbar-suffix-param']\n    end\n  end\n\n  def test_table_menu\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=tableMenu] table.table-generator' do\n        assert_select 'tr', 5\n        assert_select 'td button', 50\n        assert_select 'td button[title=?][data-action=?][data-wiki-toolbar-cols-param=\"3\"][data-wiki-toolbar-rows-param=\"2\"]',\n                      '3×2', 'wiki-toolbar#insertTable'\n      end\n    end\n  end\n\n  def test_heads_for_wiki_formatter_should_only_define_image_mime_types\n    with_settings :text_formatting => 'common_mark' do\n      heads_for_wiki_formatter\n      heads_for_wiki_formatter\n      header_tags = content_for(:header_tags)\n\n      assert_include 'var wikiImageMimeTypes = ', header_tags\n      assert_equal 1, header_tags.scan('wikiImageMimeTypes').size\n      assert_not_include 'jstoolbar', header_tags\n    end\n  end\nend\n# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n# This program is free software; you can redistribute it and/or\n# modify it under the terms of the GNU General Public License\n# as published by the Free Software Foundation; either version 2\n# of the License, or (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with this program; if not, write to the Free Software\n# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n\nrequire_relative '../application_system_test_case'\n\nclass WikiToolbarTest < ApplicationSystemTestCase\n  def test_toolbar_should_be_moved_before_the_textarea\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    within '#issue_description_and_toolbar' do\n      assert_selector 'div.jstBlock div.jstEditor textarea#issue_description'\n      assert_selector 'div.jstBlock div.jstTabs + div.jstEditor'\n    end\n  end\n\n  def test_wrap_selection_using_textile\n    with_settings :text_formatting => 'textile' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      fill_in 'Description', :with => 'Some text'\n      select_text 'issue_description', 5, 9\n      find('button.jstb_strong').click\n      assert_equal 'Some *text*', find('#issue_description').value\n\n      fill_in 'Description', :with => 'Some text'\n      select_text 'issue_description', 0, 4\n      find('button.jstb_link').click\n      assert_equal '[[Some]] text', find('#issue_description').value\n    end\n  end\n\n  def test_wrap_lines_using_common_mark\n    with_settings :text_formatting => 'common_mark' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      fill_in 'Description', :with => \"## Title\"\n      find('button.jstb_h1').click\n      assert_equal '# Title', find('#issue_description').value\n\n      fill_in 'Description', :with => \"first\\nsecond\"\n      select_text 'issue_description', 0, 12\n      find('button.jstb_ol').click\n      assert_equal \"1. first\\n1. second\", find('#issue_description').value\n\n      select_text 'issue_description', 0, 18\n      find('button.jstb_bq').click\n      assert_equal \"> 1. first\\n> 1. second\", find('#issue_description').value\n\n      select_text 'issue_description', 0, 22\n      find('button.jstb_unbq').click\n      assert_equal \"1. first\\n1. second\", find('#issue_description').value\n\n      fill_in 'Description', :with => 'code'\n      find('button.jstb_pre').click\n      assert_equal \"```\\ncode\\n```\", find('#issue_description').value\n    end\n  end\n\n  def test_insert_table_using_common_mark\n    with_settings :text_formatting => 'common_mark' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      find('button.jstb_table').click\n      within 'div.jstBlock table.table-generator' do\n        find('button[title=\"2×3\"]').hover\n        assert_selector 'td.selected-cell', :count => 6\n        find('button[title=\"2×3\"]').click\n      end\n      assert_no_selector 'table.table-generator'\n      assert_equal \"|A |B |\\n|--|--|\\n|  |  |\\n|  |  |\\n|  |  |\\n\", find('#issue_description').value\n    end\n  end\n\n  def test_insert_table_using_textile\n    with_settings :text_formatting => 'textile' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      find('button.jstb_table').click\n      find('table.table-generator button[title=\"2×1\"]').click\n      assert_equal \"|_.A|_.B|\\n|  |  |\\n\", find('#issue_description').value\n    end\n  end\n\n  def test_insert_highlighted_code\n    with_settings :text_formatting => 'common_mark' do\n      log_user('jsmith', 'jsmith')\n      visit '/projects/ecookbook/issues/new'\n\n      fill_in 'Description', :with => 'puts 1'\n      find('button.jstb_precode').click\n      within('ul.jstMenu') {click_button 'ruby'}\n      assert_no_selector 'ul.jstMenu'\n      assert_equal \"``` ruby\\nputs 1\\n```\\n\", find('#issue_description').value\n    end\n  end\n\n  def test_menus_should_close_with_escape_outside_click_or_toggle\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    find('button.jstb_precode').click\n    assert_selector 'ul.jstMenu button:focus'\n    find('ul.jstMenu button', match: :first).send_keys(:escape)\n    assert_no_selector 'ul.jstMenu'\n\n    find('button.jstb_table').click\n    assert_selector 'table.table-generator'\n    find('button.jstb_table').click\n    assert_no_selector 'table.table-generator'\n\n    find('button.jstb_precode').click\n    find('button.jstb_table').click\n    assert_no_selector 'ul.jstMenu'\n    assert_selector 'table.table-generator'\n    find('#issue_subject').click\n    assert_no_selector 'table.table-generator'\n  end\n\n  def test_full_width_custom_field_should_have_toolbar\n    field = IssueCustomField.create!(:name => 'Long text', :field_format => 'text', :full_width_layout => '1',\n                                     :text_formatting => 'full', :is_for_all => true, :tracker_ids => [1])\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    assert_selector \"div.jstBlock div.jstEditor textarea#issue_custom_field_values_#{field.id}\"\n    find(\"#issue_custom_field_values_#{field.id}\").click\n    find(\"div.jstBlock:has(#issue_custom_field_values_#{field.id}) button.jstb_strong\").click\n    assert_equal '****', find(\"#issue_custom_field_values_#{field.id}\").value\n  end\n\n  def test_preview_should_send_attachments_and_toggle_toolbar\n    log_user('jsmith', 'jsmith')\n    visit '/projects/ecookbook/issues/new'\n\n    fill_in 'Description', :with => 'Preview *me*'\n    click_link 'Preview'\n    within 'div.jstBlock' do\n      assert_selector 'div.wiki-preview', :visible => true, :text => 'Preview me'\n      assert_selector 'div.jstElements', :visible => false\n      assert_selector 'a.tab-preview.selected[aria-selected=true]'\n    end\n    click_link 'Edit'\n    assert_selector 'div.jstElements', :visible => true\n    assert_equal 'issue_description', page.evaluate_script('document.activeElement.id')\n  end\n\n  private\n\n  def select_text(id, start, finish)\n    page.execute_script(\"document.getElementById('#{id}').setSelectionRange(#{start}, #{finish})\")\n  end\nend\ntest/system/keyboard_shortcuts_test.rb:31:    find 'div.wiki-preview', :visible => true, :text => 'new issue description'\ntest/system/keyboard_shortcuts_test.rb:35:    find 'div.wiki-preview', :visible => false\ntest/system/keyboard_shortcuts_test.rb:36:    find 'textarea.wiki-edit', :visible => true\ntest/system/keyboard_shortcuts_test.rb:40:    find 'div.wiki-preview', :visible => true, :text => 'new issue description'\ntest/system/keyboard_shortcuts_test.rb:44:    find 'div.wiki-preview', :visible => false\ntest/system/keyboard_shortcuts_test.rb:45:    find 'textarea.wiki-edit', :visible => true\ntest/system/keyboard_shortcuts_test.rb:54:    page.find('#issue_description_and_toolbar').click_link('Preview')\ntest/system/keyboard_shortcuts_test.rb:66:  def test_keyboard_shortcuts_for_wiki_toolbar_buttons_using_textile\ntest/system/keyboard_shortcuts_test.rb:86:  def test_keyboard_shortcuts_for_wiki_toolbar_buttons_using_markdown\ntest/system/keyboard_shortcuts_test.rb:110:    within('.jstBlock .jstElements') do\ntest/system/keyboard_shortcuts_test.rb:111:      assert_equal \"Strong (#{modifier_key_title}B)\", find('button.jstb_strong')['title']\ntest/system/keyboard_shortcuts_test.rb:112:      assert_equal \"Italic (#{modifier_key_title}I)\", find('button.jstb_em')['title']\ntest/system/keyboard_shortcuts_test.rb:114:      assert_equal \"Deleted\", find('button.jstb_del')['title']\ntest/integration/layout_test.rb:56:  def test_wiki_formatter_header_tags\ntest/integration/layout_test.rb:60:    assert_select \"head script:match('src',?)\", %r{/assets/jstoolbar/}, 0\ntest/integration/layout_test.rb:61:    assert_select \"head link[rel=stylesheet]:match('href',?)\", %r{/assets/jstoolbar-\\w+.css}\ntest/integration/layout_test.rb:62:    assert_include \"var wikiImageMimeTypes = #{Redmine::MimeType.by_type('image').to_json};\", response.body\ntest/integration/layout_test.rb:63:    assert_select 'div.jstBlock[data-wiki-toolbar-field-id-value=issue_description]' do\ntest/integration/layout_test.rb:64:      UserPreference::DEFAULT_TOOLBAR_LANGUAGE_OPTIONS.each do |lang|\ntest/integration/layout_test.rb:65:        assert_select 'template[data-wiki-toolbar-target=precodeMenu]', :html => /data-wiki-toolbar-prefix-param=\"``` #{lang}/","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NQvX6KaTfBZT87feh3mSZC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
