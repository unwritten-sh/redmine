diff --git a/app/javascript/wiki_toolbar/common_mark.js b/app/javascript/wiki_toolbar/common_mark.js
new file mode 100644
index 000000000..c22a3a9ff
--- /dev/null
+++ b/app/javascript/wiki_toolbar/common_mark.js
@@ -0,0 +1,41 @@
+/**
+ * Redmine - project management software
+ * Copyright (C) 2006-  Jean-Philippe Lang
+ * This code is released under the GNU General Public License.
+ */
+
+// Syntax inserted by the wiki toolbar buttons for the CommonMark text formatter.
+//
+// Buttons using wrap insert prefix and suffix around the selected text
+// (suffix defaults to prefix). Buttons using wrapLines apply the prefix and
+// suffix to each selected line, after removing the strip pattern and
+// replacing the pattern at the start of each line with the replacement.
+export default {
+  buttons: {
+    strong: { wrap: { prefix: '**' } },
+    em: { wrap: { prefix: '*' } },
+    ins: { wrap: { prefix: '<u>', suffix: '</u>' } },
+    del: { wrap: { prefix: '~~' } },
+    code: { wrap: { prefix: '`' } },
+    h1: { wrapLines: { prefix: '# ', strip: '^#+\\s+' } },
+    h2: { wrapLines: { prefix: '## ', strip: '^#+\\s+' } },
+    h3: { wrapLines: { prefix: '### ', strip: '^#+\\s+' } },
+    ul: { wrapLines: { pattern: '[#-]?\\s*', replacement: '* ' } },
+    ol: { wrapLines: { pattern: '[*-]?\\s*', replacement: '1. ' } },
+    tl: { wrapLines: { pattern: '[*-]?\\s*', replacement: '* [ ] ' } },
+    bq: { wrapLines: { pattern: '( *)([^\\n]*)', replacement: '> $2$3' } },
+    unbq: { wrapLines: { pattern: ' *(> ?)?( *)([^\\n]*)', replacement: '$3$4' } },
+    pre: { wrapLines: { prefix: '```\n', suffix: '\n```' } },
+    link: { wrap: { prefix: '[[', suffix: ']]' } },
+    img: { wrap: { prefix: '![](', suffix: ')' } }
+  },
+  table: {
+    headerCell: '%{name} ',
+    separatorCell: '--'
+  },
+  // %{lang} is replaced by the language selected in the precode menu
+  precode: {
+    prefix: '``` %{lang}\n',
+    suffix: '\n```\n'
+  }
+}
