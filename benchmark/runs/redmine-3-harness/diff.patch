+  def test_macro_registration_with_sections_option_should_keep_section_edit_links
+    Redmine::WikiFormatting::Macros.register do
+      macro :heading_with_sections, :sections => true do |obj, args|
+        '<h2>From macro</h2>'.html_safe
+      end
+      macro :heading_without_sections do |obj, args|
+        '<h2>From macro</h2>'.html_safe
+      end
+    end
+    assert Redmine::WikiFormatting::Macros.available_macros[:heading_with_sections][:sections]
+    assert macro_output_has_sections?('collapse')
+    assert_not macro_output_has_sections?('include')
+
+    links = {:controller => 'wiki', :action => 'edit', :project_id => '1', :id => 'Test'}
+    with_settings :text_formatting => 'textile' do
+      text = "h1. Title\n\n{{heading_with_sections}}\n\nh2. Local"
+      result = textilizable(text, :edit_section_links => links)
+      assert_include 'section=2', result
+      assert_include 'section=3', result
+
+      text = "h1. Title\n\n{{heading_without_sections}}\n\nh2. Local"
+      result = textilizable(text, :edit_section_links => links)
+      assert_include 'From macro', result
+      assert_include 'section=2', result
+      assert_not_include 'section=3', result
+    end
+  end
+
+  def test_macro_registration_with_invalid_option_should_raise
+    assert_raise ArgumentError do
+      Redmine::WikiFormatting::Macros.macro(:invalid_option, :foo => true) {|obj, args| ''}
+    end
+  end
