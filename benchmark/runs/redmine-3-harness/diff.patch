+  def test_section_edit_links_with_include_macro
+    @project = Project.find(1)
+    wiki = @project.wiki
+    included = WikiPage.new(:wiki => wiki, :title => 'Included_page_with_headings')
+    included.content = WikiContent.new(:text => "## Included A\n\ntext\n\n## Included B\n\ntext",
+                                       :author => User.find(1))
+    included.save!
+
+    raw = <<~RAW
+      # Wiki
+
+      ## Section A
+
+      {{include(Included_page_with_headings)}}
+
+      ## Section B
+
+      {{collapse(View details...)
+      ## Section C
+      }}
+
+      ## Section D
+    RAW
+    set_language_if_valid 'en'
+    with_settings :text_formatting => 'common_mark' do
+      result =
+        textilizable(
+          raw,
+          :edit_section_links =>
+            {:controller => 'wiki', :action => 'edit',
+            :project_id => '1', :id => 'Test'}
+        ).delete("\n")
+
+      # Included headings are rendered, without edit links
+      assert_include '<h2 >Included A<a href="#Included-A" class="wiki-anchor">&para;</a></h2>', result
+      assert_include '<h2 >Included B<a href="#Included-B" class="wiki-anchor">&para;</a></h2>', result
+      assert_equal 4, result.scan('class="contextual heading-').size
+      assert_not_include 'macro-output-', result
+
+      # Local headings keep the section numbers used when editing the page
+      formatter = Redmine::WikiFormatting.formatter_for('common_mark').new(raw)
+      {2 => 'Section A', 3 => 'Section B', 4 => 'Section C', 5 => 'Section D'}.each do |section, title|
+        assert_match(
+          Regexp.new(
+            "<div class=\"contextual heading-2\" title=\"Edit this section\" id=\"section-#{section}\">" \
+            "<a class=\"icon-only icon-edit\" href=\"/projects/1/wiki/Test/edit\\?section=#{section}\">" \
+            '.*?</a></div>' \
+            "<a name=\"#{title.tr(' ', '-')}\"></a>" \
+            "<h2 >#{title}<a "
+          ),
+          result
+        )
+        assert_equal "## #{title}", formatter.get_section(section).first.lines.first.strip
+      end
+    end
+  end
