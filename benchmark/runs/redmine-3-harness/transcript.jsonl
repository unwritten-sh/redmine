icons-.*\\\\.svg#icon--edit\"></use></svg>' \\\n          '<span class=\"icon-label\">Edit this section</span>' \\\n          '</a></div>' \\","numLines":150,"startLine":1530,"totalLines":2460}},"tool_result_meta":[{"id":"toolu_01LGXWAbvvRUaHzQBqZ5uFQz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
