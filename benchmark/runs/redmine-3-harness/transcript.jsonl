{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016eF2bQ4Zs7Pa1V3UWXottK","type":"tool_result","content":"20\tmodule Redmine\n21\t  module WikiFormatting\n22\t    module Macros\n23\t      module Definitions\n24\t        # Returns true if +name+ is the name of an existing macro\n25\t        def macro_exists?(name)\n26\t          Redmine::WikiFormatting::Macros.available_macros.key?(name.to_sym)\n27\t        end\n28\t\n29\t        def exec_macro(name, obj, args, text, options={})\n30\t          macro_options = Redmine::WikiFormatting::Macros.available_macros[name.to_sym]\n31\t          return unless macro_options\n32\t\n33\t          if options[:inline_attachments] == false\n34\t            Redmine::WikiFormatting::Macros.inline_attachments = false\n35\t          else\n36\t            Redmine::WikiFormatting::Macros.inline_attachments = true\n37\t          end\n38\t\n39\t          method_name = \"macro_#{name}\"\n40\t          unless macro_options[:parse_args] == false\n41\t            # Split the arguments by commas, but only if the commas\n42\t            # are not within double quotes\n43\t            args = args.split(/\\s*,\\s*(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/)\n44\t                       .map {|i| i.gsub(/^\"(.*)\"$/, '\\1').gsub('\"\"', '\"')}\n45\t          end\n46\t\n47\t          begin\n48\t            if self.class.instance_method(method_name).arity == 3\n49\t              send(method_name, obj, args, text)\n50\t            elsif text\n51\t              raise t(:error_macro_does_not_accept_block)\n52\t            else\n53\t              send(method_name, obj, args)\n54\t            end\n55\t          rescue => e\n56\t            %|<div class=\"flash error\">#{::I18n.t(:error_can_not_execute_macro_html, :name => ::ERB::Util.h(name), :error => ::ERB::Util.h(e.to_s))}</div>|.html_safe\n57\t          end\n58\t        end\n59\t\n60\t        def extract_macro_options(args, *keys)\n61\t          options = {}\n62\t          while args.last.to_s.strip =~ %r{^(.+?)\\=(.+)$} && keys.include?($1.downcase.to_sym)\n63\t            options[$1.downcase.to_sym] = $2.gsub(/^\"(.*)\"$/, '\\1')\n64\t            args.pop\n65\t          end\n66\t          return [args, options]\n67\t        end\n68\t\n69\t        def current_project(obj)\n70\t          @project || (obj.is_a?(Project) && obj) || (obj.respond_to?(:project) && obj.project)\n71\t        end\n72\t      end\n73\t\n74\t      @@available_macros = {}\n75\t      @@inline_attachments = true\n76\t      mattr_accessor :available_macros\n77\t      mattr_accessor :inline_attachments\n78\t\n79\t      class << self\n80\t        # Plugins can use this method to define new macros:\n81\t        #\n82\t        #   Redmine::WikiFormatting::Macros.register do\n83\t        #     desc \"This is my macro\"\n84\t        #     macro :my_macro do |obj, args|\n85\t        #       \"My macro output\"\n86\t        #     end\n87\t        #\n88\t        #     desc \"This is my macro that accepts a block of text\"\n89\t        #     macro :my_macro do |obj, args, text|\n90\t        #       \"My macro output\"\n91\t        #     end\n92\t        #   end\n93\t        def register(&block)\n94\t          class_eval(&block) if block\n95\t        end\n96\t\n97\t        # Defines a new macro with the given name, options and block.\n98\t        #\n99\t        # Options:\n100\t        # * :desc - A description of the macro\n101\t        # * :parse_args => false - Disables arguments parsing (the whole arguments\n102\t        #   string is passed to the macro)\n103\t        #\n104\t        # Macro blocks accept 2 or 3 arguments:\n105\t        # * obj: the object that is rendered (eg. an Issue, a WikiContent...)\n106\t        # * args: macro arguments\n107\t        # * text: the block of text given to the macro (should be present only if the\n108\t        #   macro accepts a block of text). text is a String or nil if the macro is\n109\t        #   invoked without a block of text.\n110\t        #\n111\t        # Examples:\n112\t        # By default, when the macro is invoked, the comma separated list of arguments\n113\t        # is split and passed to the macro block as an array. If no argument is given\n114\t        # the macro will be invoked with an empty array:\n115\t        #\n116\t        #   macro :my_macro do |obj, args|\n117\t        #     # args is an array\n118\t        #     # and this macro do not accept a block of text\n119\t        #   end\n120\t        #\n121\t        # You can disable arguments spliting with the :parse_args => false option. In\n122\t        # this case, the full string of arguments is passed to the macro:\n123\t        #\n124\t        #   macro :my_macro, :parse_args => false do |obj, args|\n125\t        #     # args is a string\n126\t        #   end\n127\t        #\n128\t        # Macro can optionally accept a block of text:\n129\t        #\n130\t        #   macro :my_macro do |obj, args, text|\n131\t        #     # this macro accepts a block of text\n132\t        #   end\n133\t        #\n134\t        # Macros are invoked in formatted text using double curly brackets. Arguments\n135\t        # must be enclosed in parenthesis if any. A new line after the macro name or the\n136\t        # arguments starts the block of text that will be passe to the macro (invoking\n137\t        # a macro that do not accept a block of text with some text will fail).\n138\t        # Examples:\n139\t        #\n140\t        #   No arguments:\n141\t        #   {{my_macro}}\n142\t        #\n143\t        #   With arguments:\n144\t        #   {{my_macro(arg1, arg2)}}\n145\t        #\n146\t        #   With a block of text:\n147\t        #   {{my_macro\n148\t        #   multiple lines\n149\t        #   of text\n150\t        #   }}\n151\t        #\n152\t        #   With arguments and a block of text\n153\t        #   {{my_macro(arg1, arg2)\n154\t        #   multiple lines\n155\t        #   of text\n156\t        #   }}\n157\t        #\n158\t        # If a block of text is given, the closing tag }} must be at the start of a new line.\n159\t        def macro(name, options={}, &block)\n160\t          options.assert_valid_keys(:desc, :parse_args)\n161\t          unless /\\A\\w+\\z/.match?(name.to_s)\n162\t            raise \"Invalid macro name: #{name} (only 0-9, A-Z, a-z and _ characters are accepted)\"\n163\t          end\n164\t          unless block\n165\t            raise \"Can not create a macro without a block!\"\n166\t          end\n167\t\n168\t          name = name.to_s.downcase.to_sym\n169\t          available_macros[name] = {:desc => @@desc || ''}.merge(options)\n170\t          @@desc = nil\n171\t          Definitions.send :define_method, \"macro_#{name}\", &block\n172\t        end\n173\t\n174\t        # Sets description for the next macro to be defined\n175\t        def desc(txt)\n176\t          @@desc = txt\n177\t        end\n178\t      end\n179\t\n180\t      # Builtin macros\n181\t      desc \"Sample macro.\"\n182\t      macro :hello_world do |obj, args, text|\n183\t        h(\n184\t          \"Hello world! Object: #{obj.class.name}, \" +\n185\t          (args.empty? ? \"Called with no argument\" : \"Arguments: #{args.join(', ')}\") +\n186\t          \" and \" + (text.present? ? \"a #{text.size} bytes long block of text.\" : \"no block of text.\")\n187\t        )\n188\t      end\n189\t\n190\t      desc \"Displays a list of all available macros, including description if available.\"\n191\t      macro :macro_list do |obj, args|\n192\t        out = ''.html_safe\n193\t        @@available_macros.each do |macro, options|\n194\t          out << content_tag('dt', content_tag('code', macro.to_s))\n195\t          out << content_tag('dd', content_tag('pre', options[:desc]))\n196\t        end\n197\t        content_tag('dl', out)\n198\t      end\n199\t\n200\t      desc \"Displays a list of child pages. With no argument, it displays the child pages of the current wiki page. Examples:\\n\\n\" +\n201\t             \"{{child_pages}} -- can be used from a wiki page only\\n\" +\n202\t             \"{{child_pages(depth=2)}} -- display 2 levels nesting only\\n\" +\n203\t             \"{{child_pages(Foo)}} -- lists all children of page Foo\\n\" +\n204\t             \"{{child_pages(Foo, parent=1)}} -- same as above with a link to page Foo\"\n205\t      macro :child_pages do |obj, args|\n206\t        args, options = extract_macro_options(args, :parent, :depth)\n207\t        options[:depth] = options[:depth].to_i if options[:depth].present?\n208\t\n209\t        page = nil\n210\t        if args.size > 0\n211\t          page = Wiki.find_page(args.first.to_s, :project => @project)\n212\t        elsif obj.is_a?(WikiContent) || obj.is_a?(WikiContentVersion)\n213\t          page = obj.page\n214\t        else\n215\t          raise t(:error_childpages_macro_no_argument)\n216\t        end\n217\t        raise t(:error_page_not_found) if page.nil? || !User.current.allowed_to?(:view_wiki_pages, page.wiki.project)\n218\t\n219\t        pages = page.self_and_descendants(options[:depth]).group_by(&:parent_id)\n220\t        render_page_hierarchy(pages, options[:parent] ? page.parent_id : page.id)\n221\t      end\n222\t\n223\t      desc \"Displays a list of recently updated wiki pages. With no argument, it displays pages that have been updated within the last 7 days. Examples:\\n\\n\" +\n224\t             \"{{recent_pages}} -- displays pages updated within the last 7 days\\n\" +\n225\t             \"{{recent_pages(days=3)}} -- displays pages updated within the last 3 days\\n\" +\n226\t             \"{{recent_pages(limit=5)}} -- limits the maximum number of pages to display to 5\\n\" +\n227\t             \"{{recent_pages(time=true)}} -- displays pages updated within the last 7 days with updated time\\n\" +\n228\t             \"{{recent_pages(project=identifier)}} -- displays pages updated within the last 7 days from a specific project\\n\" +\n229\t             \"{{recent_pages(include_subprojects=true)}} -- includes pages from subprojects\"\n230\t\n231\t      macro :recent_pages do |obj, args|\n232\t        args, options = extract_macro_options(args, :days, :limit, :time, :project, :include_subprojects)\n233\t\n234\t        if options[:project].presence\n235\t          project = Project.find_by_identifier(options[:project].to_s) if options[:project].present?\n236\t        else\n237\t          project = current_project(obj)\n238\t        end\n239\t\n240\t        return '' if project.nil?\n241\t\n242\t        days_to_list = (options[:days].presence || 7).to_i\n243\t        limit = options[:limit].to_i if options[:limit].present?\n244\t        is_show_time = options[:time].to_s == 'true'\n245\t        if options[:include_subprojects].to_s == 'true'\n246\t          project_ids = project.self_and_descendants.allowed_to(User.current, :view_wiki_pages).pluck(:id)\n247\t        elsif User.current.allowed_to?(:view_wiki_pages, project)\n248\t          project_ids = [project.id]\n249\t        end\n250\t\n251\t        return '' if project_ids.blank?\n252\t\n253\t        pages = WikiPage.\n254\t          joins(:wiki, :content).\n255\t          where(:wikis => {:project_id => project_ids}).\n256\t          where(\"#{WikiContent.table_name}.updated_on >= ?\", days_to_list.days.ago).\n257\t          order(\"#{WikiContent.table_name}.updated_on DESC, #{WikiPage.table_name}.id DESC\").\n258\t          limit(limit)\n259\t\n260\t        tag.ul do\n261\t          pages.each do |page|\n262\t            concat(\n263\t              tag.li do\n264\t                html = link_to(h(page.pretty_title), project_wiki_page_path(page.project, page.title))\n265\t                html << \" (#{time_ago_in_words(page.content.updated_on)})\" if is_show_time\n266\t                html\n267\t              end\n268\t            )\n269\t          end\n270\t        end\n271\t      end\n272\t\n273\t      desc \"Includes a wiki page. Examples:\\n\\n\" +\n274\t             \"{{include(Foo)}}\\n\" +\n275\t             \"{{include(projectname:Foo)}} -- to include a page of a specific project wiki\"\n276\t      macro :include do |obj, args|\n277\t        project = current_project(obj)\n278\t        page = Wiki.find_page(args.first.to_s, :project => project)\n279\t        raise t(:error_page_not_found) if page.nil? || !User.current.allowed_to?(:view_wiki_pages, page.wiki.project)\n280\t\n281\t        @included_wiki_pages ||= []\n282\t        raise t(:error_circular_inclusion) if @included_wiki_pages.include?(page.id)\n283\t\n284\t        @included_wiki_pages << page.id\n285\t        out =\n286\t          textilizable(\n287\t            page.content,\n288\t            :text,\n289\t            :attachments => page.attachments,\n290\t            :headings => false,\n291\t            :inline_attachments => @@inline_attachments\n292\t          )\n293\t        @included_wiki_pages.pop\n294\t        out\n295\t      end\n296\t\n297\t      desc \"Inserts of collapsed block of text. Examples:\\n\\n\" +\n298\t             \"{{collapse\\nThis is a block of text that is collapsed by default.\\nIt can be expanded by clicking a link.\\n}}\\n\\n\" +\n299\t             \"{{collapse(View details...)\\nWith custom link text.\\n}}\"\n300\t      macro :collapse do |obj, args, text|\n301\t        html_id = \"collapse-#{Redmine::Utils.random_hex(4)}\"\n302\t        show_label = args[0] || l(:button_show)\n303\t        hide_label = args[1] || args[0] || l(:button_hide)\n304\t        js = \"$('##{html_id}-show, ##{html_id}-hide').toggle(); $('##{html_id}').fadeToggle(150);\"\n305\t        out = ''.html_safe\n306\t        out << link_to_function(sprite_icon('angle-right', show_label, rtl: true), js, :id => \"#{html_id}-show\", :class => 'icon icon-collapsed collapsible')\n307\t        out <<\n308\t          link_to_function(\n309\t            sprite_icon('angle-down', hide_label), js,\n310\t            :id => \"#{html_id}-hide\",\n311\t            :class => 'icon icon-expanded collapsible',\n312\t            :style => 'display:none;'\n313\t          )\n314\t        out <<\n315\t          content_tag(\n316\t            'div',\n317\t            textilizable(text, :object => obj, :headings => false,\n318\t                         :inline_attachments => @@inline_attachments),\n319\t            :id => html_id, :class => 'collapsed-text',\n320\t            :style => 'display:none;'\n321\t          )\n322\t        out\n323\t      end\n324\t"}]},"parent_tool_use_id":null,"session_id":"b1139b5d-6c0c-4a86-8cc8-325d1d420624","uuid":"e8c045b3-013a-4268-87c5-2a82da5d6ec6","timestamp":"2026-11-01T21:59:54.743Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/redmine/bench/trees/redmine-3-harness/lib/redmine/wiki_formatting/macros.rb","content":"module Redmine\n  module WikiFormatting\n    module Macros\n      module Definitions\n        # Returns true if +name+ is the name of an existing macro\n        def macro_exists?(name)\n          Redmine::WikiFormatting::Macros.available_macros.key?(name.to_sym)\n        end\n\n        def exec_macro(name, obj, args, text, options={})\n          macro_options = Redmine::WikiFormatting::Macros.available_macros[name.to_sym]\n          return unless macro_options\n\n          if options[:inline_attachments] == false\n            Redmine::WikiFormatting::Macros.inline_attachments = false\n          else\n            Redmine::WikiFormatting::Macros.inline_attachments = true\n          end\n\n          method_name = \"macro_#{name}\"\n          unless macro_options[:parse_args] == false\n            # Split the arguments by commas, but only if the commas\n            # are not within double quotes\n            args = args.split(/\\s*,\\s*(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/)\n                       .map {|i| i.gsub(/^\"(.*)\"$/, '\\1').gsub('\"\"', '\"')}\n          end\n\n          begin\n            if self.class.instance_method(method_name).arity == 3\n              send(method_name, obj, args, text)\n            elsif text\n              raise t(:error_macro_does_not_accept_block)\n            else\n              send(method_name, obj, args)\n            end\n          rescue => e\n            %|<div class=\"flash error\">#{::I18n.t(:error_can_not_execute_macro_html, :name => ::ERB::Util.h(name), :error => ::ERB::Util.h(e.to_s))}</div>|.html_safe\n          end\n        end\n\n        def extract_macro_options(args, *keys)\n          options = {}\n          while args.last.to_s.strip =~ %r{^(.+?)\\=(.+)$} && keys.include?($1.downcase.to_sym)\n            options[$1.downcase.to_sym] = $2.gsub(/^\"(.*)\"$/, '\\1')\n            args.pop\n          end\n          return [args, options]\n        end\n\n        def current_project(obj)\n          @project || (obj.is_a?(Project) && obj) || (obj.respond_to?(:project) && obj.project)\n        end\n      end\n\n      @@available_macros = {}\n      @@inline_attachments = true\n      mattr_accessor :available_macros\n      mattr_accessor :inline_attachments\n\n      class << self\n        # Plugins can use this method to define new macros:\n        #\n        #   Redmine::WikiFormatting::Macros.register do\n        #     desc \"This is my macro\"\n        #     macro :my_macro do |obj, args|\n        #       \"My macro output\"\n        #     end\n        #\n        #     desc \"This is my macro that accepts a block of text\"\n        #     macro :my_macro do |obj, args, text|\n        #       \"My macro output\"\n        #     end\n        #   end\n        def register(&block)\n          class_eval(&block) if block\n        end\n\n        # Defines a new macro with the given name, options and block.\n        #\n        # Options:\n        # * :desc - A description of the macro\n        # * :parse_args => false - Disables arguments parsing (the whole arguments\n        #   string is passed to the macro)\n        #\n        # Macro blocks accept 2 or 3 arguments:\n        # * obj: the object that is rendered (eg. an Issue, a WikiContent...)\n        # * args: macro arguments\n        # * text: the block of text given to the macro (should be present only if the\n        #   macro accepts a block of text). text is a String or nil if the macro is\n        #   invoked without a block of text.\n        #\n        # Examples:\n        # By default, when the macro is invoked, the comma separated list of arguments\n        # is split and passed to the macro block as an array. If no argument is given\n        # the macro will be invoked with an empty array:\n        #\n        #   macro :my_macro do |obj, args|\n        #     # args is an array\n        #     # and this macro do not accept a block of text\n        #   end\n        #\n        # You can disable arguments spliting with the :parse_args => false option. In\n        # this case, the full string of arguments is passed to the macro:\n        #\n        #   macro :my_macro, :parse_args => false do |obj, args|\n        #     # args is a string\n        #   end\n        #\n        # Macro can optionally accept a block of text:\n        #\n        #   macro :my_macro do |obj, args, text|\n        #     # this macro accepts a block of text\n        #   end\n        #\n        # Macros are invoked in formatted text using double curly brackets. Arguments\n        # must be enclosed in parenthesis if any. A new line after the macro name or the\n        # arguments starts the block of text that will be passe to the macro (invoking\n        # a macro that do not accept a block of text with some text will fail).\n        # Examples:\n        #\n        #   No arguments:\n        #   {{my_macro}}\n        #\n        #   With arguments:\n        #   {{my_macro(arg1, arg2)}}\n        #\n        #   With a block of text:\n        #   {{my_macro\n        #   multiple lines\n        #   of text\n        #   }}\n        #\n        #   With arguments and a block of text\n        #   {{my_macro(arg1, arg2)\n        #   multiple lines\n        #   of text\n        #   }}\n        #\n        # If a block of text is given, the closing tag }} must be at the start of a new line.\n        def macro(name, options={}, &block)\n          options.assert_valid_keys(:desc, :parse_args)\n          unless /\\A\\w+\\z/.match?(name.to_s)\n            raise \"Invalid macro name: #{name} (only 0-9, A-Z, a-z and _ characters are accepted)\"\n          end\n          unless block\n            raise \"Can not create a macro without a block!\"\n          end\n\n          name = name.to_s.downcase.to_sym\n          available_macros[name] = {:desc => @@desc || ''}.merge(options)\n          @@desc = nil\n          Definitions.send :define_method, \"macro_#{name}\", &block\n        end\n\n        # Sets description for the next macro to be defined\n        def desc(txt)\n          @@desc = txt\n        end\n      end\n\n      # Builtin macros\n      desc \"Sample macro.\"\n      macro :hello_world do |obj, args, text|\n        h(\n          \"Hello world! Object: #{obj.class.name}, \" +\n          (args.empty? ? \"Called with no argument\" : \"Arguments: #{args.join(', ')}\") +\n          \" and \" + (text.present? ? \"a #{text.size} bytes long block of text.\" : \"no block of text.\")\n        )\n      end\n\n      desc \"Displays a list of all available macros, including description if available.\"\n      macro :macro_list do |obj, args|\n        out = ''.html_safe\n        @@available_macros.each do |macro, options|\n          out << content_tag('dt', content_tag('code', macro.to_s))\n          out << content_tag('dd', content_tag('pre', options[:desc]))\n        end\n        content_tag('dl', out)\n      end\n\n      desc \"Displays a list of child pages. With no argument, it displays the child pages of the current wiki page. Examples:\\n\\n\" +\n             \"{{child_pages}} -- can be used from a wiki page only\\n\" +\n             \"{{child_pages(depth=2)}} -- display 2 levels nesting only\\n\" +\n             \"{{child_pages(Foo)}} -- lists all children of page Foo\\n\" +\n             \"{{child_pages(Foo, parent=1)}} -- same as above with a link to page Foo\"\n      macro :child_pages do |obj, args|\n        args, options = extract_macro_options(args, :parent, :depth)\n        options[:depth] = options[:depth].to_i if options[:depth].present?\n\n        page = nil\n        if args.size > 0\n          page = Wiki.find_page(args.first.to_s, :project => @project)\n        elsif obj.is_a?(WikiContent) || obj.is_a?(WikiContentVersion)\n          page = obj.page\n        else\n          raise t(:error_childpages_macro_no_argument)\n        end\n        raise t(:error_page_not_found) if page.nil? || !User.current.allowed_to?(:view_wiki_pages, page.wiki.project)\n\n        pages = page.self_and_descendants(options[:depth]).group_by(&:parent_id)\n        render_page_hierarchy(pages, options[:parent] ? page.parent_id : page.id)\n      end\n\n      desc \"Displays a list of recently updated wiki pages. With no argument, it displays pages that have been updated within the last 7 days. Examples:\\n\\n\" +\n             \"{{recent_pages}} -- displays pages updated within the last 7 days\\n\" +\n             \"{{recent_pages(days=3)}} -- displays pages updated within the last 3 days\\n\" +\n             \"{{recent_pages(limit=5)}} -- limits the maximum number of pages to display to 5\\n\" +\n             \"{{recent_pages(time=true)}} -- displays pages updated within the last 7 days with updated time\\n\" +\n             \"{{recent_pages(project=identifier)}} -- displays pages updated within the last 7 days from a specific project\\n\" +\n             \"{{recent_pages(include_subprojects=true)}} -- includes pages from subprojects\"\n\n      macro :recent_pages do |obj, args|\n        args, options = extract_macro_options(args, :days, :limit, :time, :project, :include_subprojects)\n\n        if options[:project].presence\n          project = Project.find_by_identifier(options[:project].to_s) if options[:project].present?\n        else\n          project = current_project(obj)\n        end\n\n        return '' if project.nil?\n\n        days_to_list = (options[:days].presence || 7).to_i\n        limit = options[:limit].to_i if options[:limit].present?\n        is_show_time = options[:time].to_s == 'true'\n        if options[:include_subprojects].to_s == 'true'\n          project_ids = project.self_and_descendants.allowed_to(User.current, :view_wiki_pages).pluck(:id)\n        elsif User.current.allowed_to?(:view_wiki_pages, project)\n          project_ids = [project.id]\n        end\n\n        return '' if project_ids.blank?\n\n        pages = WikiPage.\n          joins(:wiki, :content).\n          where(:wikis => {:project_id => project_ids}).\n          where(\"#{WikiContent.table_name}.updated_on >= ?\", days_to_list.days.ago).\n          order(\"#{WikiContent.table_name}.updated_on DESC, #{WikiPage.table_name}.id DESC\").\n          limit(limit)\n\n        tag.ul do\n          pages.each do |page|\n            concat(\n              tag.li do\n                html = link_to(h(page.pretty_title), project_wiki_page_path(page.project, page.title))\n                html << \" (#{time_ago_in_words(page.content.updated_on)})\" if is_show_time\n                html\n              end\n            )\n          end\n        end\n      end\n\n      desc \"Includes a wiki page. Examples:\\n\\n\" +\n             \"{{include(Foo)}}\\n\" +\n             \"{{include(projectname:Foo)}} -- to include a page of a specific project wiki\"\n      macro :include do |obj, args|\n        project = current_project(obj)\n        page = Wiki.find_page(args.first.to_s, :project => project)\n        raise t(:error_page_not_found) if page.nil? || !User.current.allowed_to?(:view_wiki_pages, page.wiki.project)\n\n        @included_wiki_pages ||= []\n        raise t(:error_circular_inclusion) if @included_wiki_pages.include?(page.id)\n\n        @included_wiki_pages << page.id\n        out =\n          textilizable(\n            page.content,\n            :text,\n            :attachments => page.attachments,\n            :headings => false,\n            :inline_attachments => @@inline_attachments\n          )\n        @included_wiki_pages.pop\n        out\n      end\n\n      desc \"Inserts of collapsed block of text. Examples:\\n\\n\" +\n             \"{{collapse\\nThis is a block of text that is collapsed by default.\\nIt can be expanded by clicking a link.\\n}}\\n\\n\" +\n             \"{{collapse(View details...)\\nWith custom link text.\\n}}\"\n      macro :collapse do |obj, args, text|\n        html_id = \"collapse-#{Redmine::Utils.random_hex(4)}\"\n        show_label = args[0] || l(:button_show)\n        hide_label = args[1] || args[0] || l(:button_hide)\n        js = \"$('##{html_id}-show, ##{html_id}-hide').toggle(); $('##{html_id}').fadeToggle(150);\"\n        out = ''.html_safe\n        out << link_to_function(sprite_icon('angle-right', show_label, rtl: true), js, :id => \"#{html_id}-show\", :class => 'icon icon-collapsed collapsible')\n        out <<\n          link_to_function(\n            sprite_icon('angle-down', hide_label), js,\n            :id => \"#{html_id}-hide\",\n            :class => 'icon icon-expanded collapsible',\n            :style => 'display:none;'\n          )\n        out <<\n          content_tag(\n            'div',\n            textilizable(text, :object => obj, :headings => false,\n                         :inline_attachments => @@inline_attachments),\n            :id => html_id, :class => 'collapsed-text',\n            :style => 'display:none;'\n          )\n        out\n      end\n","numLines":305,"startLine":20,"totalLines":389}},"tool_result_meta":[{"id":"toolu_016eF2bQ4Zs7Pa1V3UWXottK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
