@@ -20,6 +20,25 @@
 require_relative '../../../test_helper'
 
 class Redmine::Search::Tokenize < ActiveSupport::TestCase
+  def test_tokenize_should_return_at_most_max_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five six')
+    assert_equal 5, Redmine::Search::Tokenizer::MAX_TOKENS
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert tokenizer.truncated?
+  end
+
+  def test_tokenize_should_not_be_truncated_with_max_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five')
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert_not tokenizer.truncated?
+  end
+
+  def test_tokenize_truncated_should_ignore_duplicate_and_too_short_tokens
+    tokenizer = Redmine::Search::Tokenizer.new('one two three four five one a b')
+    assert_equal %w[one two three four five], tokenizer.tokens
+    assert_not tokenizer.truncated?
+  end
+
   def test_tokenize
     value = "hello \"bye bye\""
     assert_equal ["hello", "bye bye"], Redmine::Search::Tokenizer.new(value).tokens
