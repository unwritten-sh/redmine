diff --git a/app/models/query.rb b/app/models/query.rb
index fc9b62b39..29d588102 100644
--- a/app/models/query.rb
+++ b/app/models/query.rb
@@ -542,6 +542,27 @@ class Query < ApplicationRecord
     end if filters
   end
 
+  # Returns warning messages for filters whose value has more search terms
+  # than the tokenizer can use. Warnings do not make the query invalid.
+  def filter_warnings
+    return [] unless filters
+
+    types = [:string, :text, :search]
+    operators = ["~", "*~", "!~", "^", "$"]
+    filters.each_key.filter_map do |field|
+      next unless types.include?(type_for(field))
+      next unless operators.include?(operator_for(field))
+
+      tokenizer = Redmine::Search::Tokenizer.new(values_for(field)&.first)
+      next unless tokenizer.truncated?
+
+      terms = tokenizer.tokens.map {|t| "\"#{t}\""}.join(l('support.array.words_connector'))
+      "#{label_for(field)}: " +
+        l(:warning_query_filter_max_search_terms,
+          :max => Redmine::Search::Tokenizer::MAX_TOKENS, :terms => terms)
+    end
+  end
+
   def add_filter_error(field, message)
     m = label_for(field) + " " + l(message, :scope => 'activerecord.errors.messages')
     errors.add(:base, m)
