diff --git a/app/models/query.rb b/app/models/query.rb
index fc9b62b39..3ba093822 100644
--- a/app/models/query.rb
+++ b/app/models/query.rb
@@ -547,6 +547,32 @@ class Query < ApplicationRecord
     errors.add(:base, m)
   end
 
+  # Operators whose value is split into search terms (see Query.tokenized_like_conditions)
+  TOKENIZED_OPERATORS = %w[~ *~ !~ ^ $].freeze
+  # Filter types that can use the operators above
+  TOKENIZED_FILTER_TYPES = [:string, :text, :search].freeze
+
+  # Returns a list of warning messages, one for each filter whose value
+  # has more search terms than the tokenizer keeps. Warnings do not make
+  # the query invalid.
+  def filter_warnings
+    return [] unless filters
+
+    filters.each_key.filter_map do |field|
+      next unless TOKENIZED_FILTER_TYPES.include?(type_for(field))
+      next unless TOKENIZED_OPERATORS.include?(operator_for(field))
+
+      tokenizer = Redmine::Search::Tokenizer.new(value_for(field))
+      next unless tokenizer.truncated?
+
+      terms = tokenizer.tokens.map {|token| "\"#{token}\""}.join(l(:'support.array.words_connector'))
+      l(:notice_search_terms_truncated,
+        :filter => label_for(field),
+        :max => Redmine::Search::Tokenizer::MAX_TOKENS,
+        :terms => terms)
+    end
+  end
+
   def editable_by?(user)
     return false unless user
 
