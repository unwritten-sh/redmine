@@ -127,22 +127,38 @@ module Redmine
     end
 
     class Tokenizer
+      # Maximum number of tokens returned by #tokens
+      MAX_TOKENS = 5
+
       def initialize(question)
         @question = question.to_s
       end
 
+      # Returns at most MAX_TOKENS tokens extracted from the question
