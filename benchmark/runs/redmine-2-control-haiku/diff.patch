+  def test_filter_warnings_should_be_empty_without_truncated_terms
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('subject', '~', ['one two three four five'])
+    assert_equal [], query.filter_warnings
+  end
+
+  def test_filter_warnings_should_warn_when_contains_value_has_too_many_terms
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('subject', '~', ['one two three four five six seven'])
+    assert_equal [
+      'Subject: A maximum of 5 search terms can be used. Only the following terms were used: "one", "two", "three", "four", "five"'
+    ], query.filter_warnings
+  end
+
+  def test_filter_warnings_should_warn_for_all_tokenized_operators
+    %w[~ *~ !~ ^ $].each do |operator|
+      query = IssueQuery.new(:project => nil, :name => '_')
+      query.add_filter('subject', operator, ['one two three four five six'])
+      assert_equal 1, query.filter_warnings.size, "no warning for operator #{operator}"
+    end
+  end
+
+  def test_filter_warnings_should_not_warn_for_other_operators
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('subject', '=', ['one two three four five six'])
+    assert_equal [], query.filter_warnings
+  end
+
+  def test_filter_warnings_should_not_warn_for_non_text_filters
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('estimated_hours', '=', ['1 2 3 4 5 6'])
+    assert_equal [], query.filter_warnings
+  end
+
+  def test_filter_warnings_should_warn_for_text_and_search_filters
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('description', '~', ['one two three four five six'])
+    query.add_filter('any_searchable', '~', ['one two three four five six'])
+    assert_equal [
+      'Description: A maximum of 5 search terms can be used. Only the following terms were used: "one", "two", "three", "four", "five"',
+      'Any searchable text: A maximum of 5 search terms can be used. Only the following terms were used: "one", "two", "three", "four", "five"'
+    ], query.filter_warnings
+  end
+
+  def test_filter_warnings_should_count_quoted_phrases_as_one_term
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('subject', '~', ['"one two" three four five six seven'])
+    assert_equal [
+      'Subject: A maximum of 5 search terms can be used. Only the following terms were used: "one two", "three", "four", "five", "six"'
+    ], query.filter_warnings
+  end
+
+  def test_filter_warnings_should_not_make_the_query_invalid_or_stop_it_from_running
+    issue = Issue.generate!(:subject => 'one two three four five')
+    query = IssueQuery.new(:project => nil, :name => '_')
+    query.add_filter('subject', '~', ['one two three four five six'])
+    assert query.valid?
+    assert_equal 1, query.filter_warnings.size
+    assert_include issue, query.issues
+  end
