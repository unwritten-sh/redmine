diff --git a/test/unit/lib/redmine/search_test.rb b/test/unit/lib/redmine/search_test.rb
index e2d77cca0..220e5c123 100644
--- a/test/unit/lib/redmine/search_test.rb
+++ b/test/unit/lib/redmine/search_test.rb
@@ -35,4 +35,32 @@ class Redmine::Search::Tokenize < ActiveSupport::TestCase
     value = '"phrase one" "phrase two"'
     assert_equal ["phrase one", "phrase two"], Redmine::Search::Tokenizer.new(value).tokens
   end
+
+  def test_tokenize_should_return_at_most_max_tokens
+    assert_equal 5, Redmine::Search::Tokenizer::MAX_TOKENS
+    value = "one two three four five six seven"
+    assert_equal %w[one two three four five], Redmine::Search::Tokenizer.new(value).tokens
+  end
+
+  def test_truncated_should_be_false_when_there_are_max_tokens_or_less
+    assert_equal false, Redmine::Search::Tokenizer.new("one two three four five").truncated?
+    assert_equal false, Redmine::Search::Tokenizer.new("one two").truncated?
+    assert_equal false, Redmine::Search::Tokenizer.new("").truncated?
+    assert_equal false, Redmine::Search::Tokenizer.new(nil).truncated?
+  end
+
+  def test_truncated_should_be_true_when_there_are_more_than_max_tokens
+    assert_equal true, Redmine::Search::Tokenizer.new("one two three four five six").truncated?
+  end
+
+  def test_truncated_should_ignore_duplicated_and_short_tokens
+    # "a" is too short and "one" is repeated, so there are only 5 tokens
+    assert_equal false, Redmine::Search::Tokenizer.new("one one a two three four five").truncated?
+  end
+
+  def test_truncated_should_count_phrases_as_one_token
+    value = '"one two" three four five "six seven"'
+    assert_equal false, Redmine::Search::Tokenizer.new(value).truncated?
+    assert_equal ['one two', 'three', 'four', 'five', 'six seven'], Redmine::Search::Tokenizer.new(value).tokens
+  end
 end
