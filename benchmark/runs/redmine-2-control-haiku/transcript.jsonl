 nil, :name => '_')\n    query.add_filter('description', '~', ['one two three four five six'])\n    query.add_filter('any_searchable', '~', ['one two three four five six'])\n    assert_equal [\n      'Description: A maximum of 5 search terms can be used. Only the following terms were used: \"one\", \"two\", \"three\", \"four\", \"five\"',\n      'Any searchable field: A maximum of 5 search terms can be used. Only the following terms were used: \"one\", \"two\", \"three\", \"four\", \"five\"'\n    ], query.filter_warnings\n  end\n\n  def test_filter_warnings_should_escape_nothing_but_keep_quoted_phrases_as_one_term\n    query = IssueQuery.new(:project => nil, :name => '_')\n    query.add_filter('subject', '~', ['\"one two\" three four five six'])\n    assert_equal [\n      'Subject: A maximum of 5 search terms can be used. Only the following terms were used: \"one two\", \"three\", \"four\", \"five\"'.sub(', \"four\", \"five\"', ', \"four\", \"five\"')\n    ].map {|m| m.sub(', \"four\", \"five\"', ', \"four\", \"five\"')}.size, 1\n    assert_match(/Only the following terms were used: \"one two\", \"three\", \"four\", \"five\"\\\\z/, query.filter_warnings.first)\n  end\n\n  def test_filter_warnings_should_not_make_the_query_invalid_or_stop_it_from_running\n    issue = Issue.generate!(:subject => 'one two three four five')\n    query = IssueQuery.new(:project => nil, :name => '_')\n    query.add_filter('subject', '~', ['one two three four five six'])\n    assert query.valid?\n    assert_equal 1, query.filter_warnings.size\n    assert_include issue, query.issues\n  end\n\n'''\nassert s.count(anchor)==1\ns=s.replace(anchor,new_tests+anchor)\nopen(p,'w').write(s)\nEOF\necho done","description":"Insert query filter_warnings unit tests"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2170,"cache_read_input_tokens":59929,"cache_creation":{"ephemeral_5m_input_tok