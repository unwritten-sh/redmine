ect_id => 1,\n        :set_filter => 1,\n        :f => ['subject'],\n        :op => {'subject' => '~'},\n        :v => {'subject' => ['alpha beta gamma delta epsilon']}\n      }\n    )\n    assert_response :success\n    assert_select 'p.warning', :count => 0\n  end\n'''\ninsert_before_last_end('test/functional/issues_controller_test.rb', issues)\n\ngantt = '''\n  def test_gantt_should_show_search_terms_warning_with_results\n    get(\n      :show,\n      :params => {\n        :project_id => 1,\n        :set_filter => 1,\n        :f => ['subject'],\n        :op => {'subject' => '~'},\n        :v => {'subject' => ['one two three four five six']}\n      }\n    )\n    assert_response :success\n    assert_select 'p.warning', :text => /Subject: A maximum of 5 search terms can be used/\n    assert_select 'p.warning', :text => /\"one\", \"two\", \"three\", \"four\", \"five\"/\n  end\n'''\ninsert_before_last_end('test/functional/gantts_controller_test.rb', gantt)\n\ncal = '''\n  def test_show_should_show_search_terms_warning_with_results\n    travel_to issues(:issues_002).start_date\n    get(\n      :show,\n      :params => {\n        :project_id => 1,\n        :set_filter => 1,\n        :f => ['subject'],\n        :op => {'subject' => '~'},\n        :v => {'subject' => ['one two three four five six']}\n      }\n    )\n    assert_response :success\n    assert_select 'p.warning', :text => /Subject: A maximum of 5 search terms can be used/\n    assert_select 'ul.cal'\n  end\n'''\ninsert_before_last_end('test/functional/calendars_controller_test.rb', cal)\nprint(\"ok\")\nEOF\ntail -5 test/functional/calendars_controller_test.rb","description":"Add functional tests for issues, gantt and calendar warnings"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":846,"cache_read_input_tokens":69139,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":846}