{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YNxn54q6Xvi9QsG3YqABbV","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\t# Redmine - project management software\n4\t# Copyright (C) 2006-  Jean-Philippe Lang\n5\t#\n6\t# This program is free software; you can redistribute it and/or\n7\t# modify it under the terms of the GNU General Public License\n8\t# as published by the Free Software Foundation; either version 2\n9\t# of the License, or (at your option) any later version.\n10\t#\n11\t# This program is distributed in the hope that it will be useful,\n12\t# but WITHOUT ANY WARRANTY; without even the implied warranty of\n13\t# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n14\t# GNU General Public License for more details.\n15\t#\n16\t# You should have received a copy of the GNU General Public License\n17\t# along with this program; if not, write to the Free Software\n18\t# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n19\t\n20\trequire_relative '../../../test_helper'\n21\t\n22\tclass Redmine::WikiToolbarTest < Redmine::HelperTest\n23\t  include ApplicationHelper\n24\t\n25\t  def test_wikitoolbar_for_should_render_toolbar_for_the_field\n26\t    with_settings :text_formatting => 'common_mark' do\n27\t      html = wikitoolbar_for('issue_description', '/issues/preview')\n28\t\n29\t      assert_select_in html, 'div.jstBlock[hidden][data-controller=?]', 'wiki-toolbar' do\n30\t        assert_select '[data-wiki-toolbar-field-id-value=?]', 'issue_description'\n31\t        assert_select '[data-wiki-toolbar-preview-url-value=?]', '/issues/preview'\n32\t        assert_select '[data-wiki-toolbar-help-url-value=?]', '/help/wiki_syntax'\n33\t        assert_select 'div.jstTabs ul[role=tablist]' do\n34\t          assert_select 'a.tab-edit.selected[aria-selected=true]', :text => 'Edit'\n35\t          assert_select 'a.tab-preview[aria-selected=false]', :text => 'Preview'\n36\t          assert_select 'div.jstElements'\n37\t        end\n38\t        assert_select 'div.jstEditor div.wiki-preview.hidden#preview_issue_description'\n39\t      end\n40\t    end\n41\t  end\n42\t\n43\t  def test_wikitoolbar_for_should_render_nothing_without_text_formatting\n44\t    with_settings :text_formatting => '' do\n45\t      assert_nil wikitoolbar_for('issue_description')\n46\t    end\n47\t  end\n48\t\n49\t  def test_common_mark_buttons\n50\t    with_settings :text_formatting => 'common_mark' do\n51\t      html = wikitoolbar_for('issue_description')\n52\t\n53\t      assert_select_in html, 'div.jstElements' do\n54\t        assert_select 'button', 19\n55\t        assert_select 'span.jstSpacer', 5\n56\t        assert_select 'button.jstb_strong[title=?][data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-shortcut=b]',\n57\t                      'Strong', 'wiki-toolbar#wrap', '**'\n58\t        assert_select 'button.jstb_ins[data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-suffix-param=?]', '<u>', '</u>'\n59\t        assert_select 'button.jstb_h1[data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-strip-param=?]',\n60\t                      'wiki-toolbar#wrapLines', '# ', '^#+\\s+'\n61\t        assert_select 'button.jstb_tl[data-wiki-toolbar-replacement-param=?]', '* [ ] '\n62\t        assert_select 'button.jstb_table[data-action=?][data-wiki-toolbar-menu-param=table][data-wiki-toolbar-separator-cell-param=?]',\n63\t                      'wiki-toolbar#toggleMenu', '--'\n64\t        assert_select 'button.jstb_precode[data-wiki-toolbar-menu-param=precode]:not([data-wiki-toolbar-prefix-param])'\n65\t        assert_select 'button.jstb_help[data-action=?]', 'wiki-toolbar#help'\n66\t      end\n67\t    end\n68\t  end\n69\t\n70\t  def test_textile_buttons\n71\t    with_settings :text_formatting => 'textile' do\n72\t      html = wikitoolbar_for('issue_description')\n73\t\n74\t      assert_select_in html, 'div.jstElements' do\n75\t        assert_select 'button', 18\n76\t        assert_select 'button.jstb_tl', 0\n77\t        assert_select 'button.jstb_strong[data-wiki-toolbar-prefix-param=?]', '*'\n78\t        assert_select 'button.jstb_ol[data-wiki-toolbar-replacement-param=?]', '# '\n79\t        assert_select 'button.jstb_table[data-wiki-toolbar-header-cell-param=?]:not([data-wiki-toolbar-separator-cell-param])', '_.%{name}'\n80\t      end\n81\t    end\n82\t  end\n83\t\n84\t  def test_buttons_should_be_translated\n85\t    with_settings :text_formatting => 'common_mark' do\n86\t      set_language_if_valid 'fr'\n87\t      html = wikitoolbar_for('issue_description')\n88\t\n89\t      assert_select_in html, 'a.tab-edit', :text => ::I18n.t(:button_edit, :locale => 'fr')\n90\t      assert_select_in html, 'button.jstb_strong[title=?]', ::I18n.t(:label_wiki_toolbar_strong, :locale => 'fr')\n91\t    end\n92\t  end\n93\t\n94\t  def test_keyboard_shortcuts\n95\t    with_settings :text_formatting => 'common_mark' do\n96\t      html = wikitoolbar_for('issue_description')\n97\t      actions = Nokogiri::HTML.fragment(html).at_css('div.jstBlock')['data-action'].split\n98\t\n99\t      %w[b i u].each do |key|\n100\t        assert_include \"keydown.ctrl+#{key}->wiki-toolbar#shortcut\", actions\n101\t        assert_include \"keydown.meta+#{key}->wiki-toolbar#shortcut\", actions\n102\t      end\n103\t      assert_include 'keydown.ctrl+shift+p@window->wiki-toolbar#togglePreview', actions\n104\t      assert_include 'keydown.meta+shift+p@window->wiki-toolbar#togglePreview', actions\n105\t    end\n106\t  end\n107\t\n108\t  def test_precode_menu_should_list_the_user_languages\n109\t    User.current = User.find(2)\n110\t    User.current.pref.update!(:toolbar_language_options => 'ruby,python')\n111\t\n112\t    with_settings :text_formatting => 'textile' do\n113\t      html = wikitoolbar_for('issue_description')\n114\t\n115\t      assert_select_in html, 'template[data-wiki-toolbar-target=precodeMenu] ul.jstMenu[role=menu]' do\n116\t        assert_select 'button[role=menuitem][data-action=?]', 'wiki-toolbar#wrapLines', :count => 2\n117\t      end\n118\t      item = Nokogiri::HTML.fragment(html).at_css('ul.jstMenu button')\n119\t      assert_equal 'ruby', item.text\n120\t      assert_equal %(<pre><code class=\"ruby\">\\n), item['data-wiki-toolbar-prefix-param']\n121\t      assert_equal \"\\n</code></pre>\\n\", item['data-wiki-toolbar-suffix-param']\n122\t    end\n123\t  end\n124\t\n125\t  def test_table_menu\n126\t    with_settings :text_formatting => 'common_mark' do\n127\t      html = wikitoolbar_for('issue_description')\n128\t\n129\t      assert_select_in html, 'template[data-wiki-toolbar-target=tableMenu] table.table-generator' do\n130\t        assert_select 'tr', 5\n131\t        assert_select 'td button', 50\n132\t        assert_select 'td button[title=?][data-action=?][data-wiki-toolbar-cols-param=\"3\"][data-wiki-toolbar-rows-param=\"2\"]',\n133\t                      '3×2', 'wiki-toolbar#insertTable'\n134\t      end\n135\t    end\n136\t  end\n137\t\n138\t  def test_heads_for_wiki_formatter_should_only_define_image_mime_types\n139\t    with_settings :text_formatting => 'common_mark' do\n140\t      heads_for_wiki_formatter\n141\t      heads_for_wiki_formatter\n142\t      header_tags = content_for(:header_tags)\n143\t\n144\t      assert_include 'var wikiImageMimeTypes = ', header_tags\n145\t      assert_equal 1, header_tags.scan('wikiImageMimeTypes').size\n146\t      assert_not_include 'jstoolbar', header_tags\n147\t    end\n148\t  end\n149\tend\n150\t"}]},"parent_tool_use_id":null,"session_id":"fc4df5e4-a75f-4eef-8855-4e8a00111d19","uuid":"c1c7b1de-def9-4869-be77-aff4ac18948a","timestamp":"2026-11-01T21:33:40.342Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/redmine/bench/trees/redmine-1-harness/test/unit/lib/redmine/wiki_toolbar_test.rb","content":"# frozen_string_literal: true\n\n# Redmine - project management software\n# Copyright (C) 2006-  Jean-Philippe Lang\n#\n# This program is free software; you can redistribute it and/or\n# modify it under the terms of the GNU General Public License\n# as published by the Free Software Foundation; either version 2\n# of the License, or (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with this program; if not, write to the Free Software\n# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.\n\nrequire_relative '../../../test_helper'\n\nclass Redmine::WikiToolbarTest < Redmine::HelperTest\n  include ApplicationHelper\n\n  def test_wikitoolbar_for_should_render_toolbar_for_the_field\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description', '/issues/preview')\n\n      assert_select_in html, 'div.jstBlock[hidden][data-controller=?]', 'wiki-toolbar' do\n        assert_select '[data-wiki-toolbar-field-id-value=?]', 'issue_description'\n        assert_select '[data-wiki-toolbar-preview-url-value=?]', '/issues/preview'\n        assert_select '[data-wiki-toolbar-help-url-value=?]', '/help/wiki_syntax'\n        assert_select 'div.jstTabs ul[role=tablist]' do\n          assert_select 'a.tab-edit.selected[aria-selected=true]', :text => 'Edit'\n          assert_select 'a.tab-preview[aria-selected=false]', :text => 'Preview'\n          assert_select 'div.jstElements'\n        end\n        assert_select 'div.jstEditor div.wiki-preview.hidden#preview_issue_description'\n      end\n    end\n  end\n\n  def test_wikitoolbar_for_should_render_nothing_without_text_formatting\n    with_settings :text_formatting => '' do\n      assert_nil wikitoolbar_for('issue_description')\n    end\n  end\n\n  def test_common_mark_buttons\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'div.jstElements' do\n        assert_select 'button', 19\n        assert_select 'span.jstSpacer', 5\n        assert_select 'button.jstb_strong[title=?][data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-shortcut=b]',\n                      'Strong', 'wiki-toolbar#wrap', '**'\n        assert_select 'button.jstb_ins[data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-suffix-param=?]', '<u>', '</u>'\n        assert_select 'button.jstb_h1[data-action=?][data-wiki-toolbar-prefix-param=?][data-wiki-toolbar-strip-param=?]',\n                      'wiki-toolbar#wrapLines', '# ', '^#+\\s+'\n        assert_select 'button.jstb_tl[data-wiki-toolbar-replacement-param=?]', '* [ ] '\n        assert_select 'button.jstb_table[data-action=?][data-wiki-toolbar-menu-param=table][data-wiki-toolbar-separator-cell-param=?]',\n                      'wiki-toolbar#toggleMenu', '--'\n        assert_select 'button.jstb_precode[data-wiki-toolbar-menu-param=precode]:not([data-wiki-toolbar-prefix-param])'\n        assert_select 'button.jstb_help[data-action=?]', 'wiki-toolbar#help'\n      end\n    end\n  end\n\n  def test_textile_buttons\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'div.jstElements' do\n        assert_select 'button', 18\n        assert_select 'button.jstb_tl', 0\n        assert_select 'button.jstb_strong[data-wiki-toolbar-prefix-param=?]', '*'\n        assert_select 'button.jstb_ol[data-wiki-toolbar-replacement-param=?]', '# '\n        assert_select 'button.jstb_table[data-wiki-toolbar-header-cell-param=?]:not([data-wiki-toolbar-separator-cell-param])', '_.%{name}'\n      end\n    end\n  end\n\n  def test_buttons_should_be_translated\n    with_settings :text_formatting => 'common_mark' do\n      set_language_if_valid 'fr'\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'a.tab-edit', :text => ::I18n.t(:button_edit, :locale => 'fr')\n      assert_select_in html, 'button.jstb_strong[title=?]', ::I18n.t(:label_wiki_toolbar_strong, :locale => 'fr')\n    end\n  end\n\n  def test_keyboard_shortcuts\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n      actions = Nokogiri::HTML.fragment(html).at_css('div.jstBlock')['data-action'].split\n\n      %w[b i u].each do |key|\n        assert_include \"keydown.ctrl+#{key}->wiki-toolbar#shortcut\", actions\n        assert_include \"keydown.meta+#{key}->wiki-toolbar#shortcut\", actions\n      end\n      assert_include 'keydown.ctrl+shift+p@window->wiki-toolbar#togglePreview', actions\n      assert_include 'keydown.meta+shift+p@window->wiki-toolbar#togglePreview', actions\n    end\n  end\n\n  def test_precode_menu_should_list_the_user_languages\n    User.current = User.find(2)\n    User.current.pref.update!(:toolbar_language_options => 'ruby,python')\n\n    with_settings :text_formatting => 'textile' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=precodeMenu] ul.jstMenu[role=menu]' do\n        assert_select 'button[role=menuitem][data-action=?]', 'wiki-toolbar#wrapLines', :count => 2\n      end\n      item = Nokogiri::HTML.fragment(html).at_css('ul.jstMenu button')\n      assert_equal 'ruby', item.text\n      assert_equal %(<pre><code class=\"ruby\">\\n), item['data-wiki-toolbar-prefix-param']\n      assert_equal \"\\n</code></pre>\\n\", item['data-wiki-toolbar-suffix-param']\n    end\n  end\n\n  def test_table_menu\n    with_settings :text_formatting => 'common_mark' do\n      html = wikitoolbar_for('issue_description')\n\n      assert_select_in html, 'template[data-wiki-toolbar-target=tableMenu] table.table-generator' do\n        assert_select 'tr', 5\n        assert_select 'td button', 50\n        assert_select 'td button[title=?][data-action=?][data-wiki-toolbar-cols-param=\"3\"][data-wiki-toolbar-rows-param=\"2\"]',\n                      '3×2', 'wiki-toolbar#insertTable'\n      end\n    end\n  end\n\n  def test_heads_for_wiki_formatter_should_only_define_image_mime_types\n    with_settings :text_formatting => 'common_mark' do\n      heads_for_wiki_formatter\n      heads_for_wiki_formatter\n      header_tags = content_for(:header_tags)\n\n      assert_include 'var wikiImageMimeTypes = ', header_tags\n      assert_equal 1, header_tags.scan('wikiImageMimeTypes').size\n      assert_not_include 'jstoolbar', header_tags\n    end\n  end\nend\n","numLines":150,"startLine":1,"totalLines":150}},"tool_result_meta":[{"id":"toolu_01YNxn54q6Xvi9QsG3YqABbV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
