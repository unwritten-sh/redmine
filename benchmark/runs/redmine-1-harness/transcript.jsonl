{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M9wGfoijJtKfXgjjdLAY7f","type":"tool_result","content":"1\t/**\n2\t * Redmine - project management software\n3\t * Copyright (C) 2006-  Jean-Philippe Lang\n4\t * This code is released under the GNU General Public License.\n5\t */\n6\timport { Controller } from '@hotwired/stimulus'\n7\t\n8\tconst isMac = /mac|iphone|ipad/i.test(navigator.userAgentData?.platform || navigator.platform)\n9\t\n10\t// Wiki toolbar rendered by Redmine::WikiToolbar.\n11\t//\n12\t// The toolbar is rendered after the textarea and moves itself to the\n13\t// textarea's position on connect, so that existing views only need to call\n14\t// wikitoolbar_for. The text formatting syntax is given by the button\n15\t// parameters, so this controller is shared by all text formatters.\n16\texport default class extends Controller {\n17\t  static targets = ['editor', 'preview', 'editTab', 'previewTab', 'toolbar', 'precodeMenu', 'tableMenu']\n18\t  static values = {\n19\t    fieldId: String,\n20\t    previewUrl: String,\n21\t    helpUrl: String\n22\t  }\n23\t\n24\t  // Editor whose preview was displayed last, switched back to edit mode\n25\t  // using the Ctrl/Cmd+Shift+P shortcut from outside of the textareas\n26\t  static lastPreviewed = null\n27\t\n28\t  connect() {\n29\t    this.field = document.getElementById(this.fieldIdValue)\n30\t    if (!this.field) return\n31\t\n32\t    if (!this.editorTarget.contains(this.field)) {\n33\t      // Moving the element reconnects the controller\n34\t      this.field.before(this.element)\n35\t      this.editorTarget.prepend(this.field)\n36\t    }\n37\t    this.addShortcutsToTitles()\n38\t    this.element.hidden = false\n39\t  }\n40\t\n41\t  disconnect() {\n42\t    this.closeMenu()\n43\t    if (this.constructor.lastPreviewed === this) this.constructor.lastPreviewed = null\n44\t  }\n45\t\n46\t  // Actions\n47\t\n48\t  wrap({ params: { prefix, suffix } }) {\n49\t    this.encloseSelection(String(prefix), String(suffix ?? prefix))\n50\t  }\n51\t\n52\t  wrapLines({ params: { prefix = '', suffix = '', strip, pattern, replacement = '' } }) {\n53\t    this.encloseLineSelection(String(prefix), String(suffix), (str) => {\n54\t      if (strip) {\n55\t        str = str.replace(new RegExp(strip), '')\n56\t      }\n57\t      if (pattern) {\n58\t        str = str.replace(/\\r/g, '').replace(new RegExp(`(\\\\n|^)${pattern}`, 'g'), `$1${replacement}`)\n59\t      }\n60\t      return str\n61\t    })\n62\t  }\n63\t\n64\t  help() {\n65\t    window.open(this.helpUrlValue, '', 'resizable=yes, location=no, width=300, height=640, menubar=no, status=no, scrollbars=yes')\n66\t  }\n67\t\n68\t  shortcut(event) {\n69\t    if (event.target !== this.field || !(isMac ? event.metaKey : event.ctrlKey)) return\n70\t\n71\t    const button = this.toolbarTarget.querySelector(`[data-wiki-toolbar-shortcut=\"${event.key.toLowerCase()}\"]`)\n72\t    if (button) {\n73\t      event.preventDefault()\n74\t      button.click()\n75\t    }\n76\t  }\n77\t\n78\t  // Preview\n79\t\n80\t  edit() {\n81\t    if (!this.previewing) return\n82\t\n83\t    this.previewRequest = null\n84\t    this.previewTarget.classList.add('hidden')\n85\t    this.field.classList.remove('hidden')\n86\t    this.toolbarTarget.classList.remove('hidden')\n87\t    this.selectTab(this.editTabTarget, this.previewTabTarget)\n88\t    this.field.focus()\n89\t  }\n90\t\n91\t  async preview() {\n92\t    if (this.previewing) return\n93\t\n94\t    this.constructor.lastPreviewed = this\n95\t    this.previewTarget.style.minHeight = `${this.field.clientHeight}px`\n96\t    this.field.classList.add('hidden')\n97\t    this.toolbarTarget.classList.add('hidden')\n98\t    this.previewTarget.classList.remove('hidden')\n99\t    this.selectTab(this.previewTabTarget, this.editTabTarget)\n100\t    this.closeMenu()\n101\t\n102\t    const request = this.previewRequest = this.fetchPreview()\n103\t    const html = await request\n104\t    if (request === this.previewRequest && html !== null) {\n105\t      this.previewTarget.innerHTML = html\n106\t    }\n107\t  }\n108\t\n109\t  togglePreview(event) {\n110\t    if (event.target === this.field) {\n111\t      event.preventDefault()\n112\t      this.preview()\n113\t    } else if (this.constructor.lastPreviewed === this && !event.target.closest?.('.jstEditor')) {\n114\t      event.preventDefault()\n115\t      this.constructor.lastPreviewed = null\n116\t      this.edit()\n117\t    }\n118\t  }\n119\t\n120\t  // Menus\n121\t\n122\t  toggleMenu({ currentTarget, params }) {\n123\t    const opened = this.menu?.dataset.name === params.menu\n124\t    this.closeMenu()\n125\t    if (opened) return\n126\t\n127\t    const template = this[`${params.menu}MenuTarget`]\n128\t    this.menu = template.content.firstElementChild.cloneNode(true)\n129\t    this.menu.dataset.name = params.menu\n130\t    this.menuParams = params\n131\t    this.element.append(this.menu)\n132\t    this.positionMenu(currentTarget)\n133\t\n134\t    this.closeMenuOnOutsideClick = (event) => {\n135\t      if (!this.menu.contains(event.target) && !currentTarget.contains(event.target)) this.closeMenu()\n136\t    }\n137\t    document.addEventListener('mousedown', this.closeMenuOnOutsideClick)\n138\t    this.menu.querySelector('button')?.focus()\n139\t  }\n140\t\n141\t  closeMenu() {\n142\t    if (!this.menu) return\n143\t\n144\t    document.removeEventListener('mousedown', this.closeMenuOnOutsideClick)\n145\t    this.menu.remove()\n146\t    this.menu = null\n147\t    this.closeMenuOnOutsideClick = null\n148\t  }\n149\t\n150\t  insertTable({ params: { cols, rows } }) {\n151\t    const { headerCell, separatorCell } = this.menuParams\n152\t    const names = 'ABCDEFGHIJ'.slice(0, cols).split('')\n153\t    const line = (cells) => `|${cells.join('|')}|\\n`\n154\t\n155\t    let table = line(names.map((name) => String(headerCell).replace('%{name}', name)))\n156\t    if (separatorCell) table += line(Array(cols).fill(separatorCell))\n157\t 