+  def test_buttons_should_insert_the_syntax_of_the_text_formatter
+    log_user('jsmith', 'jsmith')
+    {
+      'common_mark' => {
+        'strong' => '**text**', 'em' => '*text*', 'ins' => '<u>text</u>', 'del' => '~~text~~',
