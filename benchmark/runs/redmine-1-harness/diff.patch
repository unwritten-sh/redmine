+        'ul' => '* text', 'ol' => '1. text', 'tl' => '* [ ] text', 'bq' => '> text',
+        'pre' => "```\ntext\n```", 'link' => '[[text]]', 'img' => '![](text)'
+      },
+      'textile' => {
+        'strong' => '*text*', 'em' => '_text_', 'ins' => '+text+', 'del' => '-text-',
+        'code' => '@text@', 'h1' => 'h1. text', 'h2' => 'h2. text', 'h3' => 'h3. text',
+        'ul' => '* text', 'ol' => '# text', 'bq' => '> text',
+        'pre' => "<pre>\ntext\n</pre>", 'link' => '[[text]]', 'img' => '!text!'
+      }
