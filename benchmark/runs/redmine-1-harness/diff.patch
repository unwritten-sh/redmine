+          assert_equal value, find('#issue_description').value, "#{formatting} #{button}"
+        end
+        fill_in 'Description', :with => 'h2. text'
+        find('button.jstb_h1').click
+        assert_equal(formatting == 'textile' ? 'h1. text' : '# h2. text', find('#issue_description').value)
+      end
+    end
+  end
