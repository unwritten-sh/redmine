# Redmine does not read a .env file. Most settings live in YAML files that git
# ignores; copy them from their examples:
#   config/database.yml       <- config/database.yml.example (bin/harness setup writes a SQLite3 one)
#   config/configuration.yml  <- config/configuration.yml.example (SMTP, attachments path, SCM commands, ...)
#   config/additional_environment.rb <- config/additional_environment.rb.example
# This file lists the environment variables that the code, tests and Rake tasks
# read. Export them in your shell when you need them. Values below are safe local defaults.

# --- Application (config/environments/*.rb, config/boot.rb) ---
RAILS_ENV=development
# Production only: log to STDOUT instead of log/production.log when set.
RAILS_LOG_TO_STDOUT=
# Raise Rack query parser limits (config/boot.rb sets these defaults).
RACK_QUERY_PARSER_BYTESIZE_LIMIT=33554432
RACK_QUERY_PARSER_PARAMS_LIMIT=65536

# --- Rake tasks (lib/tasks) ---
# Language for redmine:load_default_data (asked interactively when empty).
REDMINE_LANG=en
# Test repositories that ci:setup creates, comma separated (default: all).
SCMS=git,git_utf8,filesystem,subversion

# --- Tests (test/test_helper.rb, test/application_system_test_case.rb) ---
# Test processes for bin/rails test (bin/harness check-fast defaults to the CPU count).
PARALLEL_WORKERS=
# Run tests with SimpleCov coverage when set.
COVERAGE=
# LDAP server used by the LDAP tests (test/fixtures/auth_sources.yml); they skip without it.
REDMINE_TEST_LDAP_SERVER=127.0.0.1
# Plugins folder for tests (test:autoload sets test/fixtures/plugins).
REDMINE_PLUGINS_DIRECTORY=
# System tests: Chrome options, comma separated (CI: headless,disable-gpu,no-sandbox,disable-dev-shm-usage).
GOOGLE_CHROME_OPTS_ARGS=
# System tests against a remote Selenium server.
SELENIUM_REMOTE_URL=
CAPYBARA_SERVER_HOST=
CAPYBARA_SERVER_PORT=
CAPYBARA_APP_HOST=
