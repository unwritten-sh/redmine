ew(database_config).result\n  end\n\n  adapters = database_config.scan(/^ *adapter: *(.*)/).flatten.uniq\n  if adapters.any?\n    adapters.each do |adapter|\n      case adapter.strip\n      when /mysql2/\n        gem 'mysql2', '~> 0.5.0'\n        gem \"with_advisory_lock\"\n      when /trilogy/\n        gem 'trilogy', '~> 2.12.4'\n        gem \"with_advisory_lock\"\n{\n  \"dependencies\": {},\n  \"devDependencies\": {\n    \"stylelint\": \"^16.10.0\"\n  }\n}\nname: Lint\n\non:\n  push:\n\njobs:\n  lint:\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v6\n\n      - name: Set up Ruby\n        uses: ruby/setup-ruby@v1\n        with:\n          ruby-version: 3.3\n          bundler-cache: true\n\n      - name: Lint code for consistent style\n        run: bundle exec rubocop --parallel\n\n  stylelint:\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v6\n\n      - name: Set up Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '20'\n\n      - name: Install dependencies\n        run: yarn install\n\n      - name: Lint CSS and SCSS files\n        run: npx stylelint \"app/assets/stylesheets/**/*.css\"\n\n  bundle-audit:\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v6\n\n      - name: Set up Ruby\n        uses: ruby/setup-ruby@v1\n        with:\n          ruby-version: '3.3'\n          bundler-cache: true\n\n      - name: Run bundle-audit\n        run: bundle exec bundle audit check --update\nname: Tests\n\non:\n  push:\n\njobs:\n  tests:\n    name: test ${{matrix.db}} ruby-${{ matrix.ruby }}\n    runs-on: ubuntu-latest\n\n    strategy:\n      matrix:\n        ruby: ['3.3', '3.4', '4.0']\n        db: ['postgresql', 'mysql2', 'sqlite3']\n      fail-fast: false\n\n    services:\n      postgres:\n        image: postgres:14\n        env:\n          POSTGRES_DB: redmine_test\n          POSTGRES_USER: root\n          POSTGRES_PASSWORD: root\n        ports:\n          - 5432:5432\n        options: >-\n          --health-cmd pg_isready\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n\n      mysql:\n        image: mysql:8.4\n        env:\n          MYSQL_DATABASE: redmine_test\n          MYSQL_ROOT_PASSWORD: 'root'\n        ports:\n          - 3306:3306\n        options: >-\n          --health-cmd=\"mysqladmin ping\"\n          --health-interval=10s\n          --health-timeout=5s\n          --health-retries=3\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v6\n\n      - name: Setup Redmine test environment\n        uses: ./.github/actions/setup-redmine\n        with:\n          db-type: ${{ matrix.db }}\n          ruby-version: ${{ matrix.ruby }}\n\n      - name: Run tests\n        run: |\n          bin/rails test\n\n      - name: Run bazaar non ascii test\n        env:\n          LANG: en_US.ISO8859-1\n          LC_ALL: en_US.ISO8859-1\n        run: |\n          bin/rails test test/unit/repository_bazaar_test.rb\n\n      - name: Run autoload test\n        run: |\n          bin/rails test:autoload\n\n  system-tests:\n    name: system test\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v6\n\n      - name: Setup Redmine test environment\n        uses: ./.github/actions/setup-redmine\n        with:\n          db-type: sqlite3\n          ruby-version: '4.0'\n\n      # System tests use Chrome and ChromeDriver installed on the GitHub Actions Ubuntu image.\n      # They are generally updated to the latest stable versions.\n      - name: Display Chrome version\n        run: google-chrome --version\n\n      - name: Install Mermaid.js for the mermaid rendering tests\n        run: bin/rails redmine:mermaid:install RAILS_ENV=test\n\n      - name: Run system tests\n        run: bin/rails test:system\n        env:\n          GOOGLE_CHROME_OPTS_ARGS: headless,disable-gpu,no-sandbox,disable-dev-shm-usage\n\n      - name: Upload system test screenshots\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: system-test-screenshots\n          path: tmp/screenshots\n          if-no-files-found: ignore\n60e3910f0 Fix missing Gantt expanders for projects with only subprojects (#44694).\n721c4d020 Include seconds in pasted image filenames (#44642).\n1d16b0dc9 Add a system test for pasting an image from the clipboard (#44642).\n022bdb94d Remove Gantt images that are no longer used since r25360 (#44689).\n20267c31b Define the wiki toolbar markup in JavaScript for each text formatter (#43259)\nf62db8f5e Show a warning listing the search terms actually used when a text filter value exceeds the limit of 5 terms (#44464).\nf3aac8ef4 Use Open Color for Gantt charts (#44689).\n4db2e90c6 Move the wiki toolbar translations from the jsToolBar language files to config/locales (#43259).\nea25e66e2 Reorder label_wiki_toolbar_* keys in en.yml (#43259).\nf6111afe2 Remove the jsToolBar files left empty in r25352 (#43259).\na5e564d8f Replace the jsToolBar wiki toolbar with a server-rendered toolbar handled by a Stimulus controller (#43259).\n2e67b522e Add public/assets to svn:ignore (#44690).\nab901ca5c Use a temporary asset manifest in PatchesTest to avoid conflicts between parallel workers (#44240, #44668).\nb426f6525 Hide non-section macro output while parsing sections (#44623).\n5acb433e6 Add English Mermaid help to languages other than English and Japanese (#44425, #44636).\n9d3697737 Describe Mermaid diagrams in the wiki syntax help pages (#44425, #44636).\n3d13ac3f5 Reject the current password on lost password reset when it has expired (#44673).\n3e1dfb3c2 Allow the same CSS properties in the style attribute in CommonMark as in Textile (#44585).\n1df10584c Sanitize the HTML generated by the Textile formatter with an allowlist, as the CommonMark formatter does (#44585).\nea359aec3 Add missing file from previous commit (#44585).\n2f9a09156 Extract the sanitization rules common to all text formatters from CommonMark::SanitizationFilter into a base class (#44585).\n6be91387d Keep values of spent time custom fields not visible to the user when editing a time entry (#44610).\n28f0284a1 Check permission and visibility before auto-watching the  assignee on issue creation (#44680).\nc825e09f4 Add the assignee as a watcher on issue creation when \"Issues assigned to me\" auto watch option is enabled (#44680).\n1c13c7128 Widen the spacing between items in contextual menus (#44665).\nfe5fbfc8d Italian translation update (#44676).\n2677fc6a5 Extra space before colon in en.yml key setting_password_required_char_classes (#44677).\nf7ea71f95 Fix 500 error on OAuth API requests when the token owner is not active (#44654).\naeb7b604c Japanese translation update (#44672).\n134385db1 Mermaid diagram may be drawn into another diagram on the same page (#44425, #44664).\n  7694\tJean-Philippe Lang\n  6677\tToshi MARUYAMA\n  3510\tGo MAEDA\n  1068\tMarius Balteanu\n   561\tEric Davis\n   109\tAzamat Hackimov\n   106\tJean-Baptiste Barth\n    96\tEtienne Massip\n    95\twinterheart\n    12\tJohn Goerzen","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01J6hcHfwG1VZcW527nMUXxb","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
