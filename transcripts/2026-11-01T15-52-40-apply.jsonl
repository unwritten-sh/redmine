sql-data:/var/lib/mysql\n\nvolumes:\n  postgres-data:\n  mysql-data:\nEOF\ncat > .env.example <<'EOF'\n# Redmine does not read a .env file. Most settings live in YAML files that git\n# ignores; copy them from their examples:\n#   config/database.yml       <- config/database.yml.example (bin/harness setup writes a SQLite3 one)\n#   config/configuration.yml  <- config/configuration.yml.example (SMTP, attachments path, SCM commands, ...)\n#   config/additional_environment.rb <- config/additional_environment.rb.example\n# This file lists the environment variables that the code, tests and Rake tasks\n# read. Export them in your shell when you need them. Values below are safe local defaults.\n\n# --- Application (config/environments/*.rb, config/boot.rb) ---\nRAILS_ENV=development\n# Production only: log to STDOUT instead of log/production.log when set.\nRAILS_LOG_TO_STDOUT=\n# Raise Rack query parser limits (config/boot.rb sets these defaults).\nRACK_QUERY_PARSER_BYTESIZE_LIMIT=33554432\nRACK_QUERY_PARSER_PARAMS_LIMIT=65536\n\n# --- Rake tasks (lib/tasks) ---\n# Language for redmine:load_default_data (asked interactively when empty).\nREDMINE_LANG=en\n# Test repositories that ci:setup creates, comma separated (default: all).\nSCMS=git,git_utf8,filesystem,subversion\n\n# --- Tests (test/test_helper.rb, test/application_system_test_case.rb) ---\n# Test processes for bin/rails test (bin/harness check-fast defaults to the CPU count).\nPARALLEL_WORKERS=\n# Run tests with SimpleCov coverage when set.\nCOVERAGE=\n# LDAP server for test/unit/auth_source_ldap_test.rb (tests skip without it).\nREDMINE_TEST_LDAP_SERVER=127.0.0.1\n# Plugins folder for tests (test:autoload sets test/fixtures/plugins).\nREDMINE_PLUGINS_DIRECTORY=\n# System tests: Chrome options, comma separated (CI: headless,disable-gpu,no-sandbox,disable-dev-shm-usage).\nGOOGLE_CHROME_OPTS_ARGS=\n# System tests against a remote Selenium server.\nSELENIUM_REMOTE_URL=\nCAPYBARA_SERVER_HOST=\nCAPYBARA_SERVER_PORT=\nCAPY