+require_relative '../test_helper'
+
+class HealthTest < Redmine::IntegrationTest
+  def test_anonymous_health_check_should_succeed
+    with_settings :login_required => '0' do
+      get '/up'
+      assert_response :success
+    end
+  end
+
+  def test_anonymous_health_check_should_succeed_when_login_is_required
+    with_settings :login_required => '1' do
+      get '/up'
+      assert_response :success
+    end
+  end
+end
